@model TechExchangeApp.ViewModel.ChuyenGiaDetailVm
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.FullName;
}

@section Styles {
    <link rel="stylesheet" href="~/css/chuyen-gia-detail.css" asp-append-version="true" />
}

<div class="expert-detail-page">
    <div class="expert-detail-container">

        <!-- Breadcrumb -->
        <nav class="expert-detail-breadcrumb" aria-label="breadcrumb">
            <a href="/">Trang chủ</a>
            <span>/</span>
            <a href="/chuyen-gia">Chuyên gia</a>
            <span>/</span>
            <strong>@Model.FullName</strong>
        </nav>

        <div class="expert-detail-layout">

            <!-- LEFT: SIDEBAR -->
            <aside class="expert-detail-sidebar">
                <div class="expert-detail-sidebar__block">
                    <p class="expert-detail-sidebar__title">Danh mục</p>
                    <ul class="expert-detail-sidebar__list">
                        @foreach (var c in Model.Categories)
                        {
                            <li><a href="/chuyen-gia?cateId=@c.Id">@c.Title</a></li>
                        }
                    </ul>
                </div>

                @if (Model.NhaTuVanKhac.Any())
                {
                    <div class="expert-detail-sidebar__block">
                        <p class="expert-detail-sidebar__title">Chuyên gia khác</p>
                        <div class="expert-detail-other-list">
                            @foreach (var other in Model.NhaTuVanKhac)
                            {
                                <a href="@other.DetailUrl" class="expert-detail-other-item">
                                    <img src="@other.ImageUrl" alt="@other.FullName" onerror="this.src='/image/NoAvarta.jpg';" />
                                    <span class="expert-detail-other-item__info">
                                        <span class="expert-detail-other-item__name">@other.FullName</span>
                                        <span class="expert-detail-other-item__org">@other.CoQuan</span>
                                    </span>
                                </a>
                            }
                        </div>
                    </div>
                }
            </aside>

            <!-- CENTER -->
            <section class="expert-detail-content">

                <!-- ══════ HEADER CARD ══════ -->
                <div class="expert-detail-header">
                    <div class="expert-detail-header__avatar">
                        <img src="@Model.ImageUrl" alt="@Model.FullName" onerror="this.src='/image/NoAvarta.jpg';" />
                    </div>
                    <div class="expert-detail-header__info">
                        <h1 class="expert-detail-header__name">
                            @(!string.IsNullOrEmpty(Model.HocHam) ? Model.HocHam + " " : "")@Model.FullName
                        </h1>
                        @if (!string.IsNullOrEmpty(Model.ChucVu))
                        {
                            <p class="expert-detail-header__title"><i class="fas fa-user-tag"></i>@Model.ChucVu</p>
                        }
                        @if (!string.IsNullOrEmpty(Model.CoQuan))
                        {
                            <p class="expert-detail-header__org"><i class="fas fa-building"></i>@Model.CoQuan</p>
                        }

                        <!-- Meta line -->
                        <div class="expert-detail-header__meta" id="headerMetaLine"
                             data-entity-type="NhaTuVan" data-entity-id="@Model.Id">
                            <span>
                                <i class="fa fa-star"></i>
                                <strong id="headerRatingAvg">@(Model.Rating > 0 ? Model.Rating.ToString("0.0") : "—")</strong>
                                <span class="expert-detail-header__meta-muted">(<span id="headerRatingCount">@Model.LuotDanhGia</span> đánh giá)</span>
                            </span>
                            <span class="expert-detail-header__meta-dot">·</span>
                            <span>
                                <i class="fa fa-eye"></i>
                                <span id="headerViewCount">@Model.LuotXem.ToString("N0")</span> lượt xem
                            </span>
                            @if (Model.TongTrichDan.HasValue)
                            {
                                <span class="expert-detail-header__meta-dot">·</span>
                                <span><i class="fas fa-quote-right"></i>@Model.TongTrichDan trích dẫn</span>
                            }
                            @if (Model.HIndex.HasValue)
                            {
                                <span class="expert-detail-header__meta-dot">·</span>
                                <span><strong>h-index:</strong> @Model.HIndex</span>
                            }
                        </div>

                        <table class="expert-detail-contact">
                            <tbody>
                                @if (!string.IsNullOrEmpty(Model.Phone))
                                {
                                    <tr><td><i class="fas fa-phone"></i>ĐT</td><td><a href="tel:@Model.Phone">@Model.Phone</a></td></tr>
                                }
                                @if (!string.IsNullOrEmpty(Model.Email))
                                {
                                    <tr><td><i class="fas fa-envelope"></i>Email</td><td><a href="mailto:@Model.Email">@Model.Email</a></td></tr>
                                }
                                @if (!string.IsNullOrEmpty(Model.DiaChi))
                                {
                                    <tr><td><i class="fas fa-map-marker-alt"></i>Địa chỉ</td><td>@Model.DiaChi</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- ══════ 6 TABS ══════ -->
                <div class="expert-detail-tabs">
                    <ul class="nav nav-tabs" role="tablist">
                        <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tab1"><i class="fas fa-id-card"></i>Thông tin</a></li>
                        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab2"><i class="fas fa-chart-line"></i>Chỉ số KH</a></li>
                        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab3"><i class="fas fa-graduation-cap"></i>Đào tạo & CT</a></li>
                        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab4"><i class="fas fa-book"></i>Công bố & SHTT</a></li>
                        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab5"><i class="fas fa-briefcase"></i>Tư vấn & DA</a></li>
                        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab6"><i class="fas fa-certificate"></i>Minh chứng</a></li>
                    </ul>

                    <div class="tab-content">

                        <!-- TAB 1: THÔNG TIN ĐỊNH DANH -->
                        <div class="tab-pane fade show active" id="tab1">
                            <table class="expert-detail-table">
                                <tbody>
                                    <tr><td>Họ và tên</td><td>@Model.FullName</td></tr>
                                    @if (!string.IsNullOrEmpty(Model.HocHam))
                                    {
                                        <tr><td>Học hàm / Học vị</td><td>@Model.HocHam</td></tr>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.CoQuan))
                                    {
                                        <tr><td>Cơ quan công tác</td><td>@Model.CoQuan</td></tr>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.ChucVu))
                                    {
                                        <tr><td>Chức vụ</td><td>@Model.ChucVu</td></tr>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.Phone))
                                    {
                                        <tr><td>Điện thoại</td><td><a href="tel:@Model.Phone">@Model.Phone</a></td></tr>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.Email))
                                    {
                                        <tr><td>Email</td><td><a href="mailto:@Model.Email">@Model.Email</a></td></tr>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.DiaChi))
                                    {
                                        <tr><td>Địa chỉ</td><td>@Model.DiaChi</td></tr>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.DateOfBirth))
                                    {
                                        <tr><td>Ngày sinh</td><td>@Model.DateOfBirth</td></tr>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.MaDinhDanh))
                                    {
                                        <tr>
                                            <td>Mã định danh quốc tế</td>
                                            <td>
                                                @foreach (var line in Model.MaDinhDanh.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                                                {
                                                    var trimmed = line.Trim();
                                                    if (trimmed.StartsWith("http"))
                                                    {
                                                        <div><a href="@trimmed" target="_blank" rel="noopener"><i class="fas fa-external-link-alt"></i>@trimmed</a></div>
                                                    }
                                                    else
                                                    {
                                                        <div>@trimmed</div>
                                                    }
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- TAB 2: CHỈ SỐ ẢNH HƯỞNG KHOA HỌC -->
                        <div class="tab-pane fade" id="tab2">
                            @if (Model.TongTrichDan.HasValue || Model.HIndex.HasValue)
                            {
                                <div class="expert-detail-stats">
                                    @if (Model.TongTrichDan.HasValue)
                                    {
                                        <div class="expert-detail-stat-card">
                                            <h3>@Model.TongTrichDan</h3>
                                            <span>Tổng số trích dẫn</span>
                                        </div>
                                    }
                                    @if (Model.HIndex.HasValue)
                                    {
                                        <div class="expert-detail-stat-card">
                                            <h3>@Model.HIndex</h3>
                                            <span>h-index</span>
                                        </div>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.LinhVucText))
                            {
                                <h6 class="expert-detail-subheading"><i class="fas fa-layer-group"></i>Lĩnh vực nghiên cứu trọng tâm</h6>
                                <div class="expert-detail-richtext">@Html.Raw(Model.LinhVucText)</div>
                            }
                            @if (string.IsNullOrEmpty(Model.LinhVucText) && !Model.TongTrichDan.HasValue && !Model.HIndex.HasValue)
                            {
                                <p class="expert-detail-empty">Chưa có thông tin.</p>
                            }
                        </div>

                        <!-- TAB 3: ĐÀO TẠO & CÔNG TÁC -->
                        <div class="tab-pane fade" id="tab3">
                            @if (!string.IsNullOrEmpty(Model.QuaTrinhDaoTao))
                            {
                                <h6 class="expert-detail-subheading"><i class="fas fa-graduation-cap"></i>Quá trình đào tạo</h6>
                                <div class="expert-detail-richtext">@Html.Raw(Model.QuaTrinhDaoTao)</div>
                            }
                            @if (!string.IsNullOrEmpty(Model.QuaTrinhCongTac))
                            {
                                <h6 class="expert-detail-subheading"><i class="fas fa-briefcase"></i>Quá trình công tác</h6>
                                <div class="expert-detail-richtext">@Html.Raw(Model.QuaTrinhCongTac)</div>
                            }
                            @if (string.IsNullOrEmpty(Model.QuaTrinhDaoTao) && string.IsNullOrEmpty(Model.QuaTrinhCongTac))
                            {
                                <p class="expert-detail-empty">Chưa có thông tin.</p>
                            }
                        </div>

                        <!-- TAB 4: CÔNG BỐ & SHTT -->
                        <div class="tab-pane fade" id="tab4">
                            @* Mục 12: Bài báo khoa học / Báo cáo Hội nghị *@
                            @if (!string.IsNullOrEmpty(Model.CongBoKhoaHoc))
                            {
                                <h6 class="expert-detail-subheading"><i class="fas fa-book"></i>Bài báo khoa học / Báo cáo Hội nghị</h6>
                                <div class="expert-detail-richtext">@Html.Raw(Model.CongBoKhoaHoc)</div>
                            }
                            @* Mục 13: Bằng độc quyền Sáng chế / Tác quyền *@
                            @if (!string.IsNullOrEmpty(Model.SangChe))
                            {
                                <h6 class="expert-detail-subheading expert-detail-subheading--accent"><i class="fas fa-lightbulb"></i>Bằng độc quyền Sáng chế / Tác quyền</h6>
                                <div class="expert-detail-richtext">@Html.Raw(Model.SangChe)</div>
                            }
                            @if (string.IsNullOrEmpty(Model.CongBoKhoaHoc) && string.IsNullOrEmpty(Model.SangChe))
                            {
                                <p class="expert-detail-empty">Chưa có thông tin.</p>
                            }
                        </div>

                        <!-- TAB 5: TƯ VẤN & DỰ ÁN -->
                        <div class="tab-pane fade" id="tab5">
                            @if (!string.IsNullOrEmpty(Model.DuAnNghienCuu))
                            {
                                <h6 class="expert-detail-subheading"><i class="fas fa-project-diagram"></i>Dự án nghiên cứu đã chủ trì</h6>
                                <div class="expert-detail-richtext">@Html.Raw(Model.DuAnNghienCuu)</div>
                            }
                            @if (!string.IsNullOrEmpty(Model.DichVuText))
                            {
                                <h6 class="expert-detail-subheading"><i class="fas fa-concierge-bell"></i>Dịch vụ tư vấn chuyên sâu</h6>
                                <div class="expert-detail-richtext">@Html.Raw(Model.DichVuText)</div>
                            }
                            @if (!string.IsNullOrEmpty(Model.KinhNghiem))
                            {
                                <h6 class="expert-detail-subheading"><i class="fas fa-handshake"></i>Kinh nghiệm thực chiến tại Doanh nghiệp</h6>
                                <div class="expert-detail-richtext">@Html.Raw(Model.KinhNghiem)</div>
                            }
                            @if (string.IsNullOrEmpty(Model.DuAnNghienCuu) && string.IsNullOrEmpty(Model.DichVuText) && string.IsNullOrEmpty(Model.KinhNghiem))
                            {
                                <p class="expert-detail-empty">Chưa có thông tin.</p>
                            }
                        </div>

                        <!-- TAB 6: MINH CHỨNG -->
                        <div class="tab-pane fade" id="tab6">
                            @if (!string.IsNullOrEmpty(Model.HoSoDinhKem))
                            {
                                var hosoFiles = Model.HoSoDinhKem
                                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                                if (hosoFiles.Length > 0)
                                {
                                    <h6 class="expert-detail-subheading"><i class="fas fa-paperclip"></i>Hồ sơ đính kèm</h6>
                                    <div class="expert-detail-files">
                                        @foreach (var hf in hosoFiles)
                                        {
                                            var hfname = System.IO.Path.GetFileName(hf);
                                            var hfIsPdf = hfname.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
                                            <a href="@hf" target="_blank" rel="noopener" class="expert-detail-file">
                                                <i class="fas @(hfIsPdf ? "fa-file-pdf" : "fa-file-image")"></i>
                                                <span>@hfname</span>
                                                <i class="fas fa-download"></i>
                                            </a>
                                        }
                                    </div>
                                }
                            }
                            @if (!string.IsNullOrEmpty(Model.HiepHoiKhoaHoc))
                            {
                                <h6 class="expert-detail-subheading"><i class="fas fa-users"></i>Thành viên hiệp hội khoa học</h6>
                                <p>@Model.HiepHoiKhoaHoc</p>
                            }
                            @if (Model.TuKhoa.Any())
                            {
                                <h6 class="expert-detail-subheading"><i class="fas fa-tags"></i>Từ khóa</h6>
                                <div class="expert-detail-tags">
                                    @foreach (var kw in Model.TuKhoa)
                                    {
                                        <span class="expert-detail-tag">@kw</span>
                                    }
                                </div>
                            }
                            @if (string.IsNullOrEmpty(Model.HoSoDinhKem) && string.IsNullOrEmpty(Model.HiepHoiKhoaHoc) && !Model.TuKhoa.Any())
                            {
                                <p class="expert-detail-empty">Chưa có thông tin.</p>
                            }
                        </div>

                    </div>
                </div>

                <!-- RATING + VIEW WIDGET -->
                <div class="expert-detail-block">
                    @await Html.PartialAsync("_EntityRating", null, new ViewDataDictionary(ViewData) {
                    { "EntityType", "NhaTuVan" },
                                        { "EntityId", Model.Id }
                                        })
                </div>
                @await Html.PartialAsync("_ContentUtilities", new TechExchangeApp.ViewModel.ContentUtilitiesVm
                {
                    TargetDataType = "Chuyen gia",
                    TargetId = Model.Id,
                    TargetTitle = Model.FullName,
                    ShareTitle = Model.FullName
                })

            </section>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ReportViolationModal")
}
