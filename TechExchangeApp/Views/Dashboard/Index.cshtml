@using TechExchangeApp.Interfaces
@using Microsoft.AspNetCore.Identity
@using TechExchangeApp.Entities
@inject IAccountService AccountService
@inject UserManager<ApplicationUser> UserManager

@model TechExchangeApp.ViewModel.UserDashboardVm
@{
    ViewData["Title"] = "Dashboard";
    ViewData["AuthWorkspace"] = true;
    var isEn = TechExchangeApp.Helpers.LangHelper.IsEnglish(Context);
    var currentTime = isEn
        ? DateTime.Now.ToString("MMM d, yyyy HH:mm", new System.Globalization.CultureInfo("en-US"))
        : DateTime.Now.ToString("dd/MM/yyyy HH:mm", new System.Globalization.CultureInfo("vi-VN"));

    var userId = int.Parse(UserManager.GetUserId(User)!);
    var sidebarData = await AccountService.GetSidebarDataAsync(userId);
}

<div class="container-fluid py-4 user-portal">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-3 col-lg-2">
            @await Html.PartialAsync("_AccountSidebar", sidebarData)
        </div>

        <!-- Main Content -->
        <div class="col-md-9 col-lg-10 user-portal-main">
<div class="user-dashboard">
    <!-- Header Section -->
    <div class="row mb-4 user-dashboard-header">
        <div class="col-md-12">
            <h2 class="mb-1">@Html.Text("dash.greeting") <strong>@Model.FullName</strong></h2>
            <p class="text-muted mb-0">
                <i class="fas fa-clock"></i> @currentTime
            </p>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4 user-dashboard-stats">
        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100 user-dashboard-stat">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">@Html.Text("dash.stat.total")</h6>
                            <h2 class="mb-0 text-primary">@Model.TotalProjects</h2>
                        </div>
                        <div class="user-dashboard-stat-icon bg-primary bg-opacity-10 text-primary">
                            <i class="fas fa-folder fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100 user-dashboard-stat">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">@Html.Text("dash.stat.inProgress")</h6>
                            <h2 class="mb-0 text-warning">@Model.InProgressProjects</h2>
                        </div>
                        <div class="user-dashboard-stat-icon bg-warning bg-opacity-10 text-warning">
                            <i class="fas fa-hourglass-half fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100 user-dashboard-stat">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">@Html.Text("dash.stat.waitingForMe")</h6>
                            <h2 class="mb-0 text-info">@Model.WaitingForMe</h2>
                        </div>
                        <div class="user-dashboard-stat-icon bg-info bg-opacity-10 text-info">
                            <i class="fas fa-bell fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100 user-dashboard-stat">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">@Html.Text("dash.stat.completed")</h6>
                            <h2 class="mb-0 text-success">@Model.CompletedProjects</h2>
                        </div>
                        <div class="user-dashboard-stat-icon bg-success bg-opacity-10 text-success">
                            <i class="fas fa-check-circle fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Projects Table -->
    <div class="card border-0 shadow-sm user-dashboard-table-card">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">@Html.Text("header.acct.myProjects")</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Projects.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Html.Text("dash.col.code")</th>
                                <th>@Html.Text("dash.col.name")</th>
                                <th>@Html.Text("dash.col.role")</th>
                                <th>@Html.Text("dash.col.currentStep")</th>
                                <th>@Html.Text("dash.col.status")</th>
                                <th>@Html.Text("dash.col.progress")</th>
                                <th>@Html.Text("dash.col.workflow")</th>
                                <th>@Html.Text("common.actions")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var project in Model.Projects)
                            {
                                <tr>
                                    <td data-label="@Html.Text("dash.col.code")">
                                        <strong class="text-primary">@project.Code</strong>
                                    </td>
                                    <td data-label="@Html.Text("dash.col.name")">@project.Name</td>
                                    <td data-label="@Html.Text("dash.col.role")">
                                        <span class="badge bg-secondary">@project.RoleName</span>
                                    </td>
                                    <td data-label="@Html.Text("dash.col.currentStep")">
                                        <small class="text-muted">@Html.Text("dash.stepPrefix") @project.CurrentStepNumber:</small><br />
                                        @* Tên bước lưu trong DB là tiếng Việt — tra theo SỐ bước hiển thị (1..6) thay vì dùng chuỗi đó. *@
                                        <strong>@Html.Text($"dash.step.{project.CurrentStepNumber}")</strong>
                                    </td>
                                    <td data-label="@Html.Text("dash.col.status")">
                                        @{
                                            var statusBadge = project.CurrentStepStatus switch
                                            {
                                                "Completed" => "bg-success",
                                                "InProgress" => "bg-primary",
                                                _ => "bg-secondary"
                                            };
                                            var statusText = project.CurrentStepStatus switch
                                            {
                                                "Completed" => Html.Text("dash.status.completed"),
                                                "InProgress" => Html.Text("dash.status.inProgress"),
                                                _ => Html.Text("dash.status.notStarted")
                                            };
                                        }
                                        <span class="badge @statusBadge">@statusText</span>
                                    </td>
                                    <td data-label="@Html.Text("dash.col.progress")">
                                        <div class="d-flex align-items-center">
                                            <div class="progress flex-grow-1 me-2" style="height: 8px;">
                                                <div class="progress-bar bg-success"
                                                     role="progressbar"
                                                     style="width: @project.ProgressPercent%"
                                                     aria-valuenow="@project.ProgressPercent"
                                                     aria-valuemin="0"
                                                     aria-valuemax="100">
                                                </div>
                                            </div>
                                            <small class="text-muted">@project.ProgressPercent%</small>
                                        </div>
                                        <small class="text-muted">@project.CompletedSteps/@project.TotalDisplaySteps @Html.Text("dash.stepsSuffix")</small>
                                    </td>
                                    <td data-label="@Html.Text("dash.col.workflow")">
                                        <div class="workflow-steps d-flex gap-1">
                                            @foreach (var step in project.StepsSummary)
                                            {
                                                var stepClass = step.StatusId switch
                                                {
                                                    2 => "step-completed",
                                                    1 => "step-inprogress",
                                                    _ => "step-notstarted"
                                                };
                                                <div class="user-dashboard-workflow-step @stepClass"
                                                     title="@Html.Text("dash.stepPrefix") @step.StepNumber"
                                                     data-bs-toggle="tooltip">
                                                </div>
                                            }
                                        </div>
                                    </td>
                                    <td data-label="@Html.Text("common.actions")">
                                        <a href="/Project/Details/@project.ProjectId"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i> @Html.Text("common.viewDetails")
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-inbox empty-state-icon"></i>
                    <p class="empty-state-title">@Html.Text("dash.empty.title")</p>
                    <p class="empty-state-text">@Html.Text("dash.empty.text")</p>
                    <a href="@Url.Action("Create", "TechTransfer")" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus-circle"></i> @Html.Text("dash.postRequest")
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/user-portal.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        // Initialize Bootstrap tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    </script>
}
        </div><!-- End Main Content col-md-9 -->
    </div><!-- End row -->
</div><!-- End container-fluid -->
