@model List<TechExchangeApp.Entities.Faq>
@{
    Layout = "_Layout";
    var isEn = TechExchangeApp.Helpers.LangHelper.IsEnglish(Context);
    ViewData["Title"] = Html.Text("faq.pageTitle");
    var actionUrl = isEn ? "/en/faq" : "/hoi-dap";
    var contactUrl = isEn ? "/en/contact" : "/lien-he";
    var q = (string?)ViewBag.Query;
    var groups = Model.GroupBy(f => f.GroupName).ToList();
}

<style>
    .faq-page { padding: 32px 0 56px; }
    .faq-page h1 { font-size: 1.75rem; font-weight: 700; margin-bottom: .25rem; }
    .faq-page .faq-search { max-width: 560px; margin: 16px 0 28px; }
    .faq-page .faq-group-title { font-size: 1.1rem; font-weight: 700; margin: 28px 0 12px; }
    .faq-page .accordion-button { font-weight: 600; }
    .faq-page .faq-answer { white-space: pre-line; }
</style>

<div class="container faq-page">
    <h1>@Html.Text("faq.pageTitle")</h1>
    <p class="text-muted mb-0">@Html.Text("faq.intro")</p>

    <form action="@actionUrl" method="get" class="faq-search" role="search">
        <div class="input-group">
            <input type="search" name="q" value="@q" class="form-control" placeholder="@Html.Text("faq.searchPh")" maxlength="200" />
            <button type="submit" class="btn btn-primary">@Html.Text("faq.searchBtn")</button>
        </div>
    </form>

    @if (Model.Count == 0)
    {
        <div class="alert alert-light border">@Html.Text("faq.empty")</div>
    }

    @{ var gi = 0; }
    @foreach (var g in groups)
    {
        gi++;
        <h2 class="faq-group-title">@g.Key</h2>
        <div class="accordion" id="faqGroup@(gi)">
            @foreach (var f in g)
            {
                <div class="accordion-item">
                    <h3 class="accordion-header" id="faqH@(f.Id)">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                data-bs-target="#faqC@(f.Id)" aria-expanded="false" aria-controls="faqC@(f.Id)">
                            @f.Question
                        </button>
                    </h3>
                    <div id="faqC@(f.Id)" class="accordion-collapse collapse" aria-labelledby="faqH@(f.Id)" data-bs-parent="#faqGroup@(gi)">
                        <div class="accordion-body faq-answer">@f.Answer</div>
                    </div>
                </div>
            }
        </div>
    }

    <p class="mt-4 text-muted">@Html.Text("faq.moreHelp") <a href="@contactUrl">@Html.Text("faq.contactLink")</a></p>
</div>
