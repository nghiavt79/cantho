@using TechExchangeApp.ViewModel
@model NhaCungUngIndexVm

@{
    ViewData["Title"] = Model.PageTitle;
}

@section Styles {
    <link rel="stylesheet" href="~/css/chuyen-gia.css" asp-append-version="true" />
}

<div class="expert-page">

    @* =============== PAGE HEADING =============== *@
    <section class="expert-hero">
        <div class="expert-container">
            <h1 class="expert-hero__title">@Model.PageTitle</h1>
            <p class="expert-hero__subtitle">
                Kết nối với các nhà cung ứng công nghệ, thiết bị và giải pháp phục vụ sản xuất, kinh doanh và chuyển giao công nghệ.
            </p>
            <span class="expert-hero__accent"></span>
        </div>
    </section>

    <div class="expert-container">
        <div class="expert-layout">

            @* =============== LEFT: CATEGORY SIDEBAR =============== *@
            <aside class="expert-sidebar">
                <p class="expert-sidebar__title">Lĩnh vực cung ứng</p>
                <ul class="expert-sidebar__list">
                    <li class="expert-sidebar__item @(Model.CateId == 0 ? "is-active" : "")">
                        <a href="/nha-cung-ung">Tất cả</a>
                    </li>
                    @foreach (var c in Model.Categories)
                    {
                        <li class="expert-sidebar__item @(Model.CateId == c.Id ? "is-active" : "")">
                            <a href="/nha-cung-ung?cateId=@c.Id">@c.Title</a>
                        </li>
                    }
                </ul>
            </aside>

            @* =============== RIGHT: SUPPLIER LIST =============== *@
            <section class="expert-content">

                <div class="expert-content__header">
                    <h2 class="expert-content__title">Danh sách nhà cung ứng</h2>
                    @if (Model.TotalCount > 0)
                    {
                        <p class="expert-content__subtitle">@Model.TotalCount nhà cung ứng đang tham gia</p>
                    }
                </div>

                @if (!Model.Items.Any())
                {
                    <div class="expert-empty">Không có nhà cung ứng nào.</div>
                }
                else
                {
                    <div class="expert-grid">
                        @foreach (var item in Model.Items)
                        {
                            <div class="expert-card">
                                <div class="expert-card__media">
                                    <a href="@item.DetailUrl">
                                        <img src="@item.ImageUrl" alt="@item.FullName" />
                                    </a>
                                </div>
                                <div class="expert-card__body">
                                    <h3 class="expert-card__name">
                                        <a href="@item.DetailUrl">@item.FullName</a>
                                    </h3>
                                    @if (!string.IsNullOrEmpty(item.DiaChi))
                                    {
                                        <div class="expert-card__organization"><i class="fas fa-map-marker-alt"></i> @item.DiaChi</div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.Phone))
                                    {
                                        <div class="expert-card__organization"><i class="fas fa-phone"></i> @item.Phone</div>
                                    }
                                    @if (item.Rating > 0)
                                    {
                                        <div class="expert-card__rating">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <span class="expert-card__star @(i <= item.Rating ? "is-filled" : "")">★</span>
                                            }
                                        </div>
                                    }
                                    <div class="expert-card__actions">
                                        <a href="@item.DetailUrl" class="expert-card__btn">Xem chi tiết</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @* ── PAGINATION (CMS style) ─────────────────────────── *@
                    @if (Model.TotalPage > 1)
                    {
                        <div class="expert-pagination">
                            <div class="expert-pagination__info">
                                Trang <strong>@Model.CurrentPage</strong> / <strong>@Model.TotalPage</strong>
                                &nbsp;·&nbsp; Tổng <strong>@Model.TotalCount</strong> nhà cung ứng
                            </div>
                            <ul class="pagination pagination-sm mb-0 expert-pagination__list">
                                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="/nha-cung-ung?cateId=@Model.CateId&page=1">
                                        <i class="fas fa-angles-left"></i>
                                    </a>
                                </li>
                                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="/nha-cung-ung?cateId=@Model.CateId&page=@(Model.CurrentPage - 1)">
                                        <i class="fas fa-angle-left"></i>
                                    </a>
                                </li>
                                @foreach (var p in Model.Pages)
                                {
                                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="/nha-cung-ung?cateId=@Model.CateId&page=@p">@p</a>
                                    </li>
                                }
                                <li class="page-item @(Model.CurrentPage == Model.TotalPage ? "disabled" : "")">
                                    <a class="page-link" href="/nha-cung-ung?cateId=@Model.CateId&page=@(Model.CurrentPage + 1)">
                                        <i class="fas fa-angle-right"></i>
                                    </a>
                                </li>
                                <li class="page-item @(Model.CurrentPage == Model.TotalPage ? "disabled" : "")">
                                    <a class="page-link" href="/nha-cung-ung?cateId=@Model.CateId&page=@Model.TotalPage">
                                        <i class="fas fa-angles-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                }

            </section>
        </div>
    </div>
</div>
