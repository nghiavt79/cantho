@using TechExchangeApp.ViewModel
@model NhaCungUngDetailVm
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.FullName + " — Nhà cung ứng";
    var headerImg = !string.IsNullOrEmpty(Model.LogoUrl) ? Model.LogoUrl
        : !string.IsNullOrEmpty(Model.ImageUrl) ? Model.ImageUrl
        : "/images/254-170_noImage.jpg";
}

@section Styles {
    <link rel="stylesheet" href="~/css/chuyen-gia-detail.css" asp-append-version="true" />
    <style>
        /* Logo nhà cung ứng: không bo tròn 50% như avatar chuyên gia */
        .supplier-detail-page .expert-detail-header__avatar img {
            border-radius: 8px;
        }
    </style>
}

<div class="expert-detail-page supplier-detail-page">
    <div class="expert-detail-container">

        <!-- Breadcrumb -->
        <nav class="expert-detail-breadcrumb" aria-label="breadcrumb">
            <partial name="_BreadcrumbHome" />
            <span>/</span>
            <a href="/nha-cung-ung">Nhà cung ứng</a>
            <span>/</span>
            <strong>@Model.FullName</strong>
        </nav>

        <div class="expert-detail-layout">

            <!-- LEFT: SIDEBAR -->
            <aside class="expert-detail-sidebar">
                <div class="expert-detail-sidebar__block">
                    <p class="expert-detail-sidebar__title">Lĩnh vực cung ứng</p>
                    <ul class="expert-detail-sidebar__list">
                        @foreach (var c in Model.Categories)
                        {
                            <li><a href="/nha-cung-ung?cateId=@c.Id">@c.Title</a></li>
                        }
                    </ul>
                </div>

                @if (Model.NhaCungUngKhac.Any())
                {
                    <div class="expert-detail-sidebar__block">
                        <p class="expert-detail-sidebar__title">Nhà cung ứng khác</p>
                        <div class="expert-detail-other-list">
                            @foreach (var other in Model.NhaCungUngKhac)
                            {
                                <a href="@other.DetailUrl" class="expert-detail-other-item">
                                    <img src="@other.ImageUrl" alt="@other.FullName" onerror="this.src='/images/254-170_noImage.jpg';" />
                                    <span class="expert-detail-other-item__info">
                                        <span class="expert-detail-other-item__name">@other.FullName</span>
                                        <span class="expert-detail-other-item__org">@other.DiaChi</span>
                                    </span>
                                </a>
                            }
                        </div>
                    </div>
                }
            </aside>

            <!-- CENTER -->
            <section class="expert-detail-content">

                <!-- ══════ HEADER CARD ══════ -->
                <div class="expert-detail-header">
                    <div class="expert-detail-header__avatar">
                        <img src="@headerImg" alt="@Model.FullName" style="object-fit:contain;background:#fff;" onerror="this.src='/images/254-170_noImage.jpg';" />
                    </div>
                    <div class="expert-detail-header__info">
                        <h1 class="expert-detail-header__name">@Model.FullName</h1>
                        @if (!string.IsNullOrEmpty(Model.TenVietTat))
                        {
                            <p class="expert-detail-header__title"><i class="fas fa-signature"></i>@Model.TenVietTat</p>
                        }
                        @if (!string.IsNullOrEmpty(Model.LoaiHinhToChucText))
                        {
                            <p class="expert-detail-header__org"><i class="fas fa-tag"></i>@Model.LoaiHinhToChucText</p>
                        }

                        <!-- Meta line -->
                        <div class="expert-detail-header__meta" id="headerMetaLine"
                             data-entity-type="NhaCungUng" data-entity-id="@Model.Id">
                            <span>
                                <i class="fa fa-star"></i>
                                <strong id="headerRatingAvg">@(Model.Rating > 0 ? Model.Rating.ToString("0.0") : "—")</strong>
                                <span class="expert-detail-header__meta-muted">(<span id="headerRatingCount">@Model.LuotDanhGia</span> đánh giá)</span>
                            </span>
                            <span class="expert-detail-header__meta-dot">·</span>
                            <span>
                                <i class="fa fa-eye"></i>
                                <span id="headerViewCount">@Model.LuotXem.ToString("N0")</span> lượt xem
                            </span>
                        </div>

                        <table class="expert-detail-contact">
                            <tbody>
                                @if (!string.IsNullOrEmpty(Model.Phone))
                                {
                                    <tr><td><i class="fas fa-phone"></i>ĐT</td><td><a href="tel:@Model.Phone">@Model.Phone</a></td></tr>
                                }
                                @if (!string.IsNullOrEmpty(Model.Email))
                                {
                                    <tr><td><i class="fas fa-envelope"></i>Email</td><td><a href="mailto:@Model.Email">@Model.Email</a></td></tr>
                                }
                                @if (!string.IsNullOrEmpty(Model.Website))
                                {
                                    <tr><td><i class="fas fa-globe"></i>Website</td><td><a href="@Model.Website" target="_blank" rel="noopener">@Model.Website</a></td></tr>
                                }
                                @if (!string.IsNullOrEmpty(Model.DiaChi))
                                {
                                    <tr><td><i class="fas fa-map-marker-alt"></i>Địa chỉ</td><td>@Model.DiaChi</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- ══════ TABS ══════ -->
                <div class="expert-detail-tabs">
                    <ul class="nav nav-tabs" role="tablist">
                        <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tab3"><i class="fas fa-box"></i>Dịch vụ & Sản phẩm</a></li>
                        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab1"><i class="fas fa-id-card"></i>Thông tin</a></li>
                        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab2"><i class="fas fa-cogs"></i>Năng lực & Lĩnh vực</a></li>
                        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab4"><i class="fas fa-images"></i>Hồ sơ năng lực số</a></li>
                    </ul>

                    <div class="tab-content">

                        <!-- TAB 1: THÔNG TIN ĐỊNH DANH -->
                        <div class="tab-pane fade" id="tab1">
                            <table class="expert-detail-table">
                                <tbody>
                                    <tr><td>Tên đơn vị</td><td>@Model.FullName</td></tr>
                                    @if (!string.IsNullOrEmpty(Model.TenVietTat))
                                    {
                                        <tr><td>Tên viết tắt</td><td>@Model.TenVietTat</td></tr>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.LoaiHinhToChucText))
                                    {
                                        <tr><td>Loại hình tổ chức</td><td>@Model.LoaiHinhToChucText</td></tr>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.MaSoThue))
                                    {
                                        <tr><td>Mã số thuế</td><td>@Model.MaSoThue</td></tr>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.NguoiDaiDien))
                                    {
                                        <tr><td>Người đại diện</td><td>@Model.NguoiDaiDien @(!string.IsNullOrEmpty(Model.ChucVu) ? $"— {Model.ChucVu}" : "")</td></tr>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.DiaChi))
                                    {
                                        <tr><td>Địa chỉ</td><td>@Model.DiaChi</td></tr>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.Phone))
                                    {
                                        <tr><td>Điện thoại</td><td><a href="tel:@Model.Phone">@Model.Phone</a></td></tr>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.Fax))
                                    {
                                        <tr><td>Fax</td><td>@Model.Fax</td></tr>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.Email))
                                    {
                                        <tr><td>Email</td><td><a href="mailto:@Model.Email">@Model.Email</a></td></tr>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.Website))
                                    {
                                        <tr><td>Website</td><td><a href="@Model.Website" target="_blank" rel="noopener"><i class="fas fa-external-link-alt"></i>@Model.Website</a></td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- TAB 2: NĂNG LỰC & LĨNH VỰC -->
                        <div class="tab-pane fade" id="tab2">
                            @if (!string.IsNullOrEmpty(Model.LinhVucText))
                            {
                                <h6 class="expert-detail-subheading"><i class="fas fa-layer-group"></i>Lĩnh vực hoạt động chính</h6>
                                <div class="expert-detail-richtext">@Html.Raw(Model.LinhVucText)</div>
                            }
                            @if (!string.IsNullOrEmpty(Model.ChucNang))
                            {
                                <h6 class="expert-detail-subheading"><i class="fas fa-bullseye"></i>Chức năng nhiệm vụ / Giá trị cốt lõi</h6>
                                <div class="expert-detail-richtext">@Html.Raw(Model.ChucNang)</div>
                            }
                            @if (string.IsNullOrEmpty(Model.LinhVucText) && string.IsNullOrEmpty(Model.ChucNang))
                            {
                                <p class="expert-detail-empty">Chưa có thông tin.</p>
                            }
                        </div>

                        <!-- TAB 3: DỊCH VỤ & SẢN PHẨM -->
                        <div class="tab-pane fade show active" id="tab3">
                            @if (!string.IsNullOrEmpty(Model.DichVuText))
                            {
                                <h6 class="expert-detail-subheading"><i class="fas fa-concierge-bell"></i>Dịch vụ khoa học và công nghệ</h6>
                                <div class="expert-detail-richtext">@Html.Raw(Model.DichVuText)</div>
                            }

                            @if (!string.IsNullOrEmpty(Model.SanPham) || Model.Products.Any())
                            {
                                <h6 class="expert-detail-subheading expert-detail-subheading--accent"><i class="fas fa-flask"></i>Sản phẩm công nghệ / Kết quả nghiên cứu</h6>

                                @if (!string.IsNullOrEmpty(Model.SanPham))
                                {
                                    <div class="expert-detail-richtext">@Html.Raw(Model.SanPham)</div>
                                }

                                @if (Model.Products.Any())
                                {
                                    <div class="row g-3 mt-1">
                                        @foreach (var p in Model.Products)
                                        {
                                            <div class="col-6 col-md-4 col-lg-3">
                                                <div class="card h-100 border">
                                                    <a href="@p.Url">
                                                        <img src="@p.ImageUrl" alt="@p.Title" class="card-img-top"
                                                             style="height:140px;object-fit:contain;padding:8px;background:#f8f8f8;"
                                                             onerror="this.src='/images/254-170_noImage.jpg';" />
                                                    </a>
                                                    <div class="card-body p-2">
                                                        <a href="@p.Url" class="text-decoration-none text-dark">
                                                            <h6 class="card-title mb-1" style="font-size:13px;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">@p.Title</h6>
                                                        </a>
                                                        @if (!string.IsNullOrEmpty(p.PriceText))
                                                        {
                                                            <div class="text-danger fw-bold" style="font-size:13px;">@p.PriceText</div>
                                                        }
                                                        <div style="color:gold;font-size:12px;">
                                                            @for (int i = 1; i <= 5; i++)
                                                            {
                                                                @(i <= p.Rating ? "★" : "☆")
                                                            }
                                                        </div>
                                                        @if (!string.IsNullOrEmpty(p.Code))
                                                        {
                                                            <small class="text-muted">Mã: @p.Code</small>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }

                            @if (string.IsNullOrEmpty(Model.DichVuText) && !Model.Products.Any() && string.IsNullOrEmpty(Model.SanPham))
                            {
                                <p class="expert-detail-empty">Chưa có thông tin.</p>
                            }
                        </div>

                        <!-- TAB 4: HỒ SƠ NĂNG LỰC SỐ -->
                        <div class="tab-pane fade" id="tab4">
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <h6 class="expert-detail-subheading"><i class="fas fa-building"></i>Hình ảnh trụ sở / Hoạt động tiêu biểu</h6>
                                <div class="mb-4">
                                    <a href="@Model.ImageUrl" target="_blank">
                                        <img src="@Model.ImageUrl" alt="Hình ảnh trụ sở" class="img-fluid rounded border shadow-sm" style="max-height:400px;object-fit:contain;" onerror="this.style.display='none';" title="Nhấn để xem ảnh lớn" />
                                    </a>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.VideoUrl))
                            {
                                var videoId = "";
                                if (Model.VideoUrl.Contains("watch?v="))
                                {
                                    videoId = Model.VideoUrl.Split("watch?v=").Last().Split('&').First();
                                }
                                else if (Model.VideoUrl.Contains("youtu.be/"))
                                {
                                    videoId = Model.VideoUrl.Split("youtu.be/").Last().Split('?').First();
                                }

                                <h6 class="expert-detail-subheading"><i class="fab fa-youtube"></i>Video giới thiệu đơn vị</h6>
                                if (!string.IsNullOrEmpty(videoId))
                                {
                                    <div class="ratio ratio-16x9 mb-3" style="max-width:560px;">
                                        <iframe src="https://www.youtube.com/embed/@videoId" allowfullscreen></iframe>
                                    </div>
                                }
                                else if (Model.VideoUrl.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="mb-3" style="max-width:560px;">
                                        <video controls style="width:100%;border-radius:8px;" class="shadow-sm">
                                            <source src="@Model.VideoUrl" type="video/mp4">
                                            Trình duyệt của bạn không hỗ trợ hiển thị video.
                                        </video>
                                        <div class="mt-2">
                                            <a href="@Model.VideoUrl" download target="_blank" class="btn btn-sm btn-outline-primary"><i class="fa fa-download me-1"></i>Tải video về máy</a>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <p>
                                        <a href="@Model.VideoUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary"><i class="fa fa-external-link-alt me-1"></i>Xem video / Tải video</a>
                                    </p>
                                }
                            }
                            @if (!string.IsNullOrEmpty(Model.ChungNhan))
                            {
                                <h6 class="expert-detail-subheading"><i class="fas fa-certificate"></i>Chứng nhận năng lực / Giấy phép</h6>
                                <div class="mb-4">
                                    @{
                                        var ext = string.Empty;
                                        try { ext = System.IO.Path.GetExtension(Model.ChungNhan)?.ToLower() ?? ""; } catch { }

                                        if (ext == ".jpg" || ext == ".jpeg" || ext == ".png" || ext == ".gif" || ext == ".webp")
                                        {
                                            <div class="mb-2">
                                                <a href="@Model.ChungNhan" target="_blank">
                                                    <img src="@Model.ChungNhan" alt="Chứng nhận năng lực" class="img-fluid rounded border shadow-sm" style="max-height:500px;" title="Nhấn để xem ảnh lớn" />
                                                </a>
                                            </div>
                                        }
                                        else if (ext == ".pdf")
                                        {
                                            <div class="mb-2">
                                                <iframe src="@Model.ChungNhan" style="width:100%;height:700px;border:none;" class="rounded border shadow-sm"></iframe>
                                            </div>
                                        }
                                    }
                                    <div class="mt-2">
                                        <a href="@Model.ChungNhan" target="_blank" download class="btn btn-sm btn-outline-primary"><i class="fa fa-download me-1"></i>Tải file chứng nhận</a>
                                    </div>
                                </div>
                            }
                            @if (string.IsNullOrEmpty(Model.ImageUrl) && string.IsNullOrEmpty(Model.VideoUrl) && string.IsNullOrEmpty(Model.ChungNhan))
                            {
                                <p class="expert-detail-empty">Chưa có thông tin.</p>
                            }
                        </div>

                    </div>
                </div>

                <!-- RATING + VIEW WIDGET -->
                <div class="expert-detail-block">
                    @await Html.PartialAsync("_EntityRating", null, new ViewDataDictionary(ViewData) {
                    { "EntityType", "NhaCungUng" },
                                        { "EntityId", Model.Id }
                                        })
                </div>
                @await Html.PartialAsync("_ContentUtilities", new TechExchangeApp.ViewModel.ContentUtilitiesVm
                {
                    TargetDataType = "Nha cung ung",
                    TargetId = Model.Id,
                    TargetTitle = Model.FullName,
                    ShareTitle = Model.FullName
                })

            </section>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ReportViolationModal")
}
