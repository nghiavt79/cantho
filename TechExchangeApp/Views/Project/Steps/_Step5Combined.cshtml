@model TechExchangeApp.ViewModel.StepContentVm

@{
    ViewBag.IsCombinedStep5 = true;

    var negotiationModel = new TechExchangeApp.ViewModel.StepContentVm
    {
        ProjectId = Model.ProjectId,
        StepNumber = 5,
        StepName = "Đàm phán thương mại",
        Project = Model.Project,
        UserRole = Model.UserRole,
        Steps = Model.Steps,
        CurrentStep = Model.CurrentStep,
        StepData = Model.StepData
    };

    var legalReviewModel = new TechExchangeApp.ViewModel.StepContentVm
    {
        ProjectId = Model.ProjectId,
        StepNumber = 6,
        StepName = "Kiểm tra pháp lý",
        Project = Model.Project,
        UserRole = Model.UserRole,
        Steps = Model.Steps,
        CurrentStep = Model.CurrentStep,
        StepData = null
    };
}

<div class="card shadow-sm border-0 tx-agreement-step">
    <div class="card-header d-flex justify-content-between align-items-center"
         style="background:linear-gradient(135deg,#1565c0,#1e88e5);color:#fff">
        <h5 class="mb-0"><i class="fas fa-file-signature me-2"></i>Bước 5: Thống nhất &amp; Hoàn thiện hợp đồng</h5>
    </div>
    <div class="card-body p-3 tx-combined-step">
        @await Html.PartialAsync("Steps/_Step5", negotiationModel)

        <div class="my-4 border-top" id="legal-review-section"></div>

        @await Html.PartialAsync("Steps/_Step6", legalReviewModel)
    </div>
    <div class="card-footer bg-white">
        <button class="btn btn-outline-secondary step-nav-btn" data-step="4">
            <i class="fas fa-arrow-left"></i> Quay lại bước trước
        </button>
    </div>
</div>
