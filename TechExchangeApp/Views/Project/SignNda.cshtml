@{
    ViewData["Title"] = Html.Text("proj.nda.title");
    var isEn = TechExchangeApp.Helpers.LangHelper.IsEnglish(Context);
    var projectId = ViewBag.ProjectId;
    var projectName = ViewBag.ProjectName;
    var deadline = ViewBag.Deadline;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-file-signature"></i> @Html.Text("proj.nda.heading")
                    </h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        <strong>@Html.Text("proj.nda.projectLabel")</strong> @projectName<br>
                        <strong>@Html.Text("proj.nda.deadlineLabel")</strong> @deadline?.ToString(isEn ? "MM/dd/yyyy HH:mm" : "dd/MM/yyyy HH:mm")
                    </div>

                    <div class="nda-content p-4 border rounded bg-light mb-4" style="max-height: 400px; overflow-y: auto;">
                        @* Toàn văn NDA. Bản tiếng Anh CẦN RÀ SOÁT PHÁP LÝ trước khi dùng thật. *@
                        <h5 class="text-center mb-4">@Html.Text("proj.nda.docTitle")</h5>

                        <p><strong>@Html.Text("proj.nda.s1Title")</strong></p>
                        <p>@Html.Text("proj.nda.s1Body")</p>

                        <p><strong>@Html.Text("proj.nda.s2Title")</strong></p>
                        <p>@Html.Text("proj.nda.s2Body")</p>
                        <ul>
                            <li>@Html.Text("proj.nda.s2i1")</li>
                            <li>@Html.Text("proj.nda.s2i2")</li>
                            <li>@Html.Text("proj.nda.s2i3")</li>
                            <li>@Html.Text("proj.nda.s2i4")</li>
                        </ul>

                        <p><strong>@Html.Text("proj.nda.s3Title")</strong></p>
                        <p>@Html.Text("proj.nda.s3Body")</p>
                        <ul>
                            <li>@Html.Text("proj.nda.s3i1")</li>
                            <li>@Html.Text("proj.nda.s3i2")</li>
                            <li>@Html.Text("proj.nda.s3i3")</li>
                            <li>@Html.Text("proj.nda.s3i4")</li>
                        </ul>

                        <p><strong>@Html.Text("proj.nda.s4Title")</strong></p>
                        <p>@Html.Text("proj.nda.s4Body")</p>

                        <p><strong>@Html.Text("proj.nda.s5Title")</strong></p>
                        <p>@Html.Text("proj.nda.s5Body")</p>
                    </div>

                    <form asp-action="SignNda" method="post">
                        <input type="hidden" name="projectId" value="@projectId" />
                        <input type="hidden" name="agreementText" value="NDA Agreement Accepted" />
                        
                        <div class="form-check mb-4">
                            <input class="form-check-input" type="checkbox" id="agreeCheck" required>
                            <label class="form-check-label" for="agreeCheck">
                                <strong>@Html.Text("proj.nda.agreeCheckbox")</strong>
                            </label>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg" id="signButton" disabled>
                                <i class="fas fa-signature"></i> @Html.Text("proj.nda.signButton")
                            </button>
                            <a asp-action="InvitedProjects" asp-controller="Seller" class="btn btn-outline-secondary">
                                <i class="fas fa-times"></i> @Html.Text("common.cancel")
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('agreeCheck').addEventListener('change', function() {
            document.getElementById('signButton').disabled = !this.checked;
        });
    </script>
}
