@model TechExchangeApp.ViewModel.OcopIndexViewModel
@{
    var isEn = TechExchangeApp.Helpers.LangHelper.IsEnglish(Context);
    ViewData["Title"] = I18n.T(Context, "ocop.pageTitle");

    var listUrl = isEn ? "/en/ocop" : "/ocop";

    string ProductImage(TechExchangeApp.Entities.SanPhamCNTB p) => Html.CookedImageURL("254-170", p.QuyTrinhHinhAnh);

    string ProductUrl(TechExchangeApp.Entities.SanPhamCNTB p) =>
        isEn ? $"{Html.MainDomain()}en/ocop/{Html.MakeURLFriendly(p.Name)}-{p.ID}" : $"{Html.MainDomain()}ocop/{Html.MakeURLFriendly(p.Name)}-{p.ID}";

    string Stars(int? soSao)
    {
        var n = Math.Clamp(soSao ?? 0, 0, 5);
        return new string('★', n) + new string('☆', 5 - n);
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/ocop.css" asp-append-version="true" />
}

<div class="columns-container tech-page">
    <div class="container" id="columns">
        <div class="center_column" id="center_column">
            <div class="ocop-page">
                <div class="ocop-hero">
                    <div class="container">
                        <nav class="tech-breadcrumb" aria-label="breadcrumb">
                            <partial name="_BreadcrumbHome" />
                            <span>/</span>
                            <strong>OCOP</strong>
                        </nav>
                        <div class="ocop-eyebrow">@Html.Text("ocop.eyebrow")</div>
                        <h1>@Html.Text("ocop.heroTitle")</h1>
                        <p>@Html.Text("ocop.heroDesc")</p>
                        <div class="ocop-stats">
                            <span><strong>@Model.TotalProducts</strong>@Html.Text("ocop.statProducts")</span>
                            <span><strong>@Model.TotalTraceable</strong>@Html.Text("ocop.statTraceable")</span>
                            <span><strong>@Model.TotalOrigins</strong>@Html.Text("ocop.statOrigins")</span>
                        </div>
                    </div>
                </div>

                <div class="container">
                    <div class="ocop-howto">
                        <div class="step">
                            <span class="n">1</span>
                            <h3>@Html.Text("ocop.step1Title")</h3>
                            <p>@Html.Text("ocop.step1Desc")</p>
                        </div>
                        <div class="step">
                            <span class="n">2</span>
                            <h3>@Html.Text("ocop.step2Title")</h3>
                            <p>@Html.Text("ocop.step2Desc")</p>
                        </div>
                        <div class="step">
                            <span class="n">3</span>
                            <h3>@Html.Text("ocop.step3Title")</h3>
                            <p>@Html.Text("ocop.step3Desc")</p>
                        </div>
                    </div>

                    <div class="ocop-section-head">
                        <h2>@Html.Text("ocop.featuredTitle")</h2>
                    </div>

                    <div class="ocop-grid">
                        @if (Model.Products.Any())
                        {
                            @foreach (var p in Model.Products)
                            {
                                <a class="ocop-card" href="@ProductUrl(p)">
                                    <div class="thumb">
                                        <img src="@ProductImage(p)" alt="@p.Name" />
                                        @if (p.SoSaoOCOP is > 0)
                                        {
                                            <span class="stars">@Stars(p.SoSaoOCOP)</span>
                                        }
                                    </div>
                                    <div class="body">
                                        <div class="name">@p.Name</div>
                                        @if (!string.IsNullOrWhiteSpace(p.XuatXu))
                                        {
                                            <div class="origin"><i class="bi bi-geo-alt-fill"></i> @p.XuatXu</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(p.MaTruyXuat))
                                        {
                                            <div class="trace-tag"><i class="bi bi-upc-scan"></i> @Html.Text("ocop.hasTraceCode")</div>
                                        }
                                    </div>
                                </a>
                            }
                        }
                        else
                        {
                            <div class="ocop-empty">
                                <i class="bi bi-basket"></i>
                                @Html.Text("ocop.emptyLine1")<br />
                                @Html.Text("ocop.emptyLine2")
                            </div>
                        }
                    </div>

                    @* ── PHÂN TRANG (cùng khuôn với trang chuyên gia/sản phẩm) ───────── *@
                    @if (Model.TotalPage > 1)
                    {
                        <div class="expert-pagination">
                            <div class="expert-pagination__info">
                                @Html.Text("common.page") <strong>@Model.CurrentPage</strong> / <strong>@Model.TotalPage</strong>
                                &nbsp;·&nbsp; @Html.Text("common.total") <strong>@Model.TotalCount</strong> @Html.Text("common.products")
                            </div>
                            <ul class="pagination pagination-sm mb-0 expert-pagination__list">
                                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="@listUrl?page=1" aria-label="@Html.Text("common.prevPage")">
                                        <i class="fas fa-angles-left"></i>
                                    </a>
                                </li>
                                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="@listUrl?page=@(Model.CurrentPage - 1)">
                                        <i class="fas fa-angle-left"></i>
                                    </a>
                                </li>
                                @foreach (var p in Model.Pages)
                                {
                                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@listUrl?page=@p">@p</a>
                                    </li>
                                }
                                <li class="page-item @(Model.CurrentPage == Model.TotalPage ? "disabled" : "")">
                                    <a class="page-link" href="@listUrl?page=@(Model.CurrentPage + 1)">
                                        <i class="fas fa-angle-right"></i>
                                    </a>
                                </li>
                                <li class="page-item @(Model.CurrentPage == Model.TotalPage ? "disabled" : "")">
                                    <a class="page-link" href="@listUrl?page=@Model.TotalPage" aria-label="@Html.Text("common.nextPage")">
                                        <i class="fas fa-angles-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
