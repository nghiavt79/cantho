@model TechExchangeApp.ViewModel.MenuDetailViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/menu-detail.css" asp-append-version="true" />
}

<div class="menu-detail-page">
    <div class="menu-detail-container">

        <nav class="menu-detail-breadcrumb" aria-label="breadcrumb">
            <partial name="_BreadcrumbHome" />
            <span>/</span>
            <strong>@Model.Title</strong>
        </nav>

        <div class="menu-detail-layout">

            <!-- Nội dung chính -->
            <article class="menu-detail-content">
                <h1 class="menu-detail-content__title">@Model.Title</h1>
                <span class="menu-detail-content__accent"></span>

                <div class="content-text clearfix">
                    @Html.Raw(Model.Description)
                </div>
            </article>

            <!-- Sidebar -->
            <aside class="menu-detail-sidebar">
                <p class="menu-detail-sidebar__title">@Model.Header</p>
                <ul class="menu-detail-sidebar__list">
                    @foreach (var item in Model.Menus)
                    {
                        <li class="@(item.MenuId == Model.MenuId ? "is-active" : "")">
                            <a href="@item.NavigateUrl">@item.Title</a>
                        </li>
                    }
                </ul>
            </aside>

        </div>
    </div>
</div>
