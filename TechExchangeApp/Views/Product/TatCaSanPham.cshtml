@model TechExchangeApp.ViewModel.AllProductsViewModel
@{
    var isEn = TechExchangeApp.Helpers.LangHelper.IsEnglish(Context);
    ViewData["Title"] = isEn ? "Products" : "Sản phẩm";
}

@section Styles {
    <link rel="stylesheet" href="~/css/san-pham.css" asp-append-version="true" />
}

@{

    string ProductImage(TechExchangeApp.Entities.SanPhamCNTB p)
    {
        if (!string.IsNullOrEmpty(p.QuyTrinhHinhAnh))
        {
            return Html.CookedImageURL("254-170", p.QuyTrinhHinhAnh);
        }
        return Html.MainDomain() + "images/research.jpg";
    }

    string ProductUrl(TechExchangeApp.Entities.SanPhamCNTB p) =>
        isEn ? $"{Html.MainDomain()}en/products/{Html.MakeURLFriendly(p.Name)}-{p.ID}" : $"{Html.MainDomain()}san-pham/chi-tiet/{Html.MakeURLFriendly(p.Name)}-{p.ID}";

    string TypeLabel(int t) => t switch { 2 => Html.Text("common.equipment"), 3 => Html.Text("common.ipAssets"), _ => Html.Text("common.technology") };

    string PlainText(string? value)
    {
        var text = System.Text.RegularExpressions.Regex.Replace(value ?? "", "<.*?>", " ");
        return System.Net.WebUtility.HtmlDecode(text).Trim();
    }

    string ProductDescription(TechExchangeApp.Entities.SanPhamCNTB p)
    {
        var text = PlainText(!string.IsNullOrWhiteSpace(p.MoTaNgan) ? p.MoTaNgan : p.MoTa);
        if (string.IsNullOrWhiteSpace(text))
        {
            return Html.Text("product.card.descFallback");
        }
        return text.Length > 110 ? text.Substring(0, 107).Trim() + "..." : text;
    }
}

<div class="columns-container tech-page san-pham-page">
    <div class="container" id="columns">
        <div class="row">
            <div class="center_column col-xs-12 col-sm-9 cntb" id="center_column">
                <div class="tech-page-hero">
                    <nav class="tech-breadcrumb" aria-label="breadcrumb">
                        <partial name="_BreadcrumbHome" />
                        <span>/</span>
                        <strong>@Html.Text("common.products")</strong>
                    </nav>
                    <h1>@Html.Text("product.list.title")</h1>
                    <p>@Html.Text("product.list.desc")</p>

                    <div class="tech-hero-stats" aria-label="@Html.Text("product.list.statsAria")">
                        <span><strong>@Model.TotalCongNghe</strong>@Html.Text("common.technology")</span>
                        <span><strong>@Model.TotalThietBi</strong>@Html.Text("common.equipment")</span>
                        <span><strong>@Model.TotalTaiSanTriTue</strong>@Html.Text("common.ipAssetsFull")</span>
                    </div>
                </div>

                <div class="san-pham-type-filter" role="group" aria-label="@Html.Text("product.list.filterAria")">
                    <button type="button" class="@(Model.CurrentType == 0 ? "is-active" : "")" onclick="location.href='?type=0&amp;pageSize=@Model.PageSize'">@Html.Text("common.all") (@Model.TotalProducts)</button>
                    <button type="button" class="@(Model.CurrentType == 1 ? "is-active" : "")" onclick="location.href='?type=1&amp;pageSize=@Model.PageSize'">@Html.Text("common.technology") (@Model.TotalCongNghe)</button>
                    <button type="button" class="@(Model.CurrentType == 2 ? "is-active" : "")" onclick="location.href='?type=2&amp;pageSize=@Model.PageSize'">@Html.Text("common.equipment") (@Model.TotalThietBi)</button>
                    <button type="button" class="@(Model.CurrentType == 3 ? "is-active" : "")" onclick="location.href='?type=3&amp;pageSize=@Model.PageSize'">@Html.Text("common.ipAssets") (@Model.TotalTaiSanTriTue)</button>
                </div>

                @if (Model.Products.Any())
                {
                    <div class="tech-grid" id="sanPhamGrid">
                        @foreach (var p in Model.Products)
                        {
                            <article class="tech-card" data-type="@p.ProductType">
                                <a class="tech-card__image" href="@ProductUrl(p)">
                                    <img src="@ProductImage(p)" alt="@p.Name" />
                                </a>
                                <div class="tech-card__body">
                                    <span class="tech-card__badge tech-card__badge--type-@p.ProductType">@TypeLabel(p.ProductType)</span>
                                    <h3 class="tech-card__title">
                                        <a href="@ProductUrl(p)" title="@p.Name">@p.Name</a>
                                    </h3>
                                    <p class="tech-card__desc">@ProductDescription(p)</p>
                                    <a href="@ProductUrl(p)" class="tech-card__btn">@Html.Text("common.details") <i class="bi bi-arrow-right"></i></a>
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-inbox" style="font-size:32px;"></i>
                        <p class="mt-2">@Html.Text("product.list.empty")</p>
                    </div>
                }

                @{
                    int totalPages = Model.PageSize > 0 ? (int)Math.Ceiling((double)Model.Total / Model.PageSize) : 1;
                    int curPage = Model.CurPage;
                }
                @if (totalPages > 1)
                {
                    <nav class="catalog-pagination" aria-label="@Html.Text("common.pagination")">
                        <ul>
                            <li class="@(curPage == 1 ? "disabled" : "")">
                                <a href="?type=@Model.CurrentType&page=@(curPage - 1)&pageSize=@Model.PageSize" aria-label="@Html.Text("common.prevPage")"><i class="bi bi-chevron-left"></i></a>
                            </li>
                            @foreach (var pg in Model.Pages)
                            {
                                <li class="@(pg.IsActive ? "active" : "")">
                                    <a href="?type=@Model.CurrentType&page=@pg.Page&pageSize=@Model.PageSize">@pg.Page</a>
                                </li>
                            }
                            <li class="@(curPage == totalPages ? "disabled" : "")">
                                <a href="?type=@Model.CurrentType&page=@(curPage + 1)&pageSize=@Model.PageSize" aria-label="@Html.Text("common.nextPage")"><i class="bi bi-chevron-right"></i></a>
                            </li>
                        </ul>
                    </nav>
                }

                <section class="tech-transfer-cta">
                    <div>
                        <span>@Html.Text("product.cta.kicker")</span>
                        <h2>@Html.Text("product.cta.title")</h2>
                        <p>@Html.Text("product.cta.button_desc")</p>
                    </div>
                    <div class="tech-transfer-cta__actions">
                        <a class="tech-transfer-cta__primary" href="@(isEn ? $"{Html.MainDomain()}en/technology-demand" : $"{Html.MainDomain()}tim-mua-cong-nghe")">@Html.Text("product.cta.button")</a>
                    </div>
                </section>
            </div>

            <div class="column col-xs-12 col-sm-3" id="left_column">
                @await Html.PartialAsync("_ServiceSidebarBanners")
            </div>
        </div>
    </div>
</div>


