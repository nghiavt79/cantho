@model TechExchangeApp.ViewModel.ProductByCateViewModel
@{
    ViewData["Title"] = Model.PageTitle;
    var mainDomain = Model.MainDomain;
    var isEn = TechExchangeApp.Helpers.LangHelper.IsEnglish(Context);
    int totalPages = Model.PageSize > 0 ? (int)Math.Ceiling((double)Model.Total / Model.PageSize) : 1;
    int curPage = Model.CurPage;
    int startItem = Model.Total > 0 ? (curPage - 1) * Model.PageSize + 1 : 0;
    int endItem = Math.Min(curPage * Model.PageSize, Model.Total);

    // Giữ trạng thái lọc/sắp xếp khi phân trang & đổi tuỳ chọn
    string kw = Uri.EscapeDataString(Model.Keyword ?? "");
    string sortParam = Model.Sort ?? "newest";
    string ProductsUrl() => isEn ? $"{mainDomain}en/products" : $"{mainDomain}san-pham";
    string TechnologyUrl() => isEn ? $"{mainDomain}en/technologies" : $"{mainDomain}cong-nghe";
    string CategoryUrl(TechExchangeApp.Entities.Category cat) => isEn
        ? $"{mainDomain}en/products/category/{TechExchangeApp.Controllers.ProductController.MakeURLFriendly(cat.QueryString)}-{cat.CatId}"
        : $"{mainDomain}san-pham/{TechExchangeApp.Controllers.ProductController.MakeURLFriendly(cat.QueryString)}-{cat.CatId}";

    string categoryDesc = !string.IsNullOrWhiteSpace(Model.Description)
        ? Model.Description
        : (isEn
            ? $"A collection of equipment, software, solutions and technologies in the {Model.CateTitle} field, for connection, promotion and technology transfer."
            : $"Tổng hợp các thiết bị, phần mềm, giải pháp và công nghệ thuộc lĩnh vực {Model.CateTitle}, phục vụ kết nối, giới thiệu và chuyển giao công nghệ.");
}

<div class="columns-container tech-page">
    <div class="container" id="columns">

        <!-- ===== BREADCRUMB ===== -->
        <nav class="catalog-breadcrumb" aria-label="breadcrumb">
            <partial name="_BreadcrumbHome" />
            <span>/</span>
            <a href="@ProductsUrl()">@Html.Text("common.products")</a>
            <span>/</span>
            <strong>@Model.CateTitle</strong>
        </nav>

        <!-- ===== COMPACT HEADER ===== -->
        <div class="category-compact-header">
            <div class="category-header-top">
                <h1 class="category-title">@Model.CateTitle</h1>
                <div class="category-meta">
                    <span class="category-meta-chip"><i class="bi bi-box-seam"></i> @Model.Total @Html.Text("product.cate.productsUnit")</span>
                    @if (Model.Total > 0)
                    {
                        <span class="category-meta-chip"><i class="bi bi-eye"></i> @Html.Text("product.cate.showing") @startItem–@endItem</span>
                    }
                </div>
            </div>
            <div class="category-header-bottom">
                <p class="category-desc">@categoryDesc</p>
                <div class="category-actions">
                    <form method="get" class="category-search input-group input-group-sm" role="search">
                        <input type="hidden" name="sort" value="@sortParam" />
                        <input type="hidden" name="pageSize" value="@Model.PageSize" />
                        <input type="search" class="form-control" name="keyword" value="@Model.Keyword" placeholder="@Html.Text("product.cate.searchPlaceholder")" aria-label="@Html.Text("common.search")" />
                        <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i></button>
                    </form>
                    <select class="form-select form-select-sm category-sort" onchange="location.href='?sort=' + this.value + '&pageSize=@Model.PageSize&keyword=@kw'" aria-label="@Html.Text("product.cate.sort")">
                        <option value="newest" selected="@(sortParam == "newest")">@Html.Text("product.cate.sortNewest")</option>
                        <option value="name-asc" selected="@(sortParam == "name-asc")">@Html.Text("product.cate.sortNameAsc")</option>
                        <option value="name-desc" selected="@(sortParam == "name-desc")">@Html.Text("product.cate.sortNameDesc")</option>
                        <option value="price-asc" selected="@(sortParam == "price-asc")">@Html.Text("product.cate.sortPriceAsc")</option>
                        <option value="price-desc" selected="@(sortParam == "price-desc")">@Html.Text("product.cate.sortPriceDesc")</option>
                    </select>
                    <select class="form-select form-select-sm category-page-size" onchange="location.href='?page=1&pageSize=' + this.value + '&sort=@sortParam&keyword=@kw'" aria-label="@Html.Text("product.cate.perPageAria")">
                        @foreach (var size in new[] { 12, 24, 36 })
                        {
                            if (size == Model.PageSize)
                            {
                                <option value="@size" selected>@size @Html.Text("product.cate.perPage")</option>
                            }
                            else
                            {
                                <option value="@size">@size @Html.Text("product.cate.perPage")</option>
                            }
                        }
                    </select>
                </div>
            </div>
        </div>

        <!-- ===== MAIN LAYOUT: content LEFT, sidebar RIGHT ===== -->
        <div class="row g-3">

            <!-- ===== PRODUCT GRID (col-9, LEFT) ===== -->
            <div class="col-lg-9 col-12 order-1 order-lg-1" id="center_column">

                @if (Model.Total > 0)
                {
                    <div class="catalog-info">
                        @Html.Text("product.cate.showing") <strong>@startItem–@endItem</strong> @Html.Text("product.cate.ofTotal") <strong>@Model.Total</strong> @Html.Text("product.cate.productsUnit")
                    </div>
                }

                @if (!Model.Products.Any())
                {
                    <div class="catalog-empty">
                        <i class="bi bi-inbox"></i>
                        <p>@Html.Text("product.cate.emptyField")</p>
                        <a href="@TechnologyUrl()" class="btn-back-catalog">@Html.Text("product.cate.backToTech")</a>
                    </div>
                }
                else
                {
                    <div class="catalog-grid">
                        @foreach (var p in Model.Products)
                        {
                            var hasPriceText = !string.IsNullOrWhiteSpace(p.PriceText) && p.PriceText != "0 " && p.PriceText != "0";

                            <article class="tech-card">
                                <a class="tech-card__image" href="@p.Url">
                                    <img src="@p.ImageUrl" alt="@p.Title" loading="lazy" />
                                </a>
                                <div class="tech-card__body">
                                    @if (!string.IsNullOrWhiteSpace(p.CategoryName))
                                    {
                                        <span class="tech-card__badge">@p.CategoryName</span>
                                    }
                                    <h3 class="tech-card__title">
                                        <a href="@p.Url" title="@p.Title">@p.Title</a>
                                    </h3>
                                    @if (!string.IsNullOrWhiteSpace(p.Description))
                                    {
                                        <p class="tech-card__desc">@p.Description</p>
                                    }
                                    <div class="tech-card__source">
                                        <i class="bi bi-building"></i> @Html.Text("product.cate.supplier") @p.SupplierName
                                    </div>
                                    <div class="tech-card__price">
                                        @Html.Text("product.cate.refPrice") <strong>@(hasPriceText ? p.PriceText : I18n.T(Context, "product.detail.priceContact"))</strong>
                                    </div>
                                    <a href="@p.Url" class="tech-card__btn">@Html.Text("common.details") <i class="bi bi-arrow-right"></i></a>
                                </div>
                            </article>
                        }
                    </div>
                }

                <!-- ===== PAGINATION ===== -->
                @if (totalPages > 1)
                {
                    <nav class="catalog-pagination" aria-label="@Html.Text("common.pagination")">
                        <ul>
                            <li class="@(curPage == 1 ? "disabled" : "")">
                                <a href="?page=@(curPage - 1)&pageSize=@Model.PageSize&sort=@sortParam&keyword=@kw" aria-label="@Html.Text("common.prevPage")"><i class="bi bi-chevron-left"></i></a>
                            </li>
                            @foreach (var pg in Model.Pages)
                            {
                                <li class="@(pg.IsActive ? "active" : "")">
                                    <a href="?page=@pg.Page&pageSize=@Model.PageSize&sort=@sortParam&keyword=@kw">@pg.Page</a>
                                </li>
                            }
                            <li class="@(curPage == totalPages ? "disabled" : "")">
                                <a href="?page=@(curPage + 1)&pageSize=@Model.PageSize&sort=@sortParam&keyword=@kw" aria-label="@Html.Text("common.nextPage")"><i class="bi bi-chevron-right"></i></a>
                            </li>
                        </ul>
                    </nav>
                }

                <!-- ===== CTA ===== -->
                <section class="catalog-cta">
                    <div>
                        <h2>@Html.Text("product.cta.title")</h2>
                        <p>@Html.Text("product.cta.button_desc")</p>
                    </div>
                    <div class="catalog-cta__actions">
                        <a class="catalog-cta__primary" href="@(isEn ? $"{mainDomain}en/technology-demand" : $"{mainDomain}tim-mua-cong-nghe")">@Html.Text("product.cta.button")</a>
                    </div>
                </section>
            </div>

            <!-- ===== SIDEBAR (col-3, RIGHT) ===== -->
            <div class="col-lg-3 d-none d-lg-block order-2 order-lg-2" id="left_column">
                <aside class="filter-sidebar">

                    <!-- Lĩnh vực -->
                    <div class="filter-sidebar__group">
                        <h4 class="filter-title">@Html.Text("product.cate.techField")</h4>
                        <ul class="filter-sidebar__links category-list">
                            @foreach (var cat in Model.AllCategories)
                            {
                                var isActive = cat.CatId == Model.CateId;
                                <li class="@(isActive ? "active" : "")">
                                    <a href="@CategoryUrl(cat)">
                                        @cat.Title
                                        @if (isActive) { <i class="bi bi-check2"></i> }
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    @if (Model.Categories.Any())
                    {
                        <div class="filter-sidebar__group">
                            <h4 class="filter-title">@Html.Text("product.cate.subCategories")</h4>
                            <ul class="filter-sidebar__links">
                                @foreach (var cate in Model.Categories)
                                {
                                    <li><a href="@cate.Url">@cate.Title</a></li>
                                }
                            </ul>
                        </div>
                    }

                    <!-- Khoảng giá -->
                    <div class="filter-sidebar__group filter-section">
                        <h4 class="filter-title">@Html.Text("product.cate.priceRange")</h4>
                        <label class="filter-check"><input type="checkbox" name="price" value="contact" /> @Html.Text("product.detail.priceContact")</label>
                        <label class="filter-check"><input type="checkbox" name="price" value="0-5" /> @Html.Text("product.cate.priceUnder5")</label>
                        <label class="filter-check"><input type="checkbox" name="price" value="5-20" /> @Html.Text("product.cate.price5to20")</label>
                        <label class="filter-check"><input type="checkbox" name="price" value="20+" /> @Html.Text("product.cate.priceOver20")</label>
                    </div>

                    <!-- Trạng thái -->
                    <div class="filter-sidebar__group filter-section">
                        <h4 class="filter-title">@Html.Text("common.status")</h4>
                        <label class="filter-check"><input type="checkbox" name="status" value="ready" /> @Html.Text("product.cate.statusReady")</label>
                        <label class="filter-check"><input type="checkbox" name="status" value="intro" /> @Html.Text("product.detail.statusIntroducing")</label>
                        <label class="filter-check"><input type="checkbox" name="status" value="consult" /> @Html.Text("product.cate.statusConsult")</label>
                    </div>

                    <div class="filter-sidebar__actions">
                        <button type="button" class="btn-filter-apply">@Html.Text("product.cate.apply")</button>
                        <button type="button" class="btn-filter-clear" onclick="location.href=location.pathname">@Html.Text("product.cate.clearFilter")</button>
                    </div>
                </aside>
            </div>

        </div>

    </div>
</div>
