@using TechExchangeApp.ViewModel
@using TechExchangeApp.Entities
@model ProductDetailViewModel

@{
    var p = Model.Product;
    var categories = Model.RelatedCategories ?? new List<Category>();
    var isEn = TechExchangeApp.Helpers.LangHelper.IsEnglish(Context);
    string CategoryUrl(Category cat) => isEn
        ? $"/en/products/category/{TechExchangeApp.Controllers.ProductController.MakeURLFriendly(cat.QueryString)}-{cat.CatId}"
        : $"/san-pham/{TechExchangeApp.Controllers.ProductController.MakeURLFriendly(cat.QueryString)}-{cat.CatId}";
    var productImage = Html.CookedImageURL("org", p.QuyTrinhHinhAnh);
    var rating = p.Rating ?? 0;
    var ratingText = rating > 0 ? rating.ToString("0.0") : "0.0";
    // Giá lấy từ "Giá bán dự kiến / Giá tham khảo" (GiaBanDuKien, CKEditor = HTML) — render thẳng bằng Html.Raw.
    // giaBanText (bản strip-tag ở dưới) chỉ để KIỂM TRA rỗng; thiếu thì fallback SellPrice, cuối mới "Liên hệ báo giá".
    var giaBanText = System.Text.RegularExpressions.Regex.Replace(p.GiaBanDuKien ?? "", "<.*?>", " ");
    giaBanText = System.Text.RegularExpressions.Regex.Replace(System.Net.WebUtility.HtmlDecode(giaBanText).Replace(' ', ' '), "\\s+", " ").Trim();
    bool hasGiaBan = !string.IsNullOrWhiteSpace(giaBanText);
    // GiaBanDuKien có thẻ HTML (vd bảng giá MISA) -> KHÔNG áp style tech-price (cam/đậm/18px), để hiện trung tính.
    bool giaBanIsHtml = (p.GiaBanDuKien ?? "").Contains('<');
    var priceFallback = p.SellPrice.HasValue && p.SellPrice.Value > 0
        ? string.Format("{0:N0} {1}", p.SellPrice.Value, p.Currency)
        : I18n.T(Context, "product.detail.priceContact");
    var updatedText = (p.Modified ?? p.PublishedDate ?? p.Created)?.ToString("dd/MM/yyyy") ?? I18n.T(Context, "common.updating");
    var categoryText = string.IsNullOrWhiteSpace(Model.CategoryTitle) ? I18n.T(Context, "common.updating") : Model.CategoryTitle;
    var supplierText = string.IsNullOrWhiteSpace(Model.SupplierName) ? I18n.T(Context, "common.updating") : Model.SupplierName;
    var originText = string.IsNullOrWhiteSpace(p.XuatXu) ? I18n.T(Context, "common.updating") : p.XuatXu;
    var techCode = string.IsNullOrWhiteSpace(p.Code) ? p.ID.ToString("D5") : p.Code;

    var catIds = new List<int>();
    if (!string.IsNullOrEmpty(p.CategoryId))
    {
        foreach (var s in p.CategoryId.Split(new[] { ',', '|', ';' }, StringSplitOptions.RemoveEmptyEntries))
        {
            if (int.TryParse(s.Trim(), out var cid)) catIds.Add(cid);
        }
    }

    var activeIndustries = Model.Industries?.Where(ind => catIds.Contains(ind.CatId)).ToList() ?? new List<Category>();
    var hasDocuments = !string.IsNullOrWhiteSpace(Model.YoutubeEmbedUrl)
        || !string.IsNullOrWhiteSpace(Model.VideoFileUrl)
        || !string.IsNullOrWhiteSpace(p.BrochureUrl)
        || p.ChungNhanISO == true
        || p.ChungNhanQuatest == true
        || p.ChungNhanKhac == true;
}

<div class="tech-detail-page">
    <nav class="tech-breadcrumb" aria-label="breadcrumb">
        <partial name="_BreadcrumbHome" /><span>/</span><a href="@(isEn ? "/en/products" : "/san-pham")">@Html.Text("common.products")</a>
        @if (!string.IsNullOrWhiteSpace(Model.CategoryTitle))
        {
            <span>/</span><span>@Model.CategoryTitle</span>
        }
    </nav>

    <h1 class="tech-page-title">@Html.Text("product.tech.heading")</h1>

    <section class="tech-card tech-hero">
        <div class="row g-4">
            <div class="col-lg-5">
                <div class="tech-hero-image"><img src="@productImage" alt="@p.Name" /></div>
                @if (Model.Images != null && Model.Images.Any())
                {
                    <div class="tech-thumbs">
                        @foreach (var img in Model.Images.Take(6))
                        {
                            <img src="@Html.CookedImageURL("68-68", img.FileURL)" alt="@p.Name" />
                        }
                    </div>
                }
            </div>
            <div class="col-lg-7">
                <span class="tech-badge"><i class="fa fa-microchip"></i>@categoryText</span>
                <h2 class="tech-name">@p.Name</h2>
                <div class="tech-meta" id="headerMetaLine" data-entity-type="SanPhamCNTB" data-entity-id="@p.ID">
                    <span><span class="tech-stars">★★★★★</span> <strong id="headerRatingAvg">@ratingText</strong> (<span id="headerRatingCount">@Model.RatingCount</span> @Html.Text("product.detail.reviews"))</span>
                    <span><i class="fa fa-eye"></i> <span id="headerViewCount">@((p.Viewed ?? 0).ToString("N0"))</span> @Html.Text("product.detail.views")</span>
                </div>

                <div class="tech-info-grid">
                    <div class="tech-info-row">
                        <span class="tech-info-label">@Html.Text("product.detail.supplier")</span>
                        <span class="tech-info-value">
                            @if (!string.IsNullOrWhiteSpace(Model.SupplierUrl) && !string.IsNullOrWhiteSpace(Model.SupplierName))
                            {
                                <a href="@Model.SupplierUrl">@Model.SupplierName</a>
                            }
                            else
                            {
                                @supplierText
                            }
                        </span>
                    </div>
                    <div class="tech-info-row"><span class="tech-info-label">@Html.Text("common.category")</span><span class="tech-info-value">@categoryText</span></div>
                    <div class="tech-info-row"><span class="tech-info-label">@Html.Text("product.detail.origin")</span><span class="tech-info-value">@originText</span></div>
                    <div class="tech-info-row"><span class="tech-info-label">@Html.Text("product.detail.price")</span><span class="@(hasGiaBan && giaBanIsHtml ? "tech-info-value" : "tech-price")">@if (hasGiaBan) { @Html.Raw(p.GiaBanDuKien) } else { @priceFallback }</span></div>
                </div>

                <div class="tech-actions">
                    <a href="/TechTransfer/Create?fromId=@p.ID&typeData=1" class="tech-btn tech-btn-primary"><i class="fa fa-file-signature"></i>@Html.Text("product.detail.priceContact")</a>
                </div>
                @if (p.RequiresNDA == true)
                {
                    <div class="alert alert-warning mt-3 mb-0 py-2">
                        <i class="fa fa-shield-alt me-1"></i>
                        @Html.Text("product.tech.ndaWarning")
                    </div>
                }
            </div>
        </div>
    </section>

    <div class="tech-layout">
        <main>
            <section class="tech-tabs-card">
                <ul class="nav nav-tabs" id="detailTabsCongNghe" role="tablist">
                    <li class="nav-item" role="presentation"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#overview" type="button" role="tab">@Html.Text("product.tech.tab.overview")</button></li>
                    <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#spec" type="button" role="tab">@Html.Text("product.tech.tab.spec")</button></li>
                    <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#application" type="button" role="tab">@Html.Text("product.tech.tab.application")</button></li>
                    <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#transfer" type="button" role="tab">@Html.Text("product.tech.tab.transfer")</button></li>
                    <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#docs" type="button" role="tab">@Html.Text("product.tech.tab.docs")</button></li>
                    <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#review" type="button" role="tab">@Html.Text("product.tech.tab.review")</button></li>
                </ul>

                <div class="tab-content tech-tab-body">
                    <div class="tab-pane fade show active" id="overview" role="tabpanel">
                        <h3 class="tech-section-title">@Html.Text("product.tech.techInfo")</h3>
                        <div class="tech-info-grid mb-3">
                            <div class="tech-info-row"><span class="tech-info-label">@Html.Text("product.tech.name")</span><span class="tech-info-value">@p.Name</span></div>
                            <div class="tech-info-row"><span class="tech-info-label">@Html.Text("product.tech.code")</span><span class="tech-info-value">@techCode</span></div>
                            <div class="tech-info-row"><span class="tech-info-label">@Html.Text("product.detail.origin")</span><span class="tech-info-value">@originText</span></div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(p.MoTaNgan))
                        {
                            <div class="tech-content">@Html.Raw(p.MoTaNgan)</div>
                        }
                        else if (!string.IsNullOrWhiteSpace(p.MoTa))
                        {
                            <div class="tech-content">@Html.Raw(p.MoTa)</div>
                        }
                        else
                        {
                            <div class="tech-empty">@Html.Text("product.tech.overviewEmpty")</div>
                        }
                    </div>

                    <div class="tab-pane fade" id="spec" role="tabpanel">
                        <h3 class="tech-section-title">@Html.Text("product.tech.tab.spec")</h3>
                        @if (!string.IsNullOrWhiteSpace(p.ThongSo)) { <div class="tech-content">@Html.Raw(p.ThongSo)</div> } else { <div class="tech-empty">@Html.Text("product.tech.specEmpty")</div> }
                        @if (!string.IsNullOrWhiteSpace(p.UuDiem)) { <h3 class="tech-section-title mt-4">@Html.Text("product.tech.advantages")</h3><div class="tech-content">@Html.Raw(p.UuDiem)</div> }
                    </div>

                    <div class="tab-pane fade" id="application" role="tabpanel">
                        <h3 class="tech-section-title">@Html.Text("product.tech.applicationTitle")</h3>
                        @if (activeIndustries.Any())
                        {
                            <ul class="tech-category-list mb-3">
                                @foreach (var ind in activeIndustries) { <li><a href="#">@ind.Title</a></li> }
                            </ul>
                        }
                        @if (!string.IsNullOrWhiteSpace(p.TargetCustomer) || !string.IsNullOrWhiteSpace(p.Khachhang) || !string.IsNullOrWhiteSpace(p.CooperationGoal))
                        {
                            <div class="tech-content">@Html.Raw(p.TargetCustomer) @Html.Raw(p.Khachhang) @Html.Raw(p.CooperationGoal)</div>
                        }
                        else if (!activeIndustries.Any())
                        {
                            <div class="tech-empty">@Html.Text("product.tech.applicationEmpty")</div>
                        }
                    </div>

                    <div class="tab-pane fade" id="transfer" role="tabpanel">
                        <h3 class="tech-section-title">@Html.Text("product.tech.transferTitle")</h3>
                        @if (p.RequiresNDA == true)
                        {
                            <div class="tech-info-grid mb-3">
                                <div class="tech-info-row">
                                    <span class="tech-info-label">@Html.Text("product.tech.ndaLabel")</span>
                                    <span class="tech-info-value">@Html.Text("product.tech.ndaMaybe")</span>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(p.NDAContent))
                            {
                                <div class="mb-3">
                                    <h4 class="tech-subsection-title">@Html.Text("product.tech.ndaContentTitle")</h4>
                                    <div class="tech-content" style="white-space: pre-line">@p.NDAContent</div>
                                </div>
                            }
                        }
                        @if (!string.IsNullOrWhiteSpace(p.TransferMethod) || !string.IsNullOrWhiteSpace(p.TransferMethodKhac) || !string.IsNullOrWhiteSpace(p.GiaBanDuKien) || !string.IsNullOrWhiteSpace(p.BaoHanhHoTro))
                        {
                            <div class="tech-content">
                                @if (!string.IsNullOrWhiteSpace(p.TransferMethod)) { <p><strong>@Html.Text("product.tech.method")</strong> @p.TransferMethod</p> }
                                @if (!string.IsNullOrWhiteSpace(p.TransferMethodKhac)) { <p><strong>@Html.Text("product.tech.other")</strong> @p.TransferMethodKhac</p> }
                                @if (!string.IsNullOrWhiteSpace(p.GiaBanDuKien)) { <p><strong>@Html.Text("product.tech.expectedPrice")</strong></p>@Html.Raw(p.GiaBanDuKien) }
                                @if (!string.IsNullOrWhiteSpace(p.ChiPhiPhatSinh)) { <p><strong>@Html.Text("product.tech.extraCost")</strong></p>@Html.Raw(p.ChiPhiPhatSinh) }
                                @if (!string.IsNullOrWhiteSpace(p.BaoHanhHoTro)) { <p><strong>@Html.Text("product.tech.warranty")</strong></p>@Html.Raw(p.BaoHanhHoTro) }
                            </div>
                        }
                        else
                        {
                            <div class="tech-empty">@Html.Text("product.tech.transferEmpty")</div>
                        }
                    </div>

                    <div class="tab-pane fade" id="docs" role="tabpanel">
                        <h3 class="tech-section-title">@Html.Text("product.tech.docsTitle")</h3>
                        @if (hasDocuments)
                        {
                            <div class="tech-content">
                                @if (!string.IsNullOrWhiteSpace(Model.YoutubeEmbedUrl))
                                {
                                    <div class="ratio ratio-16x9 mb-3"><iframe src="@Model.YoutubeEmbedUrl" title="@p.Name" allowfullscreen></iframe></div>
                                }
                                else if (!string.IsNullOrWhiteSpace(Model.VideoFileUrl))
                                {
                                    <p><a class="tech-btn tech-btn-outline" href="@Model.VideoFileUrl" target="_blank"><i class="fa fa-play"></i>@Html.Text("product.tech.watchVideo")</a></p>
                                }
                                @if (!string.IsNullOrWhiteSpace(p.BrochureUrl)) { <p><a class="tech-btn tech-btn-outline" href="@p.BrochureUrl" target="_blank"><i class="fa fa-download"></i>@Html.Text("product.tech.downloadDoc")</a></p> }
                                <ul>
                                    @if (p.ChungNhanISO == true) { <li>ISO / CE / HACCP</li> }
                                    @if (p.ChungNhanQuatest == true) { <li>@Html.Text("product.tech.quatest")</li> }
                                    @if (p.ChungNhanKhac == true) { <li>@(string.IsNullOrWhiteSpace(p.ChungNhanKhacText) ? I18n.T(Context, "product.tech.otherCert") : p.ChungNhanKhacText)</li> }
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="tech-empty">@Html.Text("product.tech.docsEmpty")</div>
                        }
                    </div>

                    <div class="tab-pane fade" id="review" role="tabpanel">
                        @if (Model.RatingCount <= 0) { <div class="tech-empty mb-3">@Html.Text("product.tech.noReviews")</div> }
                        @await Html.PartialAsync("_EntityRating", null, new ViewDataDictionary(ViewData) {
                            { "EntityType", "SanPhamCNTB" },
                            { "EntityId", p.ID }
                        })
                    </div>
                </div>
            </section>

            @await Html.PartialAsync("_ContentUtilities", new TechExchangeApp.ViewModel.ContentUtilitiesVm
            {
                TargetDataType = "San pham CNTB",
                TargetSubType = "Cong nghe",
                TargetId = p.ID,
                TargetTitle = p.Name,
                ShareTitle = p.Name
            })
        </main>

        <aside class="tech-sidebar">
            <section class="tech-sidebar-card">
                <h3 class="tech-sidebar-title">@Html.Text("product.detail.quickInfo")</h3>
                <dl class="tech-quick-list">
                    <div><dt>@Html.Text("product.tech.code")</dt><dd>@techCode</dd></div>
                    <div><dt>@Html.Text("common.category")</dt><dd>@categoryText</dd></div>
                    <div><dt>@Html.Text("product.detail.views")</dt><dd>@((p.Viewed ?? 0).ToString("N0"))</dd></div>
                    <div><dt>@Html.Text("product.detail.updated")</dt><dd>@updatedText</dd></div>
                    <div><dt>@Html.Text("common.status")</dt><dd>@Html.Text("product.detail.statusIntroducing")</dd></div>
                </dl>
            </section>

            @if (categories.Any())
            {
                <section class="tech-sidebar-card">
                    <h3 class="tech-sidebar-title">@Html.Text("product.detail.relatedCategories")</h3>
                    <ul class="tech-category-list">
                        @foreach (var cat in categories.Take(6))
                        {
                            <li><a href="@CategoryUrl(cat)">@cat.Title</a></li>
                        }
                    </ul>
                </section>
            }
        </aside>
    </div>

    <div class="tech-related-wrap">
        @await Component.InvokeAsync("ProductPortletIOSanpham", new { productId = p.ID })
    </div>
</div>
