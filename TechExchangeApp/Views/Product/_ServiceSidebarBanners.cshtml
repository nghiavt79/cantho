@{
    var mainDomain = Html.MainDomain();
    var isEn = TechExchangeApp.Helpers.LangHelper.IsEnglish(Context);
    var supportItems = new[]
    {
        new
        {
            Icon = "bi-search",
            Title = Html.Text("service.sidebar.find"),
            Text = Html.Text("service.sidebar.findDesc")
        },
        new
        {
            Icon = "bi-people",
            Title = Html.Text("service.sidebar.advisory"),
            Text = Html.Text("service.sidebar.advisoryDesc")
        },
        new
        {
            Icon = "bi-clipboard2-check",
            Title = Html.Text("service.sidebar.review"),
            Text = Html.Text("service.sidebar.reviewDesc")
        }
    };
}

<aside class="support-box" aria-label="@Html.Text("service.sidebar.ariaLabel")">
    <span class="support-box__kicker">@Html.Text("service.sidebar.kicker")</span>
    <h2>@Html.Text("service.sidebar.heading")</h2>
    <p>@Html.Text("service.sidebar.desc")</p>

    <a class="support-box__cta" href="@(isEn ? $"{mainDomain}en/technology-demand" : $"{mainDomain}lien-he")">
        @Html.Text("service.sidebar.cta") <i class="bi bi-arrow-right"></i>
    </a>

    <div class="support-box__items">
        @foreach (var item in supportItems)
        {
            <div class="support-item">
                <i class="bi @item.Icon"></i>
                <div>
                    <strong>@item.Title</strong>
                    <small>@item.Text</small>
                </div>
            </div>
        }
    </div>
</aside>
