@{
    var mainDomain = Html.MainDomain();
    var isEn = TechExchangeApp.Helpers.LangHelper.IsEnglish(Context);
    string T(string vi, string en) => isEn ? en : vi;
    var supportItems = new[]
    {
        new
        {
            Icon = "bi-search",
            Title = T("Tìm kiếm công nghệ phù hợp", "Find the right technology"),
            Text = T("Hỗ trợ doanh nghiệp tìm giải pháp theo nhu cầu sản xuất.", "Helping businesses find solutions for their production needs.")
        },
        new
        {
            Icon = "bi-people",
            Title = T("Tư vấn chuyển giao", "Transfer advisory"),
            Text = T("Kết nối chuyên gia, đơn vị nghiên cứu và doanh nghiệp.", "Connecting experts, research units and businesses.")
        },
        new
        {
            Icon = "bi-clipboard2-check",
            Title = T("Đánh giá khả năng ứng dụng", "Application feasibility review"),
            Text = T("Xem xét tính khả thi, chi phí và hiệu quả triển khai.", "Assessing feasibility, cost and implementation effectiveness.")
        }
    };
}

<aside class="support-box" aria-label="@T("Trung tâm hỗ trợ chuyển giao", "Technology transfer support center")">
    <span class="support-box__kicker">@T("Trung tâm hỗ trợ", "Support center")</span>
    <h2>@T("Bạn cần hỗ trợ chuyển giao công nghệ?", "Need help with technology transfer?")</h2>
    <p>@T("Gửi nhu cầu để được tư vấn giải pháp, chuyên gia và đối tác phù hợp.", "Send your request for advice on solutions, experts and suitable partners.")</p>

    <a class="support-box__cta" href="@(isEn ? $"{mainDomain}en/technology-demand" : $"{mainDomain}lien-he")">
        @T("Gửi yêu cầu tư vấn", "Send a request") <i class="bi bi-arrow-right"></i>
    </a>

    <div class="support-box__items">
        @foreach (var item in supportItems)
        {
            <div class="support-item">
                <i class="bi @item.Icon"></i>
                <div>
                    <strong>@item.Title</strong>
                    <small>@item.Text</small>
                </div>
            </div>
        }
    </div>
</aside>
