@{
    var vrTourUrl = "https://smarttravel-vr.mobifone.vn/vr-tour/san-giao-dich-cong-nghe";
}

<div class="action-dock">
    <div class="action-dock__card">
        <div class="action-dock__group">
            <button type="button" class="action-dock__btn" data-ai-chat-toggle data-tooltip="@Html.Text("common.supportChat")" aria-label="@Html.Text("common.supportChat")">
                <i class="bi bi-chat-dots-fill"></i>
                <span class="action-dock__label">Chat</span>
            </button>
            <a class="action-dock__btn" href="@vrTourUrl" target="_blank" rel="noopener" data-tooltip="@Html.Text("common.vr360")" aria-label="@Html.Text("common.vr360")">
                <i class="bi bi-badge-vr"></i>
                <span class="action-dock__label">VR</span>
            </a>
        </div>

        <div class="action-dock__divider" aria-hidden="true"></div>

        <div class="action-dock__group">
            <a class="action-dock__btn action-dock__btn--fb" href="https://www.facebook.com/profile.php?id=100069991094645" target="_blank" rel="noopener" data-tooltip="Facebook" aria-label="Facebook">
                <i class="bi bi-facebook"></i>
                <span class="action-dock__label">Facebook</span>
            </a>
            <a class="action-dock__btn action-dock__btn--zalo" href="https://id.zalo.me/account/login?continue=http%3A%2F%2Fzalo.me%2F02923907037" target="_blank" rel="noopener" data-tooltip="Zalo" aria-label="Zalo">
                <img src="/image/zalo-icon.webp" alt="" aria-hidden="true">
                <span class="action-dock__label">Zalo</span>
            </a>
            <a class="action-dock__btn action-dock__btn--guide" href="/huong-dan" data-tooltip="@Html.Text("common.userGuide")" aria-label="@Html.Text("common.userGuide")">
                <i class="bi bi-book-half"></i>
                <span class="action-dock__label">@Html.Text("sidebtn.guide")</span>
            </a>
            <button type="button" class="action-dock__btn action-dock__btn--top-mobile" data-back-to-top data-tooltip="@Html.Text("common.backToTop")" aria-label="@Html.Text("common.backToTop")">
                <i class="bi bi-chevron-up"></i>
                <span class="action-dock__label">@Html.Text("common.top")</span>
            </button>
        </div>
    </div>

    <button type="button" id="btnBackToTop" class="action-dock__top action-dock__top--desktop" data-back-to-top data-tooltip="@Html.Text("common.backToTop")" aria-label="@Html.Text("common.backToTop")">
        <i class="bi bi-chevron-up"></i>
        <span class="action-dock__label">@Html.Text("common.top")</span>
    </button>
</div>

<a class="action-dock-vr-shortcut" href="@vrTourUrl" target="_blank" rel="noopener" data-tooltip="@Html.Text("common.vr360")" aria-label="@Html.Text("common.vr360")">
    <i class="bi bi-badge-vr"></i>
</a>

<script>
    (function () {
        var backToTopButtons = document.querySelectorAll('[data-back-to-top]');
        backToTopButtons.forEach(function (button) {
            button.addEventListener('click', function () {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        });

        var backToTop = document.getElementById('btnBackToTop');
        if (backToTop) {
            var toggleVisibility = function () {
                backToTop.classList.toggle('is-visible', window.scrollY > 320);
            };
            toggleVisibility();
            window.addEventListener('scroll', toggleVisibility, { passive: true });
        }
    })();
</script>
