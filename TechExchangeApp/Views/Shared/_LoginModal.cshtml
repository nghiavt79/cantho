<!-- Login Modal -->
<div class="modal fade auth-modal" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <!-- Header with gradient -->
            <div class="modal-header">
                <h5 class="modal-title" id="loginModalLabel">
                    <i class="bi bi-box-arrow-in-right me-2"></i>@Html.Text("common.login")
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Body with form -->
            <div class="modal-body">
                <form id="loginForm" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Error display -->
                    <div class="alert alert-danger d-none" id="loginErrors" role="alert"></div>

                    <!-- Username input with icon -->
                    <div class="form-group mb-3">
                        <label for="loginUsername" class="form-label">@Html.Text("auth.username")</label>
                        <div class="input-group-icon">
                            <i class="bi bi-person input-icon"></i>
                            <input type="text"
                                   class="form-control"
                                   id="loginUsername"
                                   name="UserName"
                                   placeholder="@Html.Text("auth.usernamePh")"
                                   required>
                        </div>
                    </div>

                    <!-- Password input with icon -->
                    <div class="form-group mb-3">
                        <label for="loginPassword" class="form-label">@Html.Text("auth.password")</label>
                        <div class="input-group-icon">
                            <i class="bi bi-lock input-icon"></i>
                            <input type="password"
                                   class="form-control"
                                   id="loginPassword"
                                   name="Password"
                                   placeholder="@Html.Text("auth.passwordPh")"
                                   required>
                        </div>
                    </div>

                    <!-- Remember me checkbox -->
                    <div class="form-check mb-4">
                        <input class="form-check-input"
                               type="checkbox"
                               id="rememberMe"
                               name="RememberMe"
                               value="true">
                        <input type="hidden" name="RememberMe" value="false">
                        <label class="form-check-label" for="rememberMe">
                            @Html.Text("auth.rememberMe")
                        </label>
                    </div>

                    <!-- Submit button with loading state -->
                    <button type="submit" class="btn btn-primary w-100 auth-submit-btn">
                        <span class="btn-text">@Html.Text("common.login")</span>
                        <span class="spinner-border spinner-border-sm d-none ms-2" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </span>
                    </button>
                </form>
            </div>

            <!-- Footer with register link -->
            <div class="modal-footer justify-content-center">
                <p class="mb-0">
                    @Html.Text("auth.noAccountQ")
                    <a href="#" class="auth-switch-link" onclick="switchToRegister(event)">@Html.Text("auth.registerNow")</a>
                </p>
            </div>
        </div>
    </div>
</div>
