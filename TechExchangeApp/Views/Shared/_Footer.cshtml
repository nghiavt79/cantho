@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var shortName = Configuration["SiteBranding:ShortName"] ?? "TechExchange";
    var organizationName = Configuration["SiteBranding:OrganizationName"] ?? "TechExchange";
    var tagline = Configuration["SiteBranding:Tagline"] ?? "";
    var phone = Configuration["SiteBranding:Phone"] ?? "";
    var email = Configuration["SiteBranding:Email"] ?? "";
    var address = Configuration["SiteBranding:Address"] ?? "";
    var mapUrl = "https://www.google.com/maps/search/?api=1&query=" + Uri.EscapeDataString(address);
    var isEn = TechExchangeApp.Helpers.LangHelper.IsEnglish(Context);
    var fullOrgTitle = Html.Text("footer.orgName");
    var fullOrgSlogan = Html.Text("footer.tagline");
    var newsUrl = isEn ? "/en/news-event" : "/tin-su-kien";
    var addressText = isEn ? Html.Text("footer.address").ToString() : address;
    var servicesUrl = isEn ? "/en/services" : "/dich-vu-tu-van";
    var techUrl = isEn ? "/en/technologies" : "/cong-nghe";
    var traceabilityUrl = isEn ? "/en/services/traceability-29" : "/dich-vu-tu-van/truy-xuat-nguon-goc-29";
    var expertsUrl = isEn ? "/en/experts" : "/chuyen-gia";
    var contactUrl = isEn ? "/en/contact" : "/lien-he";
}

<footer class="site-footer-v2">
    <div class="container">
        <div class="site-footer-v2__grid">
            <div>
                <div class="site-footer-v2__brand">
                    <img src="/image/logo-casta.webp" alt="@shortName" onerror="this.src='/image/logo.png'">
                    <span>
                        <strong>@fullOrgTitle</strong>
                        <small>@fullOrgSlogan</small>
                    </span>
                </div>
                <p>@(isEn ? "The Can Tho Science & Technology Application Center" : organizationName) @Html.Text("footer.about")</p>
                <div class="site-footer-v2__social">
                    <a href="https://www.facebook.com/profile.php?id=100069991094645" target="_blank" rel="noopener" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                    <a href="https://www.youtube.com/@@TrungtamUngdungCanTho" target="_blank" rel="noopener" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                    <a href="https://id.zalo.me/account/login?continue=http%3A%2F%2Fzalo.me%2F02923907037" target="_blank" rel="noopener" aria-label="Zalo"><img class="site-footer-v2__zalo-icon" src="/image/zalo-icon.webp" alt=""></a>
                </div>
            </div>

            <div>
                <h3>@Html.Text("footer.quickLinks")</h3>
                <a href="@TechExchangeApp.Helpers.LangHelper.HomeUrl(Context)">@Html.Text("common.home")</a>
                <a href="@(isEn ? "/en/about" : "/gioi-thieu-chung-3")">@Html.Text("common.about")</a>
                <a href="@servicesUrl">@Html.Text("footer.servicesSolutions")</a>
                <a href="@newsUrl">@Html.Text("news.title")</a>
                <a href="@contactUrl">@Html.Text("common.contact")</a>
            </div>

            <div>
                <h3>@Html.Text("common.services")</h3>
                <a href="@techUrl">@Html.Text("footer.techSupply")</a>
                <a href="@servicesUrl">@Html.Text("footer.consulting")</a>
                <a href="@traceabilityUrl">@Html.Text("common.traceability")</a>
                <a href="@expertsUrl">@Html.Text("common.expertNetwork")</a>
            </div>

            <div>
                <h3>@Html.Text("common.contact")</h3>
                <p><a href="@mapUrl" target="_blank" rel="noopener"><i class="bi bi-geo-alt"></i> @addressText</a></p>
                <p><i class="bi bi-telephone"></i> @phone</p>
                <p><i class="bi bi-envelope"></i> @email</p>
                <form class="site-footer-v2__newsletter">
                    <input type="email" placeholder="@Html.Text("footer.emailPlaceholder")" aria-label="@Html.Text("footer.emailLabel")">
                    <button type="submit" aria-label="@Html.Text("footer.subscribe")"><i class="bi bi-send"></i></button>
                </form>
            </div>
        </div>

        <div class="site-footer-v2__bottom">
            <span>© @DateTime.Now.Year @shortName. All rights reserved.</span>
            <span>@(isEn ? "Connecting research · Practical application · Innovation" : tagline)</span>
        </div>
    </div>
</footer>
