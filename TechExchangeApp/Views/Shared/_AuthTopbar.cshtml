@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject TechExchangeApp.Interfaces.ICmsAccessService CmsAccessService
@{
    var shortName = Configuration["SiteBranding:ShortName"] ?? "CASTA";
    var canAccessCms = await CmsAccessService.CanAccessCmsAsync(ViewContext.HttpContext.User);
    // Đọc cờ ngôn ngữ thật (middleware đã xét cookie site_lang cho path workspace),
    // không đọc thẳng cookie nữa — để trạng thái is-active khớp với nội dung đang render.
    var isEn = TechExchangeApp.Helpers.LangHelper.IsEnglish(Context);
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    var accountDisplayName = User.Identity?.Name ?? Html.Text("header.acct.fallbackName");
    var accountInitial = string.IsNullOrWhiteSpace(accountDisplayName)
        ? "U"
        : accountDisplayName.Trim().Substring(0, 1).ToUpperInvariant();
}
<header class="auth-topbar user-portal">
    <div class="auth-topbar-inner">
        <a class="auth-topbar-brand" href="/Dashboard">
            <img src="/image/logo-casta.webp" alt="@shortName" onerror="this.src='/image/logo.png'">
        </a>

        <form class="auth-topbar-search" action="@TechExchangeApp.Helpers.LangHelper.SearchUrl(Context)" method="get" role="search">
            <i class="fas fa-search"></i>
            <input type="search" name="q" placeholder="@Html.Text("topbar.searchPh")" aria-label="@Html.Text("common.search")" autocomplete="off">
        </form>

        <div class="auth-topbar-actions">
            <a class="auth-topbar-icon-btn" href="/chat" aria-label="@Html.Text("sidebar.messages")" title="@Html.Text("sidebar.messages")">
                <i class="fas fa-comments"></i>
            </a>

            <div class="dropdown">
                <button type="button"
                        class="auth-topbar-icon-btn"
                        data-bs-toggle="dropdown"
                        data-bs-auto-close="outside"
                        aria-expanded="false"
                        aria-label="@Html.Text("header.notify.title")">
                    <i class="fas fa-bell"></i>
                    <span id="tpBadge" class="badge bg-danger tp-badge d-none">0</span>
                </button>
                <div class="dropdown-menu dropdown-menu-end tp-dropdown">
                    <div class="tp-header d-flex justify-content-between align-items-center px-3 py-2">
                        <strong>@Html.Text("header.notify.title")</strong>
                        <button type="button" class="btn btn-sm btn-link text-decoration-none" onclick="tpMarkAllRead()">@Html.Text("header.notify.markAllRead")</button>
                    </div>
                    <div id="tpList" class="tp-list">
                        <div class="tp-empty text-center text-muted py-3 small">@Html.Text("header.notify.empty")</div>
                    </div>
                    <a class="tp-footer d-block text-center py-2 text-decoration-none" href="/Notifications">@Html.Text("common.viewAll")</a>
                </div>
            </div>

            <div class="auth-topbar-lang">
                <a class="@(!isEn ? "is-active" : "")" href="/Language/SetLanguage?lang=vi&returnUrl=@Uri.EscapeDataString(currentUrl)">VI</a>
                <span>/</span>
                <a class="@(isEn ? "is-active" : "")" href="/Language/SetLanguage?lang=en&returnUrl=@Uri.EscapeDataString(currentUrl)">EN</a>
            </div>

            <div class="dropdown">
                <button type="button"
                        class="auth-topbar-account"
                        data-bs-toggle="dropdown"
                        data-bs-auto-close="outside"
                        aria-expanded="false"
                        aria-label="@Html.Text("header.acct.menuAria")">
                    <span class="auth-topbar-avatar">@accountInitial</span>
                    <span class="auth-topbar-account-name d-none d-lg-inline">@accountDisplayName</span>
                    <i class="fas fa-chevron-down"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end">
                    @if (canAccessCms)
                    {
                        <a class="dropdown-item" href="/cms"><i class="fas fa-cog fa-fw"></i> CMS Admin</a>
                        <div class="dropdown-divider"></div>
                    }
                    <a class="dropdown-item" href="@TechExchangeApp.Helpers.LangHelper.HomeUrl(Context)"><i class="fas fa-globe fa-fw"></i> @Html.Text("topbar.backToSite")</a>
                    <a class="dropdown-item" href="/Account/Profile"><i class="fas fa-user fa-fw"></i> @Html.Text("profile.title")</a>
                    <a class="dropdown-item" href="/Account/ChangePassword"><i class="fas fa-key fa-fw"></i> @Html.Text("profile.securityLink")</a>
                    <div class="dropdown-divider"></div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="dropdown-item text-danger"><i class="fas fa-sign-out-alt fa-fw"></i> @Html.Text("sidebar.logout")</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</header>
