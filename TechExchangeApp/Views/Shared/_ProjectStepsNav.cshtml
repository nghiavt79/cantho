@model List<TechExchangeApp.ViewModel.ProjectStepNavVm>

@{
    const string mergedStepName = "Đàm phán thương mại / Kiểm tra pháp lý hợp đồng";
    var sourceSteps = Model.Where(s => s.IsVisible).ToList();
    var visibleSteps = sourceSteps.Where(s => s.StepNumber != 6).ToList();
    var totalVisible = visibleSteps.Count;
    bool IsDisplayStepCompleted(TechExchangeApp.ViewModel.ProjectStepNavVm step)
    {
        if (step.IsNotApplicable) return true;
        if (step.StepNumber != 5) return step.StatusId > 0;

        var legalReviewStep = sourceSteps.FirstOrDefault(s => s.StepNumber == 6);
        return step.StatusId > 0 && (legalReviewStep == null || legalReviewStep.StatusId > 0);
    }
    var completedCount = visibleSteps.Count(IsDisplayStepCompleted);
    var progressPercent = totalVisible > 0 ? (int)Math.Round((completedCount / (double)totalVisible) * 100) : 0;
    var isComplete = totalVisible > 0 && completedCount == totalVisible;
}

<div class="project-steps-nav tx-workflow-card mb-4">
    <div class="card">
        <div class="card-body">

            <!-- Header summary -->
            <div class="tx-workflow-header">
                <div class="tx-workflow-heading">
                    <h3 class="tx-workflow-title">Tiến trình giao dịch</h3>
                    <p class="tx-workflow-subtitle">Theo dõi toàn bộ quy trình chuyển giao công nghệ</p>
                </div>
                <div class="tx-workflow-summary">
                    <span class="tx-workflow-chip">
                        <i class="fas fa-list-check" aria-hidden="true"></i>@completedCount/@totalVisible bước
                    </span>
                    <span class="tx-workflow-chip tx-workflow-chip-percent">@progressPercent%</span>
                </div>
            </div>

            <!-- Connected stepper -->
            <ul class="nav tx-workflow-stepper">
                @for (var i = 0; i < visibleSteps.Count; i++)
                {
                    var step = visibleSteps[i];
                    var relatedLegalStep = step.StepNumber == 5 ? sourceSteps.FirstOrDefault(s => s.StepNumber == 6) : null;
                    var targetStep = step.StepNumber == 5 && relatedLegalStep != null && step.StatusId > 0 && relatedLegalStep.IsAccessible
                        ? relatedLegalStep
                        : step;
                    var displayStepNumber = i + 1;
                    var displayStepName = step.StepNumber == 5 ? mergedStepName : step.StepName;
                    var displayCurrent = step.IsCurrent || (relatedLegalStep?.IsCurrent == true);
                    var displayCompleted = IsDisplayStepCompleted(step);
                    var displayAccessible = step.IsAccessible || (relatedLegalStep?.IsAccessible == true);
                    var stepClass = step.IsNotApplicable ? "not-applicable" : (displayCompleted ? "completed" : (displayCurrent ? "current" : "pending"));
                    var badgeClass = step.IsNotApplicable ? "bg-light text-muted" : (displayCompleted ? "bg-success" : (displayCurrent ? "bg-primary" : "bg-light text-muted"));
                    var connectorFilled = i > 0 && IsDisplayStepCompleted(visibleSteps[i - 1]);

                    <li class="nav-item step-item tx-workflow-step @stepClass @(connectorFilled ? "tx-connector-filled" : "")">
                        @if (step.IsNotApplicable)
                        {
                            <span class="nav-link disabled tx-workflow-node-link not-applicable" aria-disabled="true"
                                  title="Sản phẩm không yêu cầu thỏa thuận bảo mật">
                                <span class="step-circle tx-workflow-node @badgeClass"><i class="fas fa-minus" aria-hidden="true"></i></span>
                                <span class="step-name tx-workflow-label">@displayStepName <small class="text-muted d-block">(Không áp dụng)</small></span>
                            </span>
                        }
                        else if (displayAccessible)
                        {
                            <a class="nav-link step-link tx-workflow-node-link @stepClass" href="#" data-step="@targetStep.StepNumber"
                               aria-current="@(displayCurrent ? "step" : null)">
                                <span class="step-circle tx-workflow-node @badgeClass">
                                    @if (displayCompleted)
                                    {
                                        <i class="fas fa-check" aria-hidden="true"></i>
                                    }
                                    else
                                    {
                                        <span>@displayStepNumber.ToString("D2")</span>
                                    }
                                </span>
                                <span class="step-name tx-workflow-label">@displayStepName</span>
                            </a>
                        }
                        else
                        {
                            <span class="nav-link disabled tx-workflow-node-link @stepClass" aria-disabled="true">
                                <span class="step-circle tx-workflow-node @badgeClass">@displayStepNumber.ToString("D2")</span>
                                <span class="step-name tx-workflow-label">@displayStepName</span>
                            </span>
                        }
                    </li>
                }
            </ul>

            <!-- Overall progress -->
            <div class="tx-workflow-progress-wrap">
                <div class="tx-workflow-progress-label">
                    <span>Tiến độ tổng thể</span>
                    <span class="tx-workflow-progress-value">@progressPercent%</span>
                </div>
                <div class="progress tx-workflow-progress" role="progressbar"
                     aria-label="Tiến độ tổng thể dự án" aria-valuenow="@progressPercent" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar @(isComplete ? "bg-success" : "bg-primary")" style="width: @progressPercent%"></div>
                </div>
            </div>

            @if (isComplete)
            {
                <div class="tx-workflow-complete">
                    <i class="fas fa-circle-check" aria-hidden="true"></i>
                    <div>
                        <div class="tx-workflow-complete-title">Quy trình giao dịch đã hoàn tất</div>
                        <div class="tx-workflow-complete-text">Toàn bộ @totalVisible bước đã được xử lý thành công.</div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>
