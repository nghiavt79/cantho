@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject TechExchangeApp.Interfaces.ICmsAccessService CmsAccessService
@{
    var mainDomain = Configuration["AppSettings:MainDomain"] ?? "/";
    var shortName = Configuration["SiteBranding:ShortName"] ?? "CASTA";
    var canAccessCms = await CmsAccessService.CanAccessCmsAsync(ViewContext.HttpContext.User);
    var isEn = TechExchangeApp.Helpers.LangHelper.IsEnglish(Context);
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    var accountDisplayName = User.Identity?.Name ?? Html.Text("header.acct.fallbackName");
    var accountInitial = string.IsNullOrWhiteSpace(accountDisplayName)
        ? "U"
        : accountDisplayName.Trim().Substring(0, 1).ToUpperInvariant();
}

<header class="site-header-v2">
    <nav class="site-header-v2__nav">
        <div class="container site-header-v2__nav-inner">
            <a class="site-header-v2__brand" href="@TechExchangeApp.Helpers.LangHelper.HomeUrl(Context)">
                <img src="/image/logo-casta.webp" alt="@shortName" onerror="this.src='/image/logo.png'">
            </a>

            <div class="site-header-v2__actions">
                <nav class="site-header-v2__menu" aria-label="@Html.Text("header.mainMenuAria")">
                    @* Menu chính data-driven từ bảng Menu (MenuPosition="1"), song ngữ theo /en. *@
                    @await Component.InvokeAsync("SiteHeaderMenu", new { variant = "desktop" })
                    <form class="site-header-v2__quick-search" action="@TechExchangeApp.Helpers.LangHelper.SearchUrl(Context)" method="get" role="search">
                        <input type="search" name="q" placeholder="@Html.Text("header.search.ph1")" aria-label="@Html.Text("common.search")" autocomplete="off">
                        <button type="submit" class="site-header-v2__quick-search-btn" aria-label="@Html.Text("common.search")">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="site-header-v2__account-actions">
                            <div class="dropdown site-header-v2__account">
                                <button type="button"
                                        class="nav-link site-header-v2__login-link site-header-v2__account-toggle"
                                        data-bs-toggle="dropdown"
                                        data-bs-auto-close="outside"
                                        aria-expanded="false"
                                        aria-label="@Html.Text("header.acct.menuAria")">
                                    <span class="site-header-v2__account-avatar">@accountInitial</span>
                                    <i class="bi bi-chevron-down site-header-v2__account-chevron"></i>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end site-header-v2__account-menu">
                                    @if (canAccessCms)
                                    {
                                        <a class="dropdown-item site-header-v2__account-admin" href="/cms"><i class="bi bi-gear-wide-connected"></i> CMS Admin</a>
                                    }
                                    <a class="dropdown-item" href="/Dashboard"><i class="bi bi-speedometer2"></i> @Html.Text("header.acct.dashboard")</a>
                                    <a class="dropdown-item" href="/Projects/MyProjects"><i class="bi bi-folder2-open"></i> @Html.Text("header.acct.myProjects")</a>
                                    <a class="dropdown-item" href="/Chat"><i class="bi bi-chat-dots"></i> @Html.Text("sidebar.messages")</a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item" href="/Account/Profile"><i class="bi bi-person"></i> @Html.Text("header.acct.profile")</a>
                                    <a class="dropdown-item" href="/Account/ChangePassword"><i class="bi bi-key"></i> @Html.Text("changepwd.cardTitle")</a>
                                    <div class="dropdown-divider"></div>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item site-header-v2__account-logout">
                                            <i class="bi bi-box-arrow-right"></i> @Html.Text("sidebar.logout")
                                        </button>
                                    </form>
                                </div>
                            </div>

                            <div class="dropdown site-header-v2__notify">
                                <button type="button"
                                        class="site-header-v2__notify-btn"
                                        data-bs-toggle="dropdown"
                                        data-bs-auto-close="outside"
                                        aria-expanded="false"
                                        aria-label="@Html.Text("header.notify.title")">
                                    <i class="bi bi-bell"></i>
                                    <span id="tpBadge" class="badge bg-danger tp-badge d-none">0</span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end tp-dropdown">
                                    <div class="tp-header d-flex justify-content-between align-items-center px-3 py-2">
                                        <strong>@Html.Text("header.notify.title")</strong>
                                        <button type="button" class="btn btn-sm btn-link text-decoration-none" onclick="tpMarkAllRead()">@Html.Text("header.notify.markAllRead")</button>
                                    </div>
                                    <div id="tpList" class="tp-list">
                                        <div class="tp-empty text-center text-muted py-3 small">@Html.Text("header.notify.empty")</div>
                                    </div>
                                    <a class="tp-footer d-block text-center py-2 text-decoration-none" href="/Notifications">@Html.Text("common.viewAll")</a>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="nav-link site-header-v2__login-link site-header-v2__icon-link" data-bs-toggle="modal" data-bs-target="#loginModal" aria-label="@Html.Text("common.login")">
                            <i class="bi bi-person-circle"></i>
                        </button>
                    }
                    <div class="site-header-v2__lang">
                        <a class="@(!isEn ? "is-active" : "")" href="/">VI</a>
                        <span>/</span>
                        <a class="@(isEn ? "is-active" : "")" href="/en">EN</a>
                    </div>
                </nav>
                <button class="site-header-v2__menu-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#siteMenuOffcanvas" aria-controls="siteMenuOffcanvas" aria-label="@Html.Text("header.openMenuAria")">
                    <i class="bi bi-list"></i>
                </button>
            </div>
        </div>
    </nav>

    <div class="offcanvas offcanvas-end site-menu-offcanvas" tabindex="-1" id="siteMenuOffcanvas" aria-labelledby="siteMenuOffcanvasLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="siteMenuOffcanvasLabel">@shortName</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="@Html.Text("common.close")"></button>
        </div>
        <div class="offcanvas-body">
            <div class="site-header-v2__lang site-header-v2__lang--offcanvas">
                <a class="@(!isEn ? "is-active" : "")" href="/">VI</a>
                <span>/</span>
                <a class="@(isEn ? "is-active" : "")" href="/en">EN</a>
            </div>
            <form class="site-menu-offcanvas__search" action="@TechExchangeApp.Helpers.LangHelper.SearchUrl(Context)" method="get">
                <i class="bi bi-search"></i>
                <input type="search" name="q" placeholder="@Html.Text("header.search.ph2")" aria-label="@Html.Text("common.search")">
            </form>

            <nav class="site-menu-offcanvas__nav">
                <a href="@TechExchangeApp.Helpers.LangHelper.HomeUrl(Context)">@Html.Text("common.home")</a>
                @* Menu chính data-driven từ bảng Menu (MenuPosition="1"), song ngữ theo /en. *@
                @await Component.InvokeAsync("SiteHeaderMenu", new { variant = "mobile" })
                <a href="/Search">@Html.Text("common.search")</a>
            </nav>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="site-menu-offcanvas__account">
                    <strong>@User.Identity.Name</strong>
                    @if (canAccessCms)
                    {
                        <a href="/cms"><i class="bi bi-gear-wide-connected"></i> CMS Admin</a>
                    }
                    <a href="/Dashboard"><i class="bi bi-speedometer2"></i> @Html.Text("header.acct.system")</a>
                    <a href="/Projects/MyProjects"><i class="bi bi-folder2-open"></i> @Html.Text("header.acct.myProjects")</a>
                    <a href="/Chat"><i class="bi bi-chat-dots"></i> @Html.Text("sidebar.messages")</a>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit"><i class="bi bi-box-arrow-right"></i> @Html.Text("sidebar.logout")</button>
                    </form>
                </div>
            }
            else
            {
                <button type="button" class="site-menu-offcanvas__login" data-modal-target="#loginModal">
                    <i class="bi bi-person-circle"></i> @Html.Text("common.login")
                </button>
                <button type="button" class="site-menu-offcanvas__login" data-modal-target="#registerModal">
                    <i class="bi bi-person-plus"></i> @Html.Text("common.signup")
                </button>
            }
        </div>
    </div>
</header>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.site-header-v2__quick-search').forEach(function (form) {
            const input = form.querySelector('input[type="search"]');
            const button = form.querySelector('button[type="submit"]');

            button.addEventListener('click', function (event) {
                if (!form.classList.contains('is-open')) {
                    event.preventDefault();
                    form.classList.add('is-open');
                    window.setTimeout(function () { input.focus(); }, 120);
                    return;
                }

                if (!input.value.trim()) {
                    event.preventDefault();
                    input.focus();
                }
            });

            document.addEventListener('click', function (event) {
                if (!form.contains(event.target) && !input.value.trim()) {
                    form.classList.remove('is-open');
                }
            });
        });

        // Accordion menu mobile: xổ/thu danh mục Sản phẩm/Dịch vụ
        document.querySelectorAll('[data-menu-toggle]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var sub = document.getElementById(btn.getAttribute('aria-controls'));
                if (!sub) return;
                var expanded = btn.getAttribute('aria-expanded') === 'true';
                btn.setAttribute('aria-expanded', String(!expanded));
                sub.hidden = expanded;
            });
        });

        // Menu mobile (offcanvas): đóng menu dứt điểm khi mở modal đăng nhập/đăng ký
        // hoặc khi bấm link điều hướng — tránh menu/backdrop kẹt lại phải bấm X thủ công.
        var siteMenu = document.getElementById('siteMenuOffcanvas');
        if (siteMenu && window.bootstrap) {
            // Đóng offcanvas TRƯỚC, khi đóng xong mới mở modal (tránh xung đột backdrop)
            siteMenu.querySelectorAll('[data-modal-target]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var modalEl = document.querySelector(btn.getAttribute('data-modal-target'));
                    if (!modalEl) return;
                    var oc = bootstrap.Offcanvas.getOrCreateInstance(siteMenu);
                    siteMenu.addEventListener('hidden.bs.offcanvas', function handler() {
                        siteMenu.removeEventListener('hidden.bs.offcanvas', handler);
                        bootstrap.Modal.getOrCreateInstance(modalEl).show();
                    });
                    oc.hide();
                });
            });

            // Đóng menu khi bấm bất kỳ link điều hướng nào bên trong
            siteMenu.querySelectorAll('a[href]').forEach(function (link) {
                link.addEventListener('click', function () {
                    var oc = bootstrap.Offcanvas.getInstance(siteMenu);
                    if (oc) oc.hide();
                });
            });
        }
    });
</script>
