@model TechExchangeApp.Entities.ProposalSubmission

@{
    ViewData["Title"] = Html.Text("seller.vp.title");
    var isEn = TechExchangeApp.Helpers.LangHelper.IsEnglish(Context);
    var projectId = ViewBag.ProjectId;
    var projectName = ViewBag.ProjectName;
    var proposalStatus = ViewBag.ProposalStatus;
    var submittedDate = (DateTime?)ViewBag.SubmittedDate;
}

<div class="container mt-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="InvitedProjects">@Html.Text("seller.pd.breadcrumb")</a></li>
            <li class="breadcrumb-item"><a asp-action="ProjectDetails" asp-route-id="@projectId">@projectName</a></li>
            <li class="breadcrumb-item active">@Html.Text("seller.vp.title")</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">
                <i class="fas fa-file-invoice"></i> @Html.Text("seller.vp.title")
            </h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>@Html.Text("seller.vp.project")</strong> @projectName</p>
                    <p><strong>@Html.Text("seller.vp.status")</strong> <span class="badge bg-info">@proposalStatus</span></p>
                </div>
                <div class="col-md-6">
                    <p><strong>@Html.Text("seller.vp.submittedDate")</strong> @submittedDate?.ToString(isEn ? "MM/dd/yyyy HH:mm" : "dd/MM/yyyy HH:mm")</p>
                    <p><strong>@Html.Text("seller.vp.quoteCode")</strong> <code>#@Model.Id</code></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Proposal Details -->
    <div class="row">
        <!-- Technical Solution -->
        <div class="col-md-12 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-file-pdf"></i> @Html.Text("seller.pd.techSolution")</h5>
                </div>
                <div class="card-body">
                    <p><strong>File:</strong></p>
                    <a href="@Model.GiaiPhapKyThuat" class="btn btn-outline-primary" target="_blank">
                        <i class="fas fa-download"></i> @Html.Text("seller.vp.downloadTech")
                    </a>
                </div>
            </div>
        </div>

        <!-- Pricing & Timeline -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-dollar-sign"></i> @Html.Text("seller.vp.quote")</h5>
                </div>
                <div class="card-body">
                    @if (Model.BaoGiaSoBo.HasValue)
                    {
                        <h3 class="text-success">@Model.BaoGiaSoBo.Value.ToString("#,0", new System.Globalization.CultureInfo(isEn ? "en-US" : "vi-VN")) @(isEn ? "VND" : "VNĐ")</h3>
                    }
                    else
                    {
                        <p class="text-muted">@Html.Text("seller.vp.noQuote")</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="fas fa-clock"></i> @Html.Text("seller.pd.implTime")</h5>
                </div>
                <div class="card-body">
                    <h4>@Model.ThoiGianTrienKhai</h4>
                </div>
            </div>
        </div>

        <!-- Capability Profile -->
        <div class="col-md-12 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-file-pdf"></i> @Html.Text("seller.pd.capability")</h5>
                </div>
                <div class="card-body">
                    <p><strong>File:</strong></p>
                    <a href="@Model.HoSoNangLucDinhKem" class="btn btn-outline-info" target="_blank">
                        <i class="fas fa-download"></i> @Html.Text("seller.vp.downloadCapability")
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex gap-2 mb-4">
        <a asp-action="ProjectDetails" asp-route-id="@projectId" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> @Html.Text("seller.vp.backToProject")
        </a>
        

    </div>

    <!-- Edit Proposal Modal (Optional - for future enhancement) -->
    <div class="modal fade" id="editProposalModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Html.Text("seller.vp.editTitle")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>@Html.Text("seller.vp.editComingSoon")</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.Text("common.close")</button>
                </div>
            </div>
        </div>
    </div>
</div>
