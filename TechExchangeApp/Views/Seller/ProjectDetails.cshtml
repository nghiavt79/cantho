@model TechExchangeApp.Entities.Project

@{
    ViewData["Title"] = Html.Text("seller.pd.title");
    var isEn = TechExchangeApp.Helpers.LangHelper.IsEnglish(Context);
    var projectId = ViewBag.ProjectId;
    var projectName = ViewBag.ProjectName;
    var invitationStatus = (int)ViewBag.InvitationStatus;
    var invitationStatusName = ViewBag.InvitationStatusName;
    var ndaSigned = (bool)ViewBag.NdaSigned;
    var hasProposal = (bool)ViewBag.HasProposal;
    var proposalStatus = ViewBag.ProposalStatus;
    var rfqDeadline = ViewBag.RfqDeadline;
    var rfqDescription = ViewBag.RfqDescription;
}

<div class="container mt-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="InvitedProjects">@Html.Text("seller.pd.breadcrumb")</a></li>
            <li class="breadcrumb-item active">@projectName</li>
        </ol>
    </nav>

    <!-- Project Header -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">
                <i class="fas fa-project-diagram"></i> @projectName
            </h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>@Html.Text("dash.col.code"):</strong> @Model.ProjectCode</p>
                    <p><strong>@Html.Text("seller.pd.description")</strong> @Model.Description</p>
                </div>
                <div class="col-md-6">
                    <p><strong>@Html.Text("seller.pd.deadline")</strong>
                        <span class="badge bg-warning">@rfqDeadline?.ToString(isEn ? "MM/dd/yyyy HH:mm" : "dd/MM/yyyy HH:mm")</span>
                    </p>
                    <p><strong>@Html.Text("seller.pd.invStatus")</strong>
                        <span class="badge @GetStatusBadgeClass(invitationStatus)">@invitationStatusName</span>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Workflow Status -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="fas fa-tasks"></i> @Html.Text("seller.pd.process")</h5>
        </div>
        <div class="card-body">
            <div class="row text-center">
                <!-- Step 1: NDA -->
                <div class="col-md-3">
                    <div class="workflow-step @(ndaSigned ? "completed" : "")">
                        <div class="step-icon">
                            <i class="fas fa-file-signature fa-2x"></i>
                        </div>
                        <h6>@Html.Text("seller.inv.signNda")</h6>
                        @if (ndaSigned)
                        {
                            <span class="badge bg-success">✓ @Html.Text("seller.pd.signed")</span>
                        }
                        else
                        {
                            <a asp-controller="Project" asp-action="SignNda" asp-route-projectId="@projectId"
                               class="btn btn-sm btn-primary">@Html.Text("seller.pd.signNow")</a>
                        }
                    </div>
                </div>

                <!-- Step 2: Accept -->
                <div class="col-md-3">
                    <div class="workflow-step @(invitationStatus >= 2 ? "completed" : "")">
                        <div class="step-icon">
                            <i class="fas fa-check-circle fa-2x"></i>
                        </div>
                        <h6>@Html.Text("seller.pd.acceptStep")</h6>
                        @if (invitationStatus >= 2)
                        {
                            <span class="badge bg-success">✓ @Html.Text("seller.pd.accepted")</span>
                        }
                        else if (ndaSigned && invitationStatus < 2)
                        {
                            <form asp-action="AcceptInvitation" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@projectId" />
                                <button type="submit" class="btn btn-sm btn-success">@Html.Text("seller.pd.accept")</button>
                            </form>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Html.Text("seller.pd.waitNda")</span>
                        }
                    </div>
                </div>

                <!-- Step 3: Submit Proposal -->
                <div class="col-md-3">
                    <div class="workflow-step @(hasProposal ? "completed" : "")">
                        <div class="step-icon">
                            <i class="fas fa-file-invoice fa-2x"></i>
                        </div>
                        <h6>@Html.Text("seller.inv.sendQuote")</h6>
                        @if (hasProposal)
                        {
                            <span class="badge bg-success">✓ @Html.Text("seller.pd.sent")</span>
                        }
                        else if (invitationStatus == 2)
                        {
                            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#submitProposalModal">
                                @Html.Text("seller.inv.sendQuote")
                            </button>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Html.Text("seller.pd.waitAccept")</span>
                        }
                    </div>
                </div>

                <!-- Step 4: Selection -->
                <div class="col-md-3">
                    <div class="workflow-step @(proposalStatus == 2 ? "completed" : "")">
                        <div class="step-icon">
                            <i class="fas fa-trophy fa-2x"></i>
                        </div>
                        <h6>@Html.Text("seller.pd.selectedStep")</h6>
                        @if (proposalStatus == 2)
                        {
                            <span class="badge bg-success">✓ @Html.Text("seller.pd.selected")</span>
                        }
                        else if (proposalStatus == 3)
                        {
                            <span class="badge bg-danger">✗ @Html.Text("seller.pd.notSelected")</span>
                        }
                        else if (hasProposal)
                        {
                            <span class="badge bg-warning">⏳ @Html.Text("seller.pd.waitBuyer")</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Html.Text("seller.pd.waitQuote")</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- RFQ Details -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0"><i class="fas fa-clipboard-list"></i> @Html.Text("seller.pd.rfq")</h5>
        </div>
        <div class="card-body">
            <p><strong>@Html.Text("seller.pd.rfqDesc")</strong></p>
            <div class="border rounded p-3 bg-light">
                @Html.Raw(rfqDescription?.Replace("\n", "<br>"))
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex gap-2 mb-4">
        <a asp-action="InvitedProjects" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> @Html.Text("common.back")
        </a>
        
        @if (hasProposal)
        {
            <a asp-controller="Seller" asp-action="ViewMyProposal" asp-route-projectId="@projectId" 
               class="btn btn-info">
                <i class="fas fa-eye"></i> @Html.Text("seller.pd.viewMyQuote")
            </a>
        }
    </div>

    <!-- Submit Proposal Modal -->
    <div class="modal fade" id="submitProposalModal" tabindex="-1" aria-labelledby="submitProposalModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form asp-controller="Seller" asp-action="SubmitProposal" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="projectId" value="@projectId" />
                    
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title" id="submitProposalModalLabel">
                            <i class="fas fa-file-invoice"></i> @Html.Text("seller.pd.quoteModalTitle")
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    
                    <div class="modal-body">
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> 
                            @Html.Text("seller.pd.quoteModalHint")
                        </div>

                        <!-- Technical Solution File -->
                        <div class="mb-3">
                            <label for="technicalSolution" class="form-label">
                                <i class="fas fa-file-pdf text-danger"></i> 
                                @Html.Text("seller.pd.techSolution") <span class="text-danger">*</span>
                            </label>
                            <input type="file" class="form-control" id="technicalSolution" name="technicalSolution"
                                   accept=".pdf,.doc,.docx" required>
                            <small class="form-text text-muted">@Html.Text("seller.pd.fileFormat")</small>
                        </div>

                        <!-- Preliminary Price -->
                        <div class="mb-3">
                            <label for="preliminaryPriceDisplay" class="form-label">
                                <i class="fas fa-dollar-sign text-success"></i> 
                                @Html.Text("seller.pd.prelimQuote")
                            </label>
                            <input type="text" class="form-control" id="preliminaryPriceDisplay"
                                   placeholder="@Html.Text("seller.pd.amountPh")" autocomplete="off">
                            <input type="hidden" id="preliminaryPrice" name="preliminaryPrice" />
                            <small class="form-text text-muted">@Html.Text("seller.pd.amountHint")</small>
                        </div>

                        <!-- Implementation Time -->
                        <div class="mb-3">
                            <label for="implementationTime" class="form-label">
                                <i class="fas fa-clock text-warning"></i> 
                                @Html.Text("seller.pd.implTime") <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="implementationTime" name="implementationTime"
                                   placeholder="@Html.Text("seller.pd.implTimePh")" required>
                            <small class="form-text text-muted">@Html.Text("seller.pd.implTimeHint")</small>
                        </div>

                        <!-- Capability Profile File -->
                        <div class="mb-3">
                            <label for="capabilityProfile" class="form-label">
                                <i class="fas fa-file-pdf text-danger"></i> 
                                @Html.Text("seller.pd.capability") <span class="text-danger">*</span>
                            </label>
                            <input type="file" class="form-control" id="capabilityProfile" name="capabilityProfile"
                                   accept=".pdf,.doc,.docx" required>
                            <small class="form-text text-muted">@Html.Text("seller.pd.fileFormat")</small>
                        </div>
                    </div>
                    
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fas fa-times"></i> @Html.Text("common.cancel")
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-paper-plane"></i> @Html.Text("seller.inv.sendQuote")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .workflow-step {
            padding: 20px;
            border: 2px solid #dee2e6;
            border-radius: 8px;
            margin: 10px;
            transition: all 0.3s;
        }

        .workflow-step.completed {
            border-color: #28a745;
            background-color: #f8fff9;
        }

        .workflow-step .step-icon {
            margin-bottom: 10px;
            color: #6c757d;
        }

        .workflow-step.completed .step-icon {
            color: #28a745;
        }

        .workflow-step h6 {
            font-weight: bold;
            margin-bottom: 10px;
        }
    </style>
    <script>
        $(document).ready(function () {
            // Format number with dots (VND style: 1.000.000)
            function formatVND(num) {
                return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
            }

            $('#preliminaryPriceDisplay').on('input', function () {
                var raw = $(this).val().replace(/\./g, '').replace(/[^\d]/g, '');
                if (raw) {
                    $(this).val(formatVND(raw));
                    $('#preliminaryPrice').val(raw);
                } else {
                    $(this).val('');
                    $('#preliminaryPrice').val('');
                }
            });
        });
    </script>
}

@functions {
    string GetStatusBadgeClass(int status)
    {
        return status switch
        {
            0 => "bg-secondary",
            1 => "bg-info",
            2 => "bg-success",
            3 => "bg-primary",
            4 => "bg-danger",
            5 => "bg-warning",
            _ => "bg-secondary"
        };
    }
}
