@using TechExchangeApp.Interfaces
@using Microsoft.AspNetCore.Identity
@using TechExchangeApp.Entities
@inject IAccountService AccountService
@inject UserManager<ApplicationUser> UserManager

@model TechExchangeApp.Interfaces.ChatConversationDetailVm
@{
    ViewData["Title"] = Html.Text("chat.conversationTitle") + " — " + Model.ProductName;
    ViewData["AuthWorkspace"] = true;
    var isEn = TechExchangeApp.Helpers.LangHelper.IsEnglish(Context);
    var userId = int.Parse(UserManager.GetUserId(User)!);
    var sidebarData = await AccountService.GetSidebarDataAsync(userId);
}

<div class="container-fluid py-4 user-portal">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-3 col-lg-2">
            @await Html.PartialAsync("_AccountSidebar", sidebarData)
        </div>

        <!-- Main Content -->
        <div class="col-md-9 col-lg-10 user-portal-main">
            <div class="chat-conversation">

                @* Header *@
                <div class="d-flex align-items-center mb-3 gap-2 chat-conversation-header">
                    <a href="/chat" class="btn btn-outline-secondary btn-sm">
                        <i class="fa fa-arrow-left"></i> @Html.Text("common.back")
                    </a>
                    <h4 class="mb-0 fw-bold">
                        <i class="fa fa-comments text-primary me-1"></i>
                        @Model.OtherUserName
                    </h4>
                    @if (Model.ConversationType == 2)
                    {
                        <span class="badge bg-primary ms-2">
                            <i class="fa fa-headset me-1"></i>@Html.Text("chat.supportBadge")
                        </span>
                        @if (!string.IsNullOrEmpty(Model.ProjectName))
                        {
                            <span class="badge bg-info text-dark ms-1">
                                <i class="fa fa-project-diagram me-1"></i>@Model.ProjectName@(Model.StepNumber.HasValue ? $" — {Html.Text("dash.stepPrefix")} {Model.StepNumber}" : "")
                            </span>
                        }
                    }
                    else if (!string.IsNullOrEmpty(Model.ProductName))
                    {
                        <span class="badge bg-info text-dark ms-2">
                            <i class="fa fa-cube me-1"></i>@Model.ProductName
                        </span>
                    }
                    @* Gọi video (HSMT C.7): tạo phòng họp và gửi lời mời vào hội thoại *@
                    <button type="button" class="btn btn-success btn-sm ms-auto" id="btnVideoCall" title="@Html.Text("chat.video.button")">
                        <i class="fa fa-video me-1"></i>@Html.Text("chat.video.button")
                    </button>
                </div>

                @* Messages *@
                <div id="chatMessages"
                     class="card border-0 shadow-sm p-3 mb-3 chat-conversation-messages">

                    @foreach (var m in Model.Messages)
                    {
                        <div class="d-flex mb-2 @(m.IsMe ? "justify-content-end" : "justify-content-start")">
                            <div class="@(m.IsMe ? "bg-primary text-white chat-bubble chat-bubble-out" : "bg-white border chat-bubble chat-bubble-in") rounded px-3 py-2"
                                 style="max-width:70%; word-wrap:break-word;">
                                @if (!m.IsMe)
                                {
                                    <div class="fw-bold small text-secondary mb-1">@m.SenderName</div>
                                }
                                @if (m.IsSystem)
                                {
                                    <em>@Html.SafeHtml(m.Message)</em>
                                }
                                else
                                {
                                    <span style="white-space:pre-wrap;">@m.Message</span>
                                }
                                @if (m.HasAttachment)
                                {
                                    <div class="mt-1">
                                        @if (m.IsImage)
                                        {
                                            <a href="@m.AttachmentUrl" target="_blank"><img src="@m.AttachmentUrl" alt="@m.AttachmentName" style="max-width:220px;max-height:180px;border-radius:6px;" /></a>
                                        }
                                        else
                                        {
                                            <a href="@m.AttachmentUrl" class="@(m.IsMe ? "text-white" : "")"><i class="fa fa-paperclip"></i> @m.AttachmentName</a>
                                        }
                                    </div>
                                }
                                <div class="text-end mt-1" style="font-size:11px; opacity:0.7;">
                                    @m.Created.ToString(isEn ? "MM/dd HH:mm" : "dd/MM HH:mm")
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @* Send form *@
                <form id="chatSendForm" class="d-flex gap-2 chat-conversation-composer">
                    <input type="file" id="chatFile" class="d-none" accept=".jpg,.jpeg,.png,.gif,.webp,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx" />
                    <button type="button" id="btnAttach" class="btn btn-outline-secondary" title="Gửi hình ảnh, tệp (tối đa 10 MB)">
                        <i class="fa fa-paperclip"></i>
                    </button>
                    <input type="text" id="chatInput"
                           class="form-control"
                           placeholder="@Html.Text("chat.inputPh")"
                           autocomplete="off"
                           maxlength="2000" />
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fa fa-paper-plane"></i> @Html.Text("common.send")
                    </button>
                </form>

            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/user-portal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        (function () {
            const CHAT_MSG = {
                sendFailed: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Html.Text("chat.js.sendFailed"))),
                connectionError: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Html.Text("chat.js.connectionError")))
            };

            const conversationId = @Model.ConversationId;
            const form = document.getElementById('chatSendForm');
            const input = document.getElementById('chatInput');
            const messagesDiv = document.getElementById('chatMessages');

            // Track highest message ID for polling
            let lastMessageId = @(Model.Messages.Any() ? Model.Messages.Max(m => m.Id) : 0);

            // Scroll to bottom on load
            messagesDiv.scrollTop = messagesDiv.scrollHeight;

            // ── Send message ──────────────────────────────────
            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                const msg = input.value.trim();
                if (!msg) return;

                input.disabled = true;

                try {
                    const res = await fetch(`/api/chat/${conversationId}/send`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ message: msg })
                    });
                    const data = await res.json();

                    if (data.success) {
                        input.value = '';
                        await pollNewMessages();
                    } else {
                        alert(data.error || CHAT_MSG.sendFailed);
                    }
                } catch {
                    alert(CHAT_MSG.connectionError);
                }

                input.disabled = false;
                input.focus();
            });

            // ── Gửi tệp đính kèm ──────────────────────────────
            const fileInput = document.getElementById('chatFile');
            document.getElementById('btnAttach')?.addEventListener('click', () => fileInput.click());
            fileInput?.addEventListener('change', async function () {
                const f = fileInput.files[0];
                if (!f) return;
                if (f.size > 10 * 1024 * 1024) { alert('Tệp vượt quá 10 MB.'); fileInput.value = ''; return; }
                const token = document.querySelector('meta[name="__RequestVerificationToken"]')?.content || '';
                const fd = new FormData();
                fd.append('file', f);
                if (input.value.trim()) fd.append('message', input.value.trim());
                try {
                    const res = await fetch(`/api/chat/${conversationId}/upload`, { method: 'POST', headers: { 'RequestVerificationToken': token }, body: fd });
                    const data = await res.json().catch(() => ({}));
                    if (data.success) { input.value = ''; await pollNewMessages(); }
                    else alert(data.error || CHAT_MSG.sendFailed);
                } catch { alert(CHAT_MSG.connectionError); }
                fileInput.value = '';
            });

            // ── Gọi video ─────────────────────────────────────
            document.getElementById('btnVideoCall')?.addEventListener('click', async function () {
                if (!confirm(@Json.Serialize(Html.Text("chat.video.confirm")))) return;
                const token = document.querySelector('meta[name="__RequestVerificationToken"]')?.content || '';
                const win = window.open('', '_blank');
                try {
                    const res = await fetch(`/api/chat/${conversationId}/video-call`, { method: 'POST', headers: { 'RequestVerificationToken': token } });
                    const data = await res.json();
                    if (data.success) {
                        if (win) { win.opener = null; win.location = data.url; } else { location.href = data.url; }
                        await pollNewMessages();
                    } else { win?.close(); alert(CHAT_MSG.sendFailed); }
                } catch { win?.close(); alert(CHAT_MSG.connectionError); }
            });

            // ── Auto-poll every 5 seconds ─────────────────────
            async function pollNewMessages() {
                try {
                    const res = await fetch(`/api/chat/${conversationId}/messages?afterId=${lastMessageId}`);
                    if (!res.ok) return;
                    const data = await res.json();

                    if (data.messages && data.messages.length > 0) {
                        data.messages.forEach(m => {
                            appendMessage(m);
                            if (m.id > lastMessageId) lastMessageId = m.id;
                        });
                        messagesDiv.scrollTop = messagesDiv.scrollHeight;
                    }
                } catch { /* silent */ }
            }

            function appendMessage(m) {
                const bubble = document.createElement('div');
                bubble.className = 'd-flex mb-2 ' + (m.isMe ? 'justify-content-end' : 'justify-content-start');

                const bgClass = m.isMe ? 'bg-primary text-white chat-bubble chat-bubble-out' : 'bg-white border chat-bubble chat-bubble-in';
                const senderHtml = !m.isMe ? `<div class="fw-bold small text-secondary mb-1">${escapeHtml(m.senderName)}</div>` : '';
                let msgHtml = m.isSystem ? `<em>${m.message}</em>` : `<span style="white-space:pre-wrap;">${escapeHtml(m.message)}</span>`;
                if (m.attachmentUrl) {
                    msgHtml += m.isImage
                        ? `<div class="mt-1"><a href="${m.attachmentUrl}" target="_blank"><img src="${m.attachmentUrl}" alt="" style="max-width:220px;max-height:180px;border-radius:6px;" /></a></div>`
                        : `<div class="mt-1"><a href="${m.attachmentUrl}" class="${m.isMe ? 'text-white' : ''}"><i class="fa fa-paperclip"></i> ${escapeHtml(m.attachmentName || '')}</a></div>`;
                }

                bubble.innerHTML = `
                    <div class="${bgClass} rounded px-3 py-2" style="max-width:70%; word-wrap:break-word;">
                        ${senderHtml}
                        ${msgHtml}
                        <div class="text-end mt-1" style="font-size:11px; opacity:0.7;">${escapeHtml(m.created)}</div>
                    </div>`;
                messagesDiv.appendChild(bubble);
            }

            function escapeHtml(text) {
                const d = document.createElement('div');
                d.textContent = text;
                return d.innerHTML;
            }

            // Poll every 5 seconds
            setInterval(pollNewMessages, 5000);
        })();
    </script>
}
