@model TechExchangeApp.ViewModel.ResetPasswordVm

@{
    var isEn = TechExchangeApp.Helpers.LangHelper.IsEnglish(Context);
    ViewData["Title"] = Html.Text("auth.reset.title");
    var loginUrl = isEn ? "/en/login" : "/dang-nhap";
    var forgotUrl = isEn ? "/en/forgot-password" : "/quen-mat-khau";
    var actionUrl = isEn ? "/en/reset-password" : "/dat-lai-mat-khau";
    var done = ViewBag.Done as bool? == true;
    var tokenValid = ViewBag.TokenValid as bool? == true;
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">@Html.Text("auth.reset.title")</h3>
                </div>
                <div class="card-body">
                    @if (done)
                    {
                        <div class="alert alert-success">@Html.Text("auth.reset.done")</div>
                        <div class="d-grid"><a href="@loginUrl" class="btn btn-primary">@Html.Text("common.login")</a></div>
                    }
                    else if (!tokenValid)
                    {
                        <div class="alert alert-warning">@Html.Text("auth.reset.invalidToken")</div>
                        <div class="d-grid"><a href="@forgotUrl" class="btn btn-outline-primary">@Html.Text("auth.reset.requestAgain")</a></div>
                    }
                    else
                    {
                        <form action="@actionUrl" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Token" value="@Model.Token" />
                            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div class="text-danger mb-2">@Html.Text(err.ErrorMessage)</div>
                            }
                            <div class="form-group mb-3">
                                <label for="NewPassword" class="control-label">@Html.Text("auth.reset.newPassword")</label>
                                <input id="NewPassword" name="NewPassword" type="password" class="form-control" required minlength="8" autocomplete="new-password" />
                            </div>
                            <div class="form-group mb-3">
                                <label for="ConfirmPassword" class="control-label">@Html.Text("auth.reset.confirmPassword")</label>
                                <input id="ConfirmPassword" name="ConfirmPassword" type="password" class="form-control" required minlength="8" autocomplete="new-password" />
                            </div>
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary">@Html.Text("auth.reset.submit")</button>
                            </div>
                        </form>
                    }
                </div>
                <div class="card-footer text-center">
                    <a href="@loginUrl">@Html.Text("auth.backToLogin")</a>
                </div>
            </div>
        </div>
    </div>
</div>
