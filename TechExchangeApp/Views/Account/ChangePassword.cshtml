@using TechExchangeApp.Interfaces
@using Microsoft.AspNetCore.Identity
@using TechExchangeApp.Entities
@inject IAccountService AccountService
@inject UserManager<ApplicationUser> UserManager

@model TechExchangeApp.ViewModel.ChangePasswordVm

@{
    ViewData["Title"] = Html.Text("profile.securityLink");
    ViewData["AuthWorkspace"] = true;

    var userId = int.Parse(UserManager.GetUserId(User)!);
    var sidebarData = await AccountService.GetSidebarDataAsync(userId);
}

<div class="container-fluid py-4 user-portal">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-3 col-lg-2">
            @await Html.PartialAsync("_AccountSidebar", sidebarData)
        </div>

        <!-- Main Content -->
        <div class="col-md-9 col-lg-10 user-portal-main user-password">

            <div class="user-profile-header mb-3">
                <h2 class="h4 mb-1" style="color:var(--up-navy);font-weight:700;">@Html.Text("profile.securityLink")</h2>
                <p class="mb-0">@Html.Text("changepwd.subtitle")</p>
            </div>

            <div class="row justify-content-center">
                <div class="col-lg-6">
                    <div class="card shadow-sm">
                        <div class="card-header">
                            <h5 class="mb-0"><i class="fas fa-key me-2"></i> @Html.Text("changepwd.cardTitle")</h5>
                        </div>

                        <form asp-action="ChangePassword" method="post">
                            @Html.AntiForgeryToken()
                            <div class="card-body">
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                                <div class="mb-3">
                                    <label asp-for="CurrentPassword" class="form-label">@Html.Text("changepwd.currentPassword")</label>
                                    <div class="input-group">
                                        <input asp-for="CurrentPassword" class="form-control" placeholder="@Html.Text("changepwd.currentPasswordPh")" />
                                        <button class="btn btn-outline-secondary" type="button" tabindex="-1" aria-label="@Html.Text("changepwd.togglePwdAria")" onclick="pv_togglePwd(this)"><i class="fas fa-eye"></i></button>
                                    </div>
                                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="NewPassword" class="form-label">@Html.Text("changepwd.newPassword")</label>
                                    <div class="input-group">
                                        <input asp-for="NewPassword" class="form-control" placeholder="@Html.Text("changepwd.newPasswordPh")" />
                                        <button class="btn btn-outline-secondary" type="button" tabindex="-1" aria-label="@Html.Text("changepwd.togglePwdAria")" onclick="pv_togglePwd(this)"><i class="fas fa-eye"></i></button>
                                    </div>
                                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ConfirmPassword" class="form-label">@Html.Text("changepwd.confirmPasswordLabel")</label>
                                    <div class="input-group">
                                        <input asp-for="ConfirmPassword" class="form-control" placeholder="@Html.Text("changepwd.confirmPasswordPh")" />
                                        <button class="btn btn-outline-secondary" type="button" tabindex="-1" aria-label="@Html.Text("changepwd.togglePwdAria")" onclick="pv_togglePwd(this)"><i class="fas fa-eye"></i></button>
                                    </div>
                                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                </div>

                                <div class="user-password-note">
                                    <i class="fas fa-info-circle"></i> <strong>@Html.Text("changepwd.noteTitle")</strong>
                                    <ul class="mb-0 mt-2">
                                        <li>@Html.Text("changepwd.note1")</li>
                                        <li>@Html.Text("changepwd.note2")</li>
                                        <li>@Html.Text("changepwd.note3")</li>
                                    </ul>
                                </div>
                            </div>

                            <div class="card-footer">
                                <button type="submit" class="btn btn-warning">
                                    <i class="fas fa-save"></i> @Html.Text("changepwd.submit")
                                </button>
                                <a href="@Url.Action("Profile", "Account")" class="btn btn-secondary">
                                    <i class="fas fa-times"></i> @Html.Text("common.cancel")
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div><!-- End Main Content -->
    </div><!-- End row -->
</div><!-- End container-fluid -->

<script>
    function pv_togglePwd(btn) {
        const input = btn.closest('.input-group').querySelector('input');
        const icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('fa-eye', 'fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.replace('fa-eye-slash', 'fa-eye');
        }
    }
</script>

@section Styles {
    <link rel="stylesheet" href="~/css/user-portal.css" asp-append-version="true" />
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
