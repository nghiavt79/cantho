@model TechExchangeApp.ViewModel.LoginViewModel

@{
    var isEn = TechExchangeApp.Helpers.LangHelper.IsEnglish(Context);
    ViewData["Title"] = Html.Text("common.login");
    var registerUrl = isEn ? "/en/register" : "/dang-ky";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">@Html.Text("common.login")</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-group mb-3">
                            <label asp-for="UserName" class="control-label">@Html.Text("auth.username")</label>
                            <input asp-for="UserName" class="form-control" />
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Password" class="control-label">@Html.Text("auth.password")</label>
                            <input asp-for="Password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="form-group form-check mb-3">
                            <input class="form-check-input" type="checkbox" asp-for="RememberMe" />
                            <label class="form-check-label" asp-for="RememberMe">@Html.Text("auth.rememberMe")</label>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-block">@Html.Text("common.login")</button>
                        </div>
                    </form>
                </div>
                <div class="card-footer text-center">
                    <p>@Html.Text("auth.noAccountQ") <a href="@registerUrl">@Html.Text("auth.registerNow")</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
