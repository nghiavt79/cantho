@model TechExchangeApp.ViewModel.ForgotPasswordVm

@{
    var isEn = TechExchangeApp.Helpers.LangHelper.IsEnglish(Context);
    ViewData["Title"] = Html.Text("auth.forgot.title");
    var loginUrl = isEn ? "/en/login" : "/dang-nhap";
    var actionUrl = isEn ? "/en/forgot-password" : "/quen-mat-khau";
    var sent = ViewBag.Sent as bool? == true;
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">@Html.Text("auth.forgot.title")</h3>
                </div>
                <div class="card-body">
                    @if (sent)
                    {
                        <div class="alert alert-success mb-0">@Html.Text("auth.forgot.sent")</div>
                    }
                    else
                    {
                        <p class="text-muted">@Html.Text("auth.forgot.intro")</p>
                        <form action="@actionUrl" method="post">
                            @Html.AntiForgeryToken()
                            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div class="text-danger mb-2">@Html.Text(err.ErrorMessage)</div>
                            }
                            <div class="form-group mb-3">
                                <label for="EmailOrUserName" class="control-label">@Html.Text("auth.forgot.label")</label>
                                <input id="EmailOrUserName" name="EmailOrUserName" value="@Model.EmailOrUserName" class="form-control" required maxlength="256" autocomplete="username" />
                            </div>
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary">@Html.Text("auth.forgot.submit")</button>
                            </div>
                        </form>
                    }
                </div>
                <div class="card-footer text-center">
                    <a href="@loginUrl">@Html.Text("auth.backToLogin")</a>
                </div>
            </div>
        </div>
    </div>
</div>
