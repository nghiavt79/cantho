@using TechExchangeApp.Interfaces
@using Microsoft.AspNetCore.Identity
@using TechExchangeApp.Entities
@inject IAccountService AccountService
@inject UserManager<ApplicationUser> UserManager

@model List<TechExchangeApp.ViewModel.MyProjectVm>

@{
    ViewData["Title"] = Html.Text("sidebar.myProjects");
    ViewData["AuthWorkspace"] = true;
    var isEn = TechExchangeApp.Helpers.LangHelper.IsEnglish(Context);

    var userId = int.Parse(UserManager.GetUserId(User)!);
    var sidebarData = await AccountService.GetSidebarDataAsync(userId);
}

<div class="container-fluid py-4 user-portal">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-3 col-lg-2">
            @await Html.PartialAsync("_AccountSidebar", sidebarData)
        </div>

        <!-- Main Content -->
        <div class="col-md-9 col-lg-10 user-portal-main user-projects">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0"><i class="fas fa-folder"></i> @Html.Text("myproj.listHeading")</h5>
                            <span class="badge bg-primary">@Html.Text("myproj.totalPrefix") @Model.Count @Html.Text("myproj.recordsSuffix")</span>
                        </div>
                        <a href="@Url.Action("Create", "TechTransfer")" class="btn btn-success">
                            <i class="fas fa-plus-circle"></i> @Html.Text("dash.postRequest")
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.Count == 0)
                    {
                        <div class="empty-state">
                            <i class="fas fa-folder-open empty-state-icon"></i>
                            <p class="empty-state-title">@Html.Text("myproj.empty.title")</p>
                            <p class="empty-state-text">@Html.Text("myproj.empty.text")</p>
                            <a href="@Url.Action("Create", "TechTransfer")" class="btn btn-primary btn-sm">
                                <i class="fas fa-plus-circle"></i> @Html.Text("dash.postRequest")
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>@Html.Text("myproj.col.code")</th>
                                        <th>@Html.Text("myproj.col.name")</th>
                                        <th>@Html.Text("dash.col.role")</th>
                                        <th>@Html.Text("dash.col.currentStep")</th>
                                        <th>@Html.Text("dash.col.status")</th>
                                        <th>@Html.Text("dash.col.progress")</th>
                                        <th>@Html.Text("profile.createdDate")</th>
                                        <th>@Html.Text("common.actions")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var project in Model)
                                    {
                                        <tr>
                                            <td data-label="@Html.Text("myproj.col.code")"><strong>@project.Code</strong></td>
                                            <td data-label="@Html.Text("myproj.col.name")">@project.Name</td>
                                            <td data-label="@Html.Text("dash.col.role")">
                                                @switch (project.RoleId)
                                                {
                                                    case 1:
                                                        <span class="badge bg-primary">@project.Role</span>
                                                        break;
                                                    case 2:
                                                        <span class="badge bg-success">@project.Role</span>
                                                        break;
                                                    case 3:
                                                        <span class="badge bg-info">@project.Role</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-secondary">@project.Role</span>
                                                        break;
                                                }
                                            </td>
                                            <td data-label="@Html.Text("dash.col.currentStep")">
                                                <span class="badge bg-warning text-dark">@Html.Text("dash.stepPrefix") @project.CurrentStep/@project.TotalDisplaySteps</span>
                                            </td>
                                            <td data-label="@Html.Text("dash.col.status")">
                                                @switch (project.StatusId)
                                                {
                                                    case 1:
                                                        <span class="badge bg-secondary">@project.Status</span>
                                                        break;
                                                    case 2:
                                                        <span class="badge bg-success">@project.Status</span>
                                                        break;
                                                    case 3:
                                                        <span class="badge bg-primary">@project.Status</span>
                                                        break;
                                                    case 4:
                                                        <span class="badge bg-danger">@project.Status</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-secondary">@project.Status</span>
                                                        break;
                                                }
                                            </td>
                                            <td data-label="@Html.Text("dash.col.progress")">
                                                <div class="progress" style="height: 20px;">
                                                    <div class="progress-bar @(project.ProgressPercent >= 100 ? "bg-success" : project.ProgressPercent >= 50 ? "bg-info" : "bg-warning")"
                                                         role="progressbar"
                                                         style="width: @project.ProgressPercent%"
                                                         aria-valuenow="@project.ProgressPercent"
                                                         aria-valuemin="0"
                                                         aria-valuemax="100">
                                                        @project.ProgressPercent%
                                                    </div>
                                                </div>
                                            </td>
                                            <td data-label="@Html.Text("profile.createdDate")">@project.CreatedDate.ToString(isEn ? "MMM d, yyyy" : "dd/MM/yyyy", isEn ? new System.Globalization.CultureInfo("en-US") : new System.Globalization.CultureInfo("vi-VN"))</td>
                                            <td data-label="@Html.Text("common.actions")">
                                                <a href="@Url.Action("Details", "Project", new { id = project.Id })" class="btn btn-sm btn-primary">
                                                    <i class="fas fa-eye"></i> @Html.Text("myproj.view")
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            @if (Model.Count > 0)
            {
                <div class="row mt-4 g-3">
                    <div class="col-md-4">
                        <div class="card user-projects-summary-card" data-accent="info">
                            <div class="card-body">
                                <h3>@Model.Count</h3>
                                <p class="mb-0">@Html.Text("myproj.summary.total")</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card user-projects-summary-card" data-accent="success">
                            <div class="card-body">
                                <h3>@Model.Count(p => p.StatusId == 2)</h3>
                                <p class="mb-0">@Html.Text("myproj.summary.active")</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card user-projects-summary-card" data-accent="warning">
                            <div class="card-body">
                                <h3>@Model.Count(p => p.ProgressPercent < 100)</h3>
                                <p class="mb-0">@Html.Text("myproj.summary.incomplete")</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div><!-- End Main Content -->
    </div><!-- End row -->
</div><!-- End container-fluid -->

@section Styles {
    <link rel="stylesheet" href="~/css/user-portal.css" asp-append-version="true" />
}
