@model TechExchangeApp.ViewModel.PhieuYeuCauCNViewModel

<form id="techRequestForm" asp-action="GuiPhieuYeuCau" asp-controller="Nhucaucongnghe" method="post" class="tech-form">
    @Html.AntiForgeryToken()
    @* Anti-spam: honeypot (ẩn bằng CSS, bot sẽ điền) *@
    <div style="position:absolute;left:-9999px;top:-9999px;" aria-hidden="true">
        <input type="text" name="website_url" tabindex="-1" autocomplete="off" />
    </div>
    @* Anti-spam: timestamp *@
    <input type="hidden" name="_ts" id="_formTs" value="" />

    <div class="tech-form-error" id="techFormError" role="alert" hidden></div>

    <div class="tech-form-grid">
        <div class="tech-form-field">
            <label class="tech-form-label" for="txtName">Họ và tên <span class="req">*</span></label>
            <input id="txtName" name="FullName" value="@Model.FullName" class="tech-form-input" placeholder="Nhập họ và tên" maxlength="150" required />
        </div>
        <div class="tech-form-field">
            <label class="tech-form-label" for="txtPhone">Số điện thoại <span class="req">*</span></label>
            <input id="txtPhone" name="Phone" value="@Model.Phone" class="tech-form-input" placeholder="Nhập số điện thoại" maxlength="150" required />
        </div>
        <div class="tech-form-field">
            <label class="tech-form-label" for="txtEmail">Email</label>
            <input id="txtEmail" type="email" name="Email" value="@Model.Email" class="tech-form-input" placeholder="Nhập email" maxlength="150" />
        </div>
        <div class="tech-form-field">
            <label class="tech-form-label" for="txtCode">Xác thực <span class="req">*</span></label>
            <div class="tech-form-captcha">
                <span class="tech-form-captcha__q" id="techCaptchaQuestion">@Model.CaptchaQuestion = ?</span>
                <input id="txtCode" name="CaptchaAnswer" type="number" inputmode="numeric" class="tech-form-input tech-form-captcha__input" placeholder="Kết quả" required autocomplete="off" />
            </div>
        </div>
        <div class="tech-form-field tech-form-field--full">
            <label class="tech-form-label" for="txtNoiDung">Mô tả nhu cầu <span class="req">*</span></label>
            <textarea id="txtNoiDung" name="NoiDung" class="tech-form-textarea" rows="4"
                      placeholder="Mô tả máy móc, thiết bị hoặc giải pháp bạn đang cần..." required></textarea>
        </div>
    </div>

    <p class="tech-form-note"><i class="bi bi-info-circle"></i> Thông tin chỉ dùng để hỗ trợ kết nối, không chia sẻ cho bên thứ ba.</p>

    <div class="tech-form-actions">
        <button type="button" class="tech-form-btn-cancel" data-bs-dismiss="modal">Hủy</button>
        <button type="submit" id="btnSave" class="tech-form-btn-submit">Gửi nhu cầu tìm mua <i class="bi bi-arrow-right"></i></button>
    </div>
</form>
<script>document.getElementById('_formTs').value = Math.floor(Date.now() / 1000);</script>
