@model TechExchangeApp.ViewModel.NhuCauCongNgheDetailViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/nhucaucongnghe-detail.css" asp-append-version="true" />
}

@section Scripts {
    @await Html.PartialAsync("_ReportViolationModal")
    <script>
        const btn = document.getElementById("DangYCCN");
        const box = document.getElementById("DangYCCNRegion");

        if (btn && box) {
            btn.addEventListener("click", function (e) {
                console.log("nut da duoc an");
                e.preventDefault();
                box.style.display =
                    (box.style.display === "none" || box.style.display === "")
                        ? "block"
                        : "none";
            });
        }
    </script>
}

<div class="nhucau-detail-page">
    <div class="nhucau-detail-container">

        <nav class="nhucau-detail-breadcrumb" aria-label="breadcrumb">
            <a href="/">Trang chủ</a>
            <span>/</span>
            <a href="/tim-mua-cong-nghe">Tìm mua công nghệ</a>
        </nav>

        <div class="nhucau-detail-layout">

            <div class="nhucau-detail-content">

                <!-- ====== PHIẾU YÊU CẦU (PARTIAL) ====== -->
                @await Html.PartialAsync("_PhieuYeuCauCN", Model.PhieuYeuCau )

                <!-- ====== TITLE + CONTENT ====== -->
                @if (Model.Detail != null)
                {
                    <article class="nhucau-detail-card">
                        <h1 class="nhucau-detail-card__title">@Model.Detail.Title</h1>

                        <div class="nhucau-detail-card__meta">
                            <span><i class="fa fa-eye"></i>@(Model.Detail.Viewed ?? 0) lượt xem</span>
                            <span><i class="fa fa-thumbs-up"></i>@(Model.Detail.Like ?? 0) lượt thích</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Detail.Description))
                        {
                            <div class="nhucau-detail-card__summary">@Html.Raw(Model.Detail.Description)</div>
                        }

                        <div class="content-text clearfix">
                            @Html.Raw(Model.Detail.Contents)
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Detail.Author))
                        {
                            <div class="nhucau-detail-card__author">@Model.Detail.Author</div>
                        }

                        @await Html.PartialAsync("_ContentUtilities", new TechExchangeApp.ViewModel.ContentUtilitiesVm
                        {
                            TargetDataType = "Yeu cau cong nghe",
                            TargetId = Model.Detail.Id,
                            TargetTitle = Model.Detail.Title,
                            ShareTitle = Model.Detail.Title
                        })

                        <!-- ====== IMAGE CAROUSEL ====== -->
                        @if (Model.Images.Any())
                        {
                            <div id="myCarousel" class="carousel slide" data-ride="carousel">
                                <div class="carousel-inner" role="listbox">
                                    @for (int i = 0; i < Model.Images.Count; i++)
                                    {
                                        var img = Model.Images[i];
                                        <div class="item @(i == 0 ? "active" : "")">
                                            <img src="@img.ImageUrl" alt="@img.Title" />
                                            <div class="carousel-caption">
                                                @img.Title
                                            </div>
                                        </div>
                                    }
                                </div>

                                <a class="left carousel-control" href="#myCarousel" data-slide="prev">
                                    <span class="glyphicon glyphicon-chevron-left"></span>
                                </a>
                                <a class="right carousel-control" href="#myCarousel" data-slide="next">
                                    <span class="glyphicon glyphicon-chevron-right"></span>
                                </a>
                            </div>
                        }
                    </article>
                }

                <!-- ====== CONTACT ====== -->
                <div class="nhucau-detail-cta">Liên hệ để đáp ứng công nghệ</div>

                <!-- ====== COMMENT ====== -->
                @* @if (Model.TargetId > 0 && Model.CommentTypeId.HasValue)
                {
                    @await Html.PartialAsync(
                        "_Comment",
                        new
                        {
                            TargetId = Model.TargetId,
                            CommentTypeId = Model.CommentTypeId.Value
                        }
                    )
                } *@

                <!-- ====== RELATED NEWS ====== -->
                @if (Model.Relations.Any())
                {
                    <div class="nhucau-detail-related">
                        <h2 class="nhucau-detail-related__title">Tin khác</h2>
                        <ul class="nhucau-detail-related__list">
                            @foreach (var item in Model.Relations)
                            {
                                <li>
                                    <a href="@Html.MainDomain()@item.MenuId/yeu-cau/@item.QueryString-@(item.Id)">
                                        @item.Title
                                    </a>
                                    <span>@item.PublishedDate?.ToString("dd/MM/yyyy")</span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>

            <!-- ================= SIDEBAR ================= -->
            <aside class="nhucau-detail-sidebar">
                @await Html.PartialAsync("_PortletYeuCauMoi", Model.YeuCauMoi)

                @* Left banner nếu cần *@
                @* @await Html.PartialAsync("_Left") *@
            </aside>
        </div>
    </div>
</div>
