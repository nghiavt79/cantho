@model TechExchangeApp.ViewModel.NewsDetailVm
@using TechExchangeApp.Web.Helpers
@{
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/news-detail.css" asp-append-version="true" />
}

<div class="news-detail-page">
    <div class="news-detail-container">

        <nav class="news-detail-breadcrumb" aria-label="breadcrumb">
            <partial name="_BreadcrumbHome" />
            <span>/</span>
            <strong>@Model.Title</strong>
        </nav>

        <div class="news-detail-layout">

            <div class="news-detail-content">
                <article class="news-detail-card">
                    <h1 class="news-detail-card__title">@Model.Title</h1>

                    @if (Model.MenuId != 83)
                    {
                        <div class="news-detail-card__meta">
                            <i class="fa fa-calendar"></i>@Model.PublishedDateText
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <div class="news-detail-card__summary">@Html.Raw(Model.Description)</div>
                    }

                    <div class="content-text clearfix">
                        @Html.Raw(Model.Content)
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Author))
                    {
                        <div class="news-detail-card__author">@Model.Author</div>
                    }

                    @await Html.PartialAsync("_ContentUtilities", new TechExchangeApp.ViewModel.ContentUtilitiesVm
                    {
                        TargetDataType = "Tin tuc",
                        TargetId = Model.Id,
                        TargetTitle = Model.Title,
                        ShareTitle = Model.Title
                    })

                    @* ===== IMAGE CAROUSEL (TypeId = 4) ===== *@
                    @if (Model.Images != null && Model.Images.Any())
                    {
                        <div id="myCarousel" class="carousel slide" data-ride="carousel">
                            <div class="carousel-inner" role="listbox">
                                @for (int i = 0; i < Model.Images.Count; i++)
                                {
                                    var img = Model.Images[i];
                                    <div class="item @(i == 0 ? "active" : "")">
                                        <img src="@img.ImageUrl" alt="@img.Title" />
                                        @img.Title
                                    </div>
                                }
                            </div>

                            <!-- Left and right controls -->
                            <a class="left carousel-control" href="#myCarousel" role="button" data-slide="prev">
                                <span class="glyphicon glyphicon-chevron-left"></span>
                                <span class="sr-only">Previous</span>
                            </a>
                            <a class="right carousel-control" href="#myCarousel" role="button" data-slide="next">
                                <span class="glyphicon glyphicon-chevron-right"></span>
                                <span class="sr-only">Next</span>
                            </a>
                        </div>
                    }
                </article>

                <!-- Related Posts -->
                @if (Model.Related.Any())
                {
                    <div class="news-detail-related">
                        <h2 class="news-detail-related__title">@Html.Text("news.related")</h2>
                        <ul class="news-detail-related__list">
                            @foreach (var item in Model.Related)
                            {
                                <li>
                                    <a href="@item.DetailUrl(Html.MainDomain(), TechExchangeApp.Helpers.LangHelper.IsEnglish(Context))">@item.Title</a>
                                    <span>@item.PublishedDate?.ToString("dd/MM/yyyy")</span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>

            <!-- Sidebar -->
            <aside class="news-detail-sidebar">
                @await Component.InvokeAsync("MenuLeft", new { menuId = Model.MenuId })
                @await Html.PartialAsync("~/Views/QuangCao/TopRight.cshtml")
            </aside>

        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ReportViolationModal")
}
