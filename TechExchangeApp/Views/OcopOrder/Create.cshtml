@using TechExchangeApp.Interfaces
@using Microsoft.AspNetCore.Identity
@using TechExchangeApp.Entities
@inject IAccountService AccountService
@inject UserManager<ApplicationUser> UserManager

@model TechExchangeApp.Entities.OcopOrderRequest

@{
    ViewData["Title"] = "GỬI YÊU CẦU ĐẶT MUA / QUAN TÂM";
    ViewData["AuthWorkspace"] = true;
    var product = ViewBag.Product as TechExchangeApp.Entities.SanPhamCNTB;
    string ProductTypeText(int? type) => type switch
    {
        2 => "Thiết bị",
        4 => "OCOP",
        _ => "Sản phẩm"
    };
    var productTypeText = ProductTypeText(product?.ProductType ?? Model.RequestProductType);

    var userId = int.Parse(UserManager.GetUserId(User)!);
    var sidebarData = await AccountService.GetSidebarDataAsync(userId);
}

<div class="container-fluid py-4 user-portal">
    <div class="row">
        <div class="col-md-3 col-lg-2">
            @await Html.PartialAsync("_AccountSidebar", sidebarData)
        </div>

        <div class="col-md-9 col-lg-10 user-portal-main">
            <div class="user-tech-transfer-form user-ocop-order-form">
                <div class="tech-transfer-shell tech-transfer-shell--single">
                    <div class="tech-transfer-card">
                        <div class="tech-transfer-header">
                            <h1><i class="fas fa-paper-plane me-2"></i>@ViewData["Title"]</h1>
                        </div>

                        <div class="tech-form-section">
                            @if (product != null)
                            {
                                <div class="ocop-product-summary mb-4">
                                    <div class="ocop-product-icon">
                                        <i class="fa fa-box"></i>
                                    </div>
                                    <div>
                                        <strong>@product.Name</strong>
                                        <p>@productTypeText - yêu cầu đặt mua / quan tâm sẽ được gửi đến nhà cung ứng để liên hệ và xác nhận trực tiếp.</p>
                                        @if (!string.IsNullOrWhiteSpace(Model.GiaThamKhao))
                                        {
                                            <p><strong>Giá tham khảo:</strong> @Model.GiaThamKhao</p>
                                        }
                                    </div>
                                </div>
                            }

                            <form asp-action="Create" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="ProductId" />
                                <input type="hidden" asp-for="RequestProductType" />
                                <input type="hidden" asp-for="GiaThamKhao" />
                                <input type="hidden" asp-for="HinhThucThanhToan" value="1" />
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                                <div class="row g-3 g-lg-4">
                                    <div class="col-md-6">
                                        <label asp-for="HoTen" class="form-label">Họ và tên <span class="text-danger">*</span></label>
                                        <input asp-for="HoTen" class="form-control" placeholder="Nhập họ và tên" />
                                        <span asp-validation-for="HoTen" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="DienThoai" class="form-label">Điện thoại <span class="text-danger">*</span></label>
                                        <input asp-for="DienThoai" class="form-control" />
                                        <span asp-validation-for="DienThoai" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                                        <input asp-for="Email" class="form-control" type="email" />
                                        <span asp-validation-for="Email" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="SoLuong" class="form-label">Số lượng <span class="text-danger">*</span></label>
                                        <input asp-for="SoLuong" class="form-control" type="number" min="1" />
                                        <span asp-validation-for="SoLuong" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="DiaChiGiao" class="form-label">Địa chỉ liên hệ/giao nhận dự kiến <span class="text-danger">*</span></label>
                                        <input asp-for="DiaChiGiao" class="form-control" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành" />
                                        <span asp-validation-for="DiaChiGiao" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="GhiChu" class="form-label">Ghi chú</label>
                                        <textarea asp-for="GhiChu" class="form-control tech-order-note" rows="3" placeholder="Ghi chú thêm cho nhà cung ứng (nếu có)"></textarea>
                                        <span asp-validation-for="GhiChu" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12">
                                        <div class="alert alert-info mb-0">
                                            <i class="fas fa-circle-info me-1"></i>
                                            Sàn chỉ ghi nhận yêu cầu và chuyển thông tin cho nhà cung ứng. Thanh toán, giao nhận và các điều kiện mua bán do người mua trao đổi trực tiếp với nhà cung ứng.
                                        </div>
                                    </div>
                                </div>

                                <div class="tech-form-actions px-0 pb-0">
                                    <a asp-controller="Projects" asp-action="MyProjects" class="btn btn-outline-secondary">Quay lại</a>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-paper-plane me-2"></i>Gửi yêu cầu đặt mua / quan tâm
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/user-portal.css" asp-append-version="true" />
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
