@model TechExchangeApp.Entities.OcopOrderRequest

@{
    ViewData["Title"] = "Đã gửi yêu cầu đặt mua";
    var product = ViewBag.Product as TechExchangeApp.Entities.SanPhamCNTB;
    var supplier = ViewBag.Supplier as TechExchangeApp.Entities.NhaCungUng;
    var hasBankInfo = supplier != null && !string.IsNullOrWhiteSpace(supplier.SoTaiKhoan);
    string ProductTypeText(int? type) => type switch
    {
        2 => "thiết bị",
        4 => "sản phẩm OCOP",
        _ => "sản phẩm"
    };
    var fallbackName = ProductTypeText(Model.RequestProductType ?? product?.ProductType);
}

<div class="container mt-5 text-center">
    <div class="card shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-body py-5">
            <div class="mb-4 text-success">
                <i class="fas fa-check-circle fa-5x"></i>
            </div>
            <h2 class="card-title text-success mb-3">Đã gửi yêu cầu đặt mua!</h2>
            <p class="card-text text-muted mb-1">
                Yêu cầu đặt mua / quan tâm @Model.SoLuong @(product != null ? $"\"{product.Name}\"" : fallbackName) đã được gửi đến nhà cung ứng.
            </p>
            <p class="card-text text-muted mb-4">
                Nhà cung ứng sẽ liên hệ với bạn qua số điện thoại <strong>@Model.DienThoai</strong> để trao đổi giá, thanh toán, giao nhận và các điều kiện mua bán.
            </p>
            <a asp-controller="OcopOrder" asp-action="Index" class="btn btn-outline-primary me-2">
                <i class="fas fa-list me-2"></i>Xem yêu cầu của tôi
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="fas fa-home me-2"></i>Về trang chủ
            </a>
            <a asp-controller="Ocop" asp-action="Index" class="btn btn-outline-secondary ms-2">
                <i class="fas fa-store me-2"></i>Xem thêm sản phẩm
            </a>
        </div>
    </div>
</div>
