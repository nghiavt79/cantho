@using TechExchangeApp.Interfaces
@using Microsoft.AspNetCore.Identity
@using TechExchangeApp.Entities
@inject IAccountService AccountService
@inject UserManager<ApplicationUser> UserManager

@model List<TechExchangeApp.Controllers.FavoriteItemVm>

@{
    ViewData["Title"] = Html.Text("fav.pageTitle");
    ViewData["AuthWorkspace"] = true;

    var userId = int.Parse(UserManager.GetUserId(User)!);
    var sidebarData = await AccountService.GetSidebarDataAsync(userId);
}

<div class="container-fluid py-4 user-portal">
  <div class="row">
    <div class="col-md-3 col-lg-2">
      @await Html.PartialAsync("_AccountSidebar", sidebarData)
    </div>

    <div class="col-md-9 col-lg-10 user-portal-main">
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-heart text-danger me-1"></i> @Html.Text("fav.pageTitle")</h5>
                <span class="badge bg-primary">@Model.Count</span>
            </div>
            <div class="card-body">
                @if (Model.Count == 0)
                {
                    <p class="text-muted mb-0">@Html.Text("fav.empty")</p>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var item in Model)
                        {
                            <div class="list-group-item d-flex align-items-center gap-3 fav-row" data-id="@item.ProductId">
                                <img src="@Html.CookedImageURL("108-84", item.Image)" alt="" style="width:96px;height:72px;object-fit:cover" class="rounded" />
                                <div class="flex-grow-1">
                                    <a href="@item.Url" class="fw-semibold text-decoration-none">@item.Name</a>
                                    <div class="small text-muted">@Html.Text("fav.savedAt") @item.Created.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-danger btn-unfav" data-id="@item.ProductId">
                                    <i class="fas fa-heart-crack me-1"></i>@Html.Text("fav.remove")
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
  </div>
</div>

@section Scripts {
<script>
document.querySelectorAll('.btn-unfav').forEach(function (btn) {
    btn.addEventListener('click', function () {
        var token = document.querySelector('meta[name="__RequestVerificationToken"]')?.content || '';
        btn.disabled = true;
        fetch('/ProductFavorite/Toggle', {
            method: 'POST',
            headers: { 'RequestVerificationToken': token, 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'id=' + encodeURIComponent(btn.dataset.id)
        }).then(function (r) { return r.json(); }).then(function (d) {
            if (d && d.success && !d.isFavorite) btn.closest('.fav-row').remove();
            else btn.disabled = false;
        }).catch(function () { btn.disabled = false; });
    });
});
</script>
}
