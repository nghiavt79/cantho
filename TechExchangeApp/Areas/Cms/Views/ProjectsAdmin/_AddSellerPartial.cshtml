@{
    var projectId = (int)ViewBag.ProjectId;
    var projectName = (string)ViewBag.ProjectName;
    var available = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Available;
    var invited = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Invited;
    var hasRfq = (bool)ViewBag.HasRfq;
}

<div class="modal-body pb-0">
    <div class="mb-3">
        <label class="form-label fw-semibold small">Hồ sơ</label>
        <input type="text" class="form-control form-control-sm" value="@projectName" disabled />
    </div>
    <label class="form-label fw-semibold small">Bên bán đã được mời</label>
    @if (invited.Any())
    {
        foreach (var item in invited)
        {
            <form action="@Url.Action("RemoveSeller", "ProjectsAdmin", new { area = "Cms" })" method="post" class="d-flex justify-content-between align-items-center border rounded p-2 mb-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="invitationId" value="@item.Value" />
                <span class="small">@item.Text</span>
                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fas fa-times me-1"></i> Thu hồi</button>
            </form>
        }
    }
    else
    {
        <p class="text-muted small">Chưa có bên bán nào.</p>
    }
</div>

<form action="@Url.Action("AddSeller", "ProjectsAdmin", new { area = "Cms" })" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="projectId" value="@projectId" />
    <div class="modal-body pt-0">
        @if (!hasRfq)
        {
            <div class="alert alert-warning mb-0">
                <i class="fas fa-info-circle me-1"></i> Hồ sơ chưa có yêu cầu báo giá (bước 3) nên chưa gán được bên bán.
            </div>
        }
        else if (available.Any())
        {
            <label class="form-label fw-semibold small">Chọn nhà cung ứng <span class="text-danger">*</span></label>
            <select name="sellerUserId" class="form-select form-select-sm select2-consultant" required>
                <option value="">-- Chọn nhà cung ứng --</option>
                @foreach (var item in available)
                {
                    <option value="@item.Value">@item.Text</option>
                }
            </select>
            <small class="text-muted">Chỉ hiện nhà cung ứng đã Xuất bản, đã Kích hoạt và có tài khoản.</small>
        }
        else
        {
            <div class="alert alert-warning mb-0">
                <i class="fas fa-info-circle me-1"></i> Không có nhà cung ứng nào đã Xuất bản, đã Kích hoạt và có tài khoản.
            </div>
        }
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
            <i class="fas fa-times me-1"></i> Đóng
        </button>
        @if (hasRfq && available.Any())
        {
            <button type="submit" class="btn btn-primary btn-sm">
                <i class="fas fa-store me-1"></i> Gán bên bán
            </button>
        }
    </div>
</form>
