<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] – CMS</title>

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Bootstrap 5.3 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <!-- AdminLTE 4 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-beta3/dist/css/adminlte.min.css" />

    <!-- CMS SaaS Theme -->
    <link rel="stylesheet" href="~/css/cms-theme.css" />

    <!-- Toastr CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <!-- Select2 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />

    @RenderSection("Styles", required: false)
</head>
<body class="layout-fixed sidebar-expand-lg sidebar-mini sidebar-collapse bg-body-tertiary cms-saas-theme">
<div class="app-wrapper">

    <!-- ─── Top Navbar ─── -->
    <nav class="app-header navbar navbar-expand bg-body">
        <div class="container-fluid">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a href="/" class="nav-link" target="_blank"><i class="fas fa-external-link-alt me-1"></i> Xem trang chủ</a>
                </li>
            </ul>
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <form method="post" action="/Account/Logout" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="nav-link btn btn-link">
                            <i class="fas fa-sign-out-alt"></i> Đăng xuất
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </nav>

    <!-- ─── Sidebar ─── -->
    <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
        <div class="sidebar-brand">
            <a href="/cms" class="brand-link">
                <span class="brand-text fw-light">
                    <i class="fas fa-cogs"></i> <strong>CMS</strong>
                </span>
            </a>
        </div>

        <div class="sidebar-wrapper">
            <nav class="mt-2">
                <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu" data-accordion="false">

                    <li class="nav-item">
                        <a asp-area="Cms" asp-controller="Dashboard" asp-action="Index"
                           class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                            <i class="nav-icon fas fa-tachometer-alt"></i>
                            <p>Dashboard</p>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-area="Cms" asp-controller="Users" asp-action="Index"
                           class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")">
                            <i class="nav-icon fas fa-users-cog"></i>
                            <p>Người dùng</p>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-area="Cms" asp-controller="ProjectsAdmin" asp-action="Index"
                           class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ProjectsAdmin" ? "active" : "")">
                            <i class="nav-icon fas fa-project-diagram"></i>
                            <p>Dự án</p>
                        </a>
                    </li>
                    @{
                        var postsCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
                        bool isPosts = postsCtrl == "Posts";
                        bool isMenuAdmin = postsCtrl == "MenuAdmin";
                        bool isCategoryAdmin = postsCtrl == "CategoryAdmin";
                        bool isImageAdverAdmin = postsCtrl == "ImageAdverAdmin";
                        bool isContentsYeuCauAdmin = postsCtrl == "ContentsYeuCauAdmin";
                        bool isPhieuYeuCauCNTBAdmin = postsCtrl == "PhieuYeuCauCNTBAdmin";
                        bool isSystemParameterAdmin = postsCtrl == "SystemParameterAdmin";
                        bool isSysFunctionAdmin = postsCtrl == "SysFunctionAdmin";
                        bool isContentGroup = isPosts || isMenuAdmin || isCategoryAdmin || isImageAdverAdmin;
                        bool isTimMuaGroup = isContentsYeuCauAdmin || isPhieuYeuCauCNTBAdmin;
                    }
                    <li class="nav-item @(isContentGroup ? "menu-open" : "")">
                        <a href="#" class="nav-link @(isContentGroup ? "active" : "")">
                            <i class="nav-icon fas fa-newspaper"></i>
                            <p>
                                Tin bài / Contents
                                <i class="nav-arrow fas fa-angle-right"></i>
                            </p>
                        </a>
                        <ul class="nav nav-treeview">
                            <li class="nav-item">
                                <a asp-area="Cms" asp-controller="Posts" asp-action="Index"
                                   class="nav-link @(isPosts ? "active" : "")">
                                    <i class="nav-icon fas fa-list"></i>
                                    <p>Quản lý tin bài</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-area="Cms" asp-controller="MenuAdmin" asp-action="Index"
                                   class="nav-link @(isMenuAdmin ? "active" : "")">
                                    <i class="nav-icon fas fa-sitemap"></i>
                                    <p>Quản lý Menu</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-area="Cms" asp-controller="CategoryAdmin" asp-action="Index"
                                   class="nav-link @(isCategoryAdmin ? "active" : "")">
                                    <i class="nav-icon fas fa-tags"></i>
                                    <p>Quản lý Danh mục</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-area="Cms" asp-controller="ImageAdverAdmin" asp-action="Index"
                                   class="nav-link @(isImageAdverAdmin ? "active" : "")">
                                    <i class="nav-icon fas fa-ad"></i>
                                    <p>Quản lý Quảng cáo</p>
                                </a>
                            </li>
                        </ul>
                    </li>

                    @{
                        var cntbCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
                        var cntbAction = ViewContext.RouteData.Values["action"]?.ToString();
                        bool isCntb = cntbCtrl == "SanPhamCNTB";
                    }
                    <li class="nav-item @(isCntb ? "menu-open" : "")">
                        <a href="#" class="nav-link @(isCntb ? "active" : "")">
                            <i class="nav-icon fas fa-boxes-stacked"></i>
                            <p>
                                Sản phẩm CNTB
                                <i class="nav-arrow fas fa-angle-right"></i>
                            </p>
                        </a>
                        <ul class="nav nav-treeview">
                            <li class="nav-item">
                                <a asp-area="Cms" asp-controller="SanPhamCNTB" asp-action="CongNghe"
                                   class="nav-link @(isCntb && cntbAction == "CongNghe" ? "active" : "")">
                                    <i class="nav-icon fas fa-microchip"></i>
                                    <p>Quản lý Công nghệ</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-area="Cms" asp-controller="SanPhamCNTB" asp-action="ThietBi"
                                   class="nav-link @(isCntb && cntbAction == "ThietBi" ? "active" : "")">
                                    <i class="nav-icon fas fa-cogs"></i>
                                    <p>Quản lý Thiết bị</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-area="Cms" asp-controller="SanPhamCNTB" asp-action="SanPhamTriTue"
                                   class="nav-link @(isCntb && cntbAction == "SanPhamTriTue" ? "active" : "")">
                                    <i class="nav-icon fas fa-certificate"></i>
                                    <p>Quản lý SP trí tuệ</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-area="Cms" asp-controller="SanPhamCNTB" asp-action="Ocop"
                                   class="nav-link @(isCntb && cntbAction == "Ocop" ? "active" : "")">
                                    <i class="nav-icon fas fa-award"></i>
                                    <p>Quản lý OCOP</p>
                                </a>
                            </li>
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a asp-area="Cms" asp-controller="NhaCungUngAdmin" asp-action="Index"
                           class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "NhaCungUngAdmin" ? "active" : "")">
                            <i class="nav-icon fas fa-building"></i>
                            <p>Nhà cung ứng</p>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-area="Cms" asp-controller="NhaTuVanAdmin" asp-action="Index"
                           class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "NhaTuVanAdmin" ? "active" : "")">
                            <i class="nav-icon fas fa-user-tie"></i>
                            <p>Nhà tư vấn</p>
                        </a>
                    </li>

                    <li class="nav-item @(isTimMuaGroup ? "menu-open" : "")">
                        <a href="#" class="nav-link @(isTimMuaGroup ? "active" : "")">
                            <i class="nav-icon fas fa-cart-shopping"></i>
                            <p>
                                Tìm Mua
                                <i class="nav-arrow fas fa-angle-right"></i>
                            </p>
                        </a>
                        <ul class="nav nav-treeview">
                            <li class="nav-item">
                                <a asp-area="Cms" asp-controller="PhieuYeuCauCNTBAdmin" asp-action="Index"
                                   class="nav-link @(isPhieuYeuCauCNTBAdmin ? "active" : "")">
                                    <i class="nav-icon fas fa-file-alt"></i>
                                    <p>Phiếu yêu cầu</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-area="Cms" asp-controller="ContentsYeuCauAdmin" asp-action="Index"
                                   class="nav-link @(isContentsYeuCauAdmin ? "active" : "")">
                                    <i class="nav-icon fas fa-bullhorn"></i>
                                    <p>Tìm mua công khai</p>
                                </a>
                            </li>
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a asp-area="Cms" asp-controller="FeedbackAdmin" asp-action="Index"
                           class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "FeedbackAdmin" ? "active" : "")">
                            <i class="nav-icon fas fa-comments"></i>
                            <p>Phản hồi (Feedback)</p>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-area="Cms" asp-controller="DashboardData" asp-action="Index"
                           class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "DashboardData" ? "active" : "")">
                            <i class="nav-icon fas fa-chart-bar"></i>
                            <p>Số liệu Dashboard</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="Cms" asp-controller="SystemParameterAdmin" asp-action="Index"
                           class="nav-link @(isSystemParameterAdmin ? "active" : "")">
                            <i class="nav-icon fas fa-sliders-h"></i>
                            <p>System Parameter</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="Cms" asp-controller="SysFunctionAdmin" asp-action="Index"
                           class="nav-link @(isSysFunctionAdmin ? "active" : "")">
                            <i class="nav-icon fas fa-shield-alt"></i>
                            <p>SysFunction</p>
                        </a>
                    </li>

                </ul>
            </nav>
        </div>


        <!-- Sidebar Bottom: Notification + User -->
        <div class="sidebar-bottom">
            <div class="sidebar-notify" id="btnReindexSearch" role="button" title="Cập nhật chỉ mục tìm kiếm"
                 style="background:rgba(16,185,129,.22);">
                <i class="bi bi-search" style="color:#34d399;"></i>
            </div>
            <div class="sidebar-notify" id="btnClearHomeCache" role="button" title="Xóa cache trang chủ"
                 style="background:rgba(139,92,246,.22);">
                <i class="bi bi-arrow-clockwise" style="color:#b794f6;"></i>
            </div>
            <div class="sidebar-user">
                <div class="avatar">@(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")</div>
                <span class="user-name">@(User.Identity?.Name ?? "User")</span>
            </div>
        </div>
    </aside>

    <!-- ─── Content Wrapper ─── -->
    <main class="app-main">
        <div class="app-content-header">
            <div class="container-fluid">
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <h3 class="mb-0">@ViewData["Title"]</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="app-content">
            <div class="container-fluid">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle"></i> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </div>
        </div>
    </main>

    <!-- ─── Footer ─── -->
    <footer class="app-footer">
        <strong>&copy; @DateTime.Now.Year SGD.</strong> CMS Admin Panel.
    </footer>
</div>

@* Token cho AJAX xóa cache trang chủ (nút nằm trong .sidebar-bottom) *@
@Html.AntiForgeryToken()

<!-- Popup: cập nhật chỉ mục tìm kiếm — chọn ngôn ngữ -->
<div class="modal fade" id="reindexModal" tabindex="-1" aria-labelledby="reindexModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="reindexModalLabel"><i class="bi bi-search me-2"></i>Cập nhật chỉ mục tìm kiếm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <label for="reindexLang" class="form-label">Ngôn ngữ</label>
                <select id="reindexLang" class="form-select form-select-sm">
                    <option value="1" selected>Tiếng Việt</option>
                    <option value="2">English</option>
                </select>
                <p class="text-muted small mt-2 mb-0">Thao tác dựng lại chỉ mục có thể mất vài giây.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary btn-sm" id="btnReindexConfirm">
                    <i class="bi bi-arrow-repeat"></i> Cập nhật
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    @@keyframes cmsCacheSpin { to { transform: rotate(360deg); } }
    #btnClearHomeCache.spinning i,
    #btnReindexSearch.spinning i { animation: cmsCacheSpin .8s linear infinite; }
</style>

<!-- jQuery (for Select2, Toastr, AJAX) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<!-- Bootstrap 5.3 Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<!-- AdminLTE 4 JS -->
<script src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-beta3/dist/js/adminlte.min.js"></script>

<!-- Toastr JS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<!-- Select2 -->
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script>
    (function () {
        var btn = document.getElementById('btnClearHomeCache');
        if (!btn) return;
        btn.addEventListener('click', function () {
            if (btn.dataset.busy === '1') return;
            var token = (document.querySelector('input[name="__RequestVerificationToken"]') || {}).value || '';
            btn.dataset.busy = '1'; btn.classList.add('spinning');
            fetch('/cms/Cache/ClearHomeCache', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                body: '__RequestVerificationToken=' + encodeURIComponent(token)
            })
            .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
            .then(function (d) {
                if (window.toastr) { d.success ? toastr.success(d.message) : toastr.error(d.message || 'Không xóa được cache.'); }
            })
            .catch(function () { if (window.toastr) toastr.error('Không xóa được cache trang chủ.'); })
            .finally(function () { btn.dataset.busy = '0'; btn.classList.remove('spinning'); });
        });
    })();

    // Cập nhật chỉ mục tìm kiếm — mở popup chọn ngôn ngữ rồi gọi uspReIndexSearchContents
    (function () {
        var btn = document.getElementById('btnReindexSearch');
        var modalEl = document.getElementById('reindexModal');
        var confirmBtn = document.getElementById('btnReindexConfirm');
        if (!btn || !modalEl || !confirmBtn || !window.bootstrap) return;

        var modal = new bootstrap.Modal(modalEl);
        btn.addEventListener('click', function () { modal.show(); });

        confirmBtn.addEventListener('click', function () {
            if (confirmBtn.dataset.busy === '1') return;
            var lang = (document.getElementById('reindexLang') || {}).value || '1';
            var token = (document.querySelector('input[name="__RequestVerificationToken"]') || {}).value || '';
            var oldHtml = confirmBtn.innerHTML;
            confirmBtn.dataset.busy = '1'; confirmBtn.disabled = true;
            confirmBtn.innerHTML = '<i class="bi bi-arrow-repeat"></i> Đang cập nhật...';
            btn.classList.add('spinning');
            fetch('/cms/SearchIndex/Reindex', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                body: '__RequestVerificationToken=' + encodeURIComponent(token) + '&languageId=' + encodeURIComponent(lang)
            })
            .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
            .then(function (d) {
                if (window.toastr) { d.success ? toastr.success(d.message) : toastr.error(d.message || 'Không cập nhật được chỉ mục.'); }
                if (d.success) modal.hide();
            })
            .catch(function () { if (window.toastr) toastr.error('Không cập nhật được chỉ mục tìm kiếm.'); })
            .finally(function () {
                confirmBtn.dataset.busy = '0'; confirmBtn.disabled = false;
                confirmBtn.innerHTML = oldHtml;
                btn.classList.remove('spinning');
            });
        });
    })();
</script>

@RenderSection("Scripts", required: false)
</body>
</html>
