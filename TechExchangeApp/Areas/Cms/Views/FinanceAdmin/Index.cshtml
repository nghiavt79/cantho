@model List<TechExchangeApp.Entities.FinanceEntry>
@using TechExchangeApp.Entities
@{
    ViewData["Title"] = "Thu chi";
    var from = (DateTime)ViewBag.From; var to = (DateTime)ViewBag.To;
    var category = (string?)ViewBag.Category; var direction = (byte?)ViewBag.Direction;
    var byCat = (List<TechExchangeApp.Areas.Cms.Controllers.FinanceSummaryRow>)ViewBag.ByCategory;
    var byMonth = (List<TechExchangeApp.Areas.Cms.Controllers.FinanceMonthRow>)ViewBag.ByMonth;
    var rates = (List<CommissionRate>)ViewBag.Rates;
    var names = (Dictionary<int, string>)ViewBag.SupplierNames;
    var suppliers = (System.Collections.IEnumerable)ViewBag.Suppliers;
    decimal income = ViewBag.TotalIncome, expense = ViewBag.TotalExpense;
    var maxMonth = byMonth.Count == 0 ? 1 : Math.Max(1m, byMonth.Max(m => Math.Max(m.Income, m.Expense)));
    var exportUrl = Url.Action("Export", "FinanceAdmin", new { area = "Cms", from = from.ToString("yyyy-MM-dd"), to = to.ToString("yyyy-MM-dd"), category, direction });
}

<div class="card card-outline card-success shadow-sm mb-3">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-coins me-1"></i> Báo cáo thu chi</h3>
        <div class="card-tools"><a href="@exportUrl" class="btn btn-sm btn-success"><i class="fas fa-file-excel"></i> Xuất Excel</a>
            <a href="@Url.Action("ExportPdf", "FinanceAdmin", new { area = "Cms", from = from.ToString("yyyy-MM-dd"), to = to.ToString("yyyy-MM-dd"), category, direction })" class="btn btn-sm btn-danger"><i class="fas fa-file-pdf"></i> Xuất PDF</a></div>
    </div>
    <div class="card-body">
        @Html.AntiForgeryToken()
        <form method="get" class="row g-2 mb-3">
            <div class="col-md-2"><label class="form-label small mb-0">Từ ngày</label><input type="date" name="from" value="@from.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
            <div class="col-md-2"><label class="form-label small mb-0">Đến ngày</label><input type="date" name="to" value="@to.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
            <div class="col-md-3"><label class="form-label small mb-0">Nhóm</label>
                <select name="category" class="form-select form-select-sm">
                    <option value="">-- Tất cả --</option>
                    @foreach (var c in new[] { FinanceCategories.StoreFee, FinanceCategories.EventBoothFee, FinanceCategories.Commission, FinanceCategories.Other })
                    { <option value="@c" selected="@(category == c)">@FinanceCategories.Label(c)</option> }
                </select>
            </div>
            <div class="col-md-2"><label class="form-label small mb-0">Thu/Chi</label>
                <select name="direction" class="form-select form-select-sm">
                    <option value="">-- Cả hai --</option>
                    <option value="1" selected="@(direction == 1)">Thu</option>
                    <option value="2" selected="@(direction == 2)">Chi</option>
                </select>
            </div>
            <div class="col-auto align-self-end"><button class="btn btn-sm btn-primary"><i class="fas fa-filter"></i> Xem</button></div>
        </form>

        <div class="row g-3 mb-3 text-center">
            <div class="col-md-4"><div class="border rounded p-2"><div class="h4 mb-0 text-success">@income.ToString("N0")</div><div class="small text-muted">Tổng thu (đ)</div></div></div>
            <div class="col-md-4"><div class="border rounded p-2"><div class="h4 mb-0 text-danger">@expense.ToString("N0")</div><div class="small text-muted">Tổng chi (đ)</div></div></div>
            <div class="col-md-4"><div class="border rounded p-2"><div class="h4 mb-0">@((income - expense).ToString("N0"))</div><div class="small text-muted">Chênh lệch (đ)</div></div></div>
        </div>

        <div class="row g-3">
            <div class="col-lg-5">
                <h6 class="small fw-semibold">Theo nhóm</h6>
                <table class="table table-sm table-bordered small mb-0">
                    <thead class="table-light"><tr><th>Nhóm</th><th class="text-center">Số khoản</th><th class="text-end">Số tiền (đ)</th></tr></thead>
                    <tbody>
                        @if (byCat.Count == 0) { <tr><td colspan="3" class="text-center text-muted">Chưa có số liệu.</td></tr> }
                        @foreach (var r in byCat) { <tr><td>@(r.Direction == 1 ? "Thu" : "Chi") – @r.Key</td><td class="text-center">@r.Count</td><td class="text-end">@r.Amount.ToString("N0")</td></tr> }
                    </tbody>
                </table>
            </div>
            <div class="col-lg-7">
                <h6 class="small fw-semibold">Theo tháng</h6>
                <table class="table table-sm table-bordered small mb-0">
                    <thead class="table-light"><tr><th style="width:80px">Tháng</th><th>Thu</th><th>Chi</th></tr></thead>
                    <tbody>
                        @if (byMonth.Count == 0) { <tr><td colspan="3" class="text-center text-muted">Chưa có số liệu.</td></tr> }
                        @foreach (var m in byMonth)
                        {
                            <tr>
                                <td>@m.Month.ToString("MM/yyyy")</td>
                                <td><div class="d-flex align-items-center gap-2"><div class="bg-success rounded" style="height:10px;width:@(Math.Round(m.Income * 70 / maxMonth))%"></div><span>@m.Income.ToString("N0")</span></div></td>
                                <td><div class="d-flex align-items-center gap-2"><div class="bg-danger rounded" style="height:10px;width:@(Math.Round(m.Expense * 70 / maxMonth))%"></div><span>@m.Expense.ToString("N0")</span></div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-5">
        <div class="card card-outline card-warning shadow-sm mb-3">
            <div class="card-header"><h3 class="card-title"><i class="fas fa-percent me-1"></i> Tỷ lệ hoa hồng theo loại giao dịch</h3></div>
            <form id="ratesForm" class="card-body">
                <table class="table table-sm small mb-2">
                    @foreach (var r in rates)
                    {
                        <tr><td>@r.Name<input type="hidden" name="ids" value="@r.Id" /></td>
                            <td style="width:120px"><div class="input-group input-group-sm"><input name="rates" type="number" step="0.01" min="0" max="100" value="@r.RatePercent" class="form-control" /><span class="input-group-text">%</span></div></td></tr>
                    }
                </table>
                <div class="text-end"><button class="btn btn-warning btn-sm">Lưu tỷ lệ</button></div>
            </form>
        </div>
        <div class="card card-outline card-info shadow-sm mb-3">
            <div class="card-header"><h3 class="card-title"><i class="fas fa-handshake me-1"></i> Ghi nhận hoa hồng</h3></div>
            <form id="commissionForm" class="card-body">
                <div class="row g-2">
                    <div class="col-7"><select name="rateId" class="form-select form-select-sm">@foreach (var r in rates.Where(x => x.IsActive)) { <option value="@r.Id">@r.Name (@r.RatePercent%)</option> }</select></div>
                    <div class="col-5"><input name="baseAmount" type="number" min="0" step="1000" class="form-control form-control-sm" placeholder="Giá trị giao dịch (đ)" required /></div>
                    <div class="col-7"><select name="cungUngId" class="form-select form-select-sm"><option value="">-- Nhà cung cấp --</option>@foreach (dynamic s in suppliers) { <option value="@s.CungUngId">@s.FullName</option> }</select></div>
                    <div class="col-5"><input name="entryDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
                    <div class="col-12"><input name="description" class="form-control form-control-sm" placeholder="Số hợp đồng / dự án / ghi chú" maxlength="400" /></div>
                    <div class="col-12 text-end"><button class="btn btn-info btn-sm">Ghi nhận</button></div>
                </div>
            </form>
        </div>
        <div class="card card-outline card-secondary shadow-sm mb-3">
            <div class="card-header"><h3 class="card-title"><i class="fas fa-pen me-1"></i> Nhập khoản thu / chi khác</h3></div>
            <form id="entryForm" class="card-body">
                <div class="row g-2">
                    <div class="col-4"><select name="direction" class="form-select form-select-sm"><option value="1">Thu</option><option value="2">Chi</option></select></div>
                    <div class="col-8"><select name="category" class="form-select form-select-sm">@foreach (var c in new[] { FinanceCategories.Other, FinanceCategories.StoreFee, FinanceCategories.EventBoothFee, FinanceCategories.Commission }) { <option value="@c">@FinanceCategories.Label(c)</option> }</select></div>
                    <div class="col-6"><input name="amount" type="number" min="0" step="1000" class="form-control form-control-sm" placeholder="Số tiền (đ)" required /></div>
                    <div class="col-6"><input name="entryDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
                    <div class="col-12"><input name="description" class="form-control form-control-sm" placeholder="Nội dung *" maxlength="500" required /></div>
                    <div class="col-12 text-end"><button class="btn btn-secondary btn-sm">Thêm</button></div>
                </div>
            </form>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card shadow-sm mb-3">
            <div class="card-header"><h3 class="card-title small fw-semibold">Sổ thu chi (@Model.Count khoản)</h3></div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover small align-middle mb-0">
                        <thead class="table-light"><tr><th>Ngày</th><th>Nhóm</th><th>Nội dung</th><th class="text-end">Số tiền (đ)</th><th></th></tr></thead>
                        <tbody>
                            @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-3">Chưa có khoản nào trong kỳ.</td></tr> }
                            @foreach (var e in Model)
                            {
                                <tr data-id="@e.Id">
                                    <td>@e.EntryDate.ToString("dd/MM/yyyy")</td>
                                    <td>@FinanceCategories.Label(e.Category)@if (e.RefType != null && e.RefType != FinanceRefTypes.Commission) { <span class="badge bg-light text-dark ms-1">tự động</span> }</td>
                                    <td>@e.Description@if (e.CungUngId.HasValue && names.TryGetValue(e.CungUngId.Value, out var nn)) { <div class="text-muted">@nn</div> }</td>
                                    <td class="text-end @(e.Direction == 1 ? "text-success" : "text-danger")">@(e.Direction == 1 ? "+" : "−")@e.Amount.ToString("N0")</td>
                                    <td class="text-center">@if (e.RefType is null or FinanceRefTypes.Commission) { <a href="#" class="text-danger btn-del-entry" title="Xóa"><i class="fas fa-trash"></i></a> }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var token = $('input[name="__RequestVerificationToken"]').first().val() || '';
    function bind(id, action, reload) {
        $(id).on('submit', function (e) {
            e.preventDefault();
            var data = $(this).serializeArray(); data.push({ name: '__RequestVerificationToken', value: token });
            $.post(action, $.param(data), function (r) {
                if (r.success) { if (r.message) toastr.success(r.message); setTimeout(function () { location.reload(); }, 500); }
                else toastr.error(r.message);
            });
        });
    }
    bind('#ratesForm', '@Url.Action("SaveRates", "FinanceAdmin", new { area = "Cms" })');
    bind('#commissionForm', '@Url.Action("AddCommission", "FinanceAdmin", new { area = "Cms" })');
    bind('#entryForm', '@Url.Action("AddEntry", "FinanceAdmin", new { area = "Cms" })');
    $(document).on('click', '.btn-del-entry', function (e) {
        e.preventDefault();
        if (!confirm('Xóa khoản này?')) return;
        $.post('@Url.Action("DeleteEntry", "FinanceAdmin", new { area = "Cms" })', { id: $(this).closest('tr').data('id'), __RequestVerificationToken: token },
            function (r) { if (r.success) location.reload(); else toastr.error(r.message); });
    });
})();
</script>
}
