@model TechExchangeApp.Areas.Cms.Models.SysFuncPermissionMatrixVm
@{
    ViewData["Title"] = "Phân quyền theo nhóm";
}

<div class="card card-outline card-primary shadow-sm mb-3">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-user-lock me-1"></i> Chọn nhóm quyền</h3>
    </div>
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label fw-semibold small mb-1">Nhóm quyền (Role)</label>
                <select name="roleId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- Chọn nhóm quyền để phân quyền --</option>
                    @foreach (var r in Model.Roles)
                    {
                        <option value="@r.RoleId" selected="@(Model.SelectedRoleId == r.RoleId)">#@r.RoleId — @r.Title</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <span class="small text-muted">
                    Tick ô để cấp quyền thao tác một <strong>tính năng</strong> khi nội dung ở một <strong>trạng thái</strong>.
                    Cột <em>Chung</em> dành cho tính năng không theo trạng thái.
                </span>
            </div>
        </form>
    </div>
</div>

@if (Model.SelectedRoleId.HasValue)
{
    <form asp-action="Save" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="roleId" value="@Model.SelectedRoleId" />

        <div class="card card-outline card-info shadow-sm">
            <div class="card-header d-flex align-items-center flex-wrap gap-2">
                <h3 class="card-title mb-0">
                    <i class="fas fa-table-cells me-1"></i> Ma trận quyền — <span class="text-primary">@Model.SelectedRoleTitle</span>
                </h3>
                <div class="ms-auto d-flex gap-2">
                    <a asp-area="Cms" asp-controller="RoleAdmin" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-arrow-left me-1"></i> Danh sách nhóm
                    </a>
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="fas fa-save me-1"></i> Lưu phân quyền
                    </button>
                </div>
            </div>
            <div class="card-body table-responsive p-0" style="max-height:70vh;overflow:auto">
                <table class="table table-hover table-sm table-bordered align-middle mb-0">
                    <thead class="table-light" style="position:sticky;top:0;z-index:1">
                        <tr>
                            <th style="min-width:70px">ID</th>
                            <th style="min-width:260px">Tính năng</th>
                            @foreach (var col in Model.StatusColumns)
                            {
                                <th class="text-center" style="width:90px">
                                    <div>@col.Title</div>
                                    <input type="checkbox" class="form-check-input col-toggle" data-status="@col.StatusId"
                                           title="Chọn/bỏ cả cột" />
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td class="text-muted">#@row.FunctionId</td>
                            <td>
                                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(row.HrefName) ? row.FunctionName : row.HrefName)</div>
                                <div class="small text-muted">
                                    <span class="font-monospace">@row.FunctionName</span>
                                    @if (!string.IsNullOrWhiteSpace(row.URL))
                                    {
                                        <span class="font-monospace"> · @row.URL</span>
                                    }
                                </div>
                            </td>
                            @foreach (var col in Model.StatusColumns)
                            {
                                // Chung (0) chỉ áp dụng cho tính năng KHÔNG theo trạng thái.
                                // Các trạng thái (1..4) chỉ áp dụng cho tính năng theo trạng thái.
                                var applicable = col.StatusId == 0 ? !row.IsStatusBased : row.IsStatusBased;
                                <td class="text-center">
                                    @if (applicable)
                                    {
                                        <input type="checkbox" class="form-check-input perm-box" data-status="@col.StatusId"
                                               name="granted" value="@row.FunctionId:@col.StatusId"
                                               checked="@row.GrantedStatusIds.Contains(col.StatusId)" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-transparent">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fas fa-save me-1"></i> Lưu phân quyền
                </button>
            </div>
        </div>
    </form>
}
else
{
    <div class="alert alert-info">
        <i class="fas fa-circle-info me-1"></i> Hãy chọn một nhóm quyền ở trên để bắt đầu phân quyền.
    </div>
}

@section Scripts {
<script>
$(function () {
    // Tick/bỏ cả cột theo trạng thái
    $(document).on('change', '.col-toggle', function () {
        var status = $(this).data('status');
        var checked = this.checked;
        $('.perm-box[data-status="' + status + '"]:not(:disabled)').prop('checked', checked);
    });
});
</script>
}
