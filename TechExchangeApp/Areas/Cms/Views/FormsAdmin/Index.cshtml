@model List<TechExchangeApp.Areas.Cms.Controllers.FormAdminRow>
@{
    ViewData["Title"] = "Biểu mẫu";
}

<div class="card card-outline card-primary shadow-sm">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-list-check me-1"></i> Mẫu đăng ký / biểu mẫu</h3>
        <div class="card-tools"><a href="@Url.Action("Edit", "FormsAdmin", new { area = "Cms" })" class="btn btn-sm btn-primary"><i class="fas fa-plus"></i> Tạo biểu mẫu</a></div>
    </div>
    <div class="card-body">
        <table class="table table-sm table-hover table-bordered align-middle small mb-0">
            <thead class="table-light"><tr><th>Tiêu đề</th><th>Đường dẫn công khai</th><th class="text-center">Ngôn ngữ</th><th class="text-center">Lượt gửi</th><th>Gửi gần nhất</th><th class="text-center">Bật</th><th class="text-center" style="width:110px"></th></tr></thead>
            <tbody>
                @if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted">Chưa có biểu mẫu.</td></tr> }
                @foreach (var f in Model)
                {
                    var url = (f.LanguageId == 2 ? "/en/form/" : "/bieu-mau/") + f.Slug;
                    <tr>
                        <td class="fw-semibold">@f.Title</td>
                        <td><a href="@url" target="_blank">@url</a></td>
                        <td class="text-center">@(f.LanguageId == 2 ? "EN" : "VI")</td>
                        <td class="text-center">@f.Submissions</td>
                        <td>@(f.LastSubmission?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                        <td class="text-center">@(f.IsActive ? "✓" : "")</td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm">
                                <a href="@Url.Action("Edit", "FormsAdmin", new { area = "Cms", id = f.Id })" class="btn btn-outline-primary" title="Sửa"><i class="fas fa-pen"></i></a>
                                <a href="@Url.Action("Submissions", "FormsAdmin", new { area = "Cms", id = f.Id })" class="btn btn-outline-success" title="Dữ liệu đã gửi"><i class="fas fa-table"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
