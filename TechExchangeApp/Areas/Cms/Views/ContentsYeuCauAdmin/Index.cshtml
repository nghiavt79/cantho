@model List<TechExchangeApp.Areas.Cms.Models.ContentsYeuCauListItemVm>
@{
    ViewData["Title"] = "Quản lý nhu cầu công khai";
}

<div class="card card-outline card-primary shadow-sm mb-3">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-search me-1"></i> Tìm kiếm nhu cầu công khai</h3>
    </div>
    <div class="card-body">
        <form id="searchForm">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold small mb-1">Từ khóa</label>
                    <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control form-control-sm"
                           placeholder="Tiêu đề, nội dung, mô tả, từ khóa hoặc mã ID" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold small mb-1">Trạng thái</label>
                    <select name="statusId" class="form-select form-select-sm">
                        <option value="">-- Tất cả --</option>
                        @{
                            var selectedStatus = ViewBag.StatusId?.ToString() ?? "";
                            var statuses = (IEnumerable<dynamic>?)ViewBag.Statuses;
                        }
                        @if (statuses != null)
                        {
                            foreach (var s in statuses)
                            {
                                <option value="@s.StatusId" selected="@(selectedStatus == s.StatusId.ToString())">@s.Title</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold small mb-1">Nguồn</label>
                    @{
                        var selectedSource = (string?)ViewBag.Source ?? "";
                    }
                    <select name="source" class="form-select form-select-sm">
                        <option value="">-- Tất cả --</option>
                        <option value="phieu" selected="@(selectedSource == "phieu")">Phiếu người dùng</option>
                        <option value="cms" selected="@(selectedSource == "cms")">CMS</option>
                        <option value="unknown" selected="@(selectedSource == "unknown")">Cũ/chưa xác định</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold small mb-1">Sàn GDCN</label>
                    @{
                        var currentSiteId = (int)(ViewBag.CurrentSiteId ?? 0);
                        var selectedSite = ViewBag.SiteId?.ToString() ?? "";
                        var sites = (IEnumerable<TechExchangeApp.Entities.RootSite>?)ViewBag.Sites;
                    }
                    <select name="siteId" class="form-select form-select-sm" @(currentSiteId > 1 ? "disabled" : "")>
                        <option value="">-- Theo cấu hình --</option>
                        @if (sites != null)
                        {
                            foreach (var s in sites)
                            {
                                <option value="@s.SiteId" selected="@(selectedSite == s.SiteId.ToString())">@s.SiteName</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="fas fa-search me-1"></i> Tìm
                    </button>
                    <button type="button" id="btnReset" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-undo"></i>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card card-outline card-info shadow-sm">
    <div class="card-header d-flex align-items-center flex-wrap gap-2">
        <h3 class="card-title">
            <i class="fas fa-bullhorn me-1"></i> Danh sách nhu cầu công khai
            <span class="badge bg-info ms-1" id="badgeTotal">@ViewBag.TotalCount</span>
        </h3>
        <div class="ms-auto">
            <a asp-area="Cms" asp-controller="ContentsYeuCauAdmin" asp-action="Create" class="btn btn-primary btn-sm">
                <i class="fas fa-plus me-1"></i> Tạo mới
            </a>
        </div>
    </div>
    <div id="listContainer">
        @await Html.PartialAsync("_ListPartial", Model)
    </div>
</div>

@section Scripts {
<script>
$(function () {
    toastr.options = { closeButton: true, progressBar: true, positionClass: 'toast-top-right', timeOut: 3000 };

    var token = $('input[name="__RequestVerificationToken"]').val() || '';
    var baseUrl = '@Url.Action("Index", "ContentsYeuCauAdmin", new { area = "Cms" })';
    var currentPage = 1;

    function loadList(page) {
        currentPage = page || 1;
        var params = $('#searchForm').serialize()
            + '&page=' + currentPage
            + '&pageSize=' + encodeURIComponent($('.ajax-page-size').val() || '20');
        $('#listContainer').css('opacity', '0.5');
        $.ajax({
            url: baseUrl,
            data: params,
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            success: function (html) {
                $('#listContainer').html(html).css('opacity', '1');
                $('#badgeTotal').text($('#partialTotalCount').text());
            },
            error: function () {
                toastr.error('Không tải được dữ liệu.');
                $('#listContainer').css('opacity', '1');
            }
        });
    }

    $('#searchForm').on('submit', function (e) {
        e.preventDefault();
        loadList(1);
    });

    $('#btnReset').on('click', function () {
        $('#searchForm')[0].reset();
        loadList(1);
    });

    $(document).on('click', '.ajax-page', function (e) {
        e.preventDefault();
        if ($(this).closest('.page-item').hasClass('disabled') || $(this).closest('.page-item').hasClass('active')) return;
        loadList($(this).data('page'));
    });

    $(document).on('change', '.ajax-page-size', function () {
        loadList(1);
    });

    $(document).on('click', '.btn-toggle-publish', function (e) {
        e.preventDefault();
        $.post('@Url.Action("TogglePublish", "ContentsYeuCauAdmin", new { area = "Cms" })',
            { id: $(this).data('id'), __RequestVerificationToken: token },
            function (r) {
                if (r.success) {
                    toastr.success(r.message);
                    loadList(currentPage);
                } else {
                    toastr.error(r.message);
                }
            });
    });
});
</script>
}
