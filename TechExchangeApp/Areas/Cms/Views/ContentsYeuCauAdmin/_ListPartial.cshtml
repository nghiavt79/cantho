@model List<TechExchangeApp.Areas.Cms.Models.ContentsYeuCauListItemVm>
@{
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var page = (int)(ViewBag.Page ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 20);
}

<span id="partialTotalCount" class="d-none">@totalCount</span>

<div class="card-body p-0">
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:120px">Thao tác</th>
                    <th style="width:55px" class="text-center">STT</th>
                    <th style="min-width:280px">Tiêu đề nhu cầu</th>
                    <th style="width:160px">Lĩnh vực</th>
                    <th style="width:150px">Tỉnh/thành</th>
                    <th style="width:150px">Tác giả/nguồn</th>
                    <th style="width:130px">Trạng thái</th>
                    <th style="width:135px">Nguồn dữ liệu</th>
                    <th style="width:115px">Ngày tạo</th>
                    <th style="width:115px">Cập nhật</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center py-5 text-muted">
                            <i class="fas fa-inbox fa-3x mb-3 d-block opacity-25"></i>
                            Không có nhu cầu công khai nào.
                        </td>
                    </tr>
                }
                else
                {
                    var stt = (page - 1) * pageSize;
                    foreach (var item in Model)
                    {
                        stt++;
                        var isPublished = item.StatusId == 3;
                        var statusClass = item.StatusId switch
                        {
                            3 => "bg-success",
                            2 => "bg-info",
                            1 => "bg-warning",
                            4 => "bg-danger",
                            _ => "bg-secondary"
                        };
                        <tr>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a class="btn btn-outline-primary" asp-area="Cms" asp-controller="ContentsYeuCauAdmin"
                                       asp-action="Edit" asp-route-id="@item.Id" title="Sửa">
                                        <i class="fas fa-pen"></i>
                                    </a>
                                    <button type="button" class="btn @(isPublished ? "btn-outline-warning" : "btn-outline-success") btn-toggle-publish"
                                            data-id="@item.Id" title="@(isPublished ? "Ẩn khỏi sàn" : "Đăng lên sàn")">
                                        <i class="fas @(isPublished ? "fa-eye-slash" : "fa-upload")"></i>
                                    </button>
                                    <a class="btn btn-outline-secondary" href="@item.PublicUrl" target="_blank" title="Xem public">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </div>
                            </td>
                            <td class="text-center text-muted small">@stt</td>
                            <td>
                                <div class="fw-semibold">@item.Title</div>
                                <small class="text-muted">#@item.Id · @item.QueryString</small>
                            </td>
                            <td class="small">@(item.LinhVucText ?? "—")</td>
                            <td class="small">@(item.DiaPhuong ?? "—")</td>
                            <td class="small">@(item.Author ?? "—")</td>
                            <td><span class="badge @statusClass">@(item.StatusTitle ?? "—")</span></td>
                            <td class="small">
                                @item.SourceLabel
                                @if (item.PhieuYeuCauCNTBId.HasValue)
                                {
                                    <div class="text-muted">Phiếu #@item.PhieuYeuCauCNTBId</div>
                                }
                            </td>
                            <td class="small text-muted">@(item.Created?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td class="small text-muted">@(item.Modified?.ToString("dd/MM/yyyy") ?? "—")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card-footer d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div class="d-flex align-items-center flex-wrap gap-2">
        <small class="text-muted">
            Hiển thị <strong>@(totalCount == 0 ? 0 : ((page - 1) * pageSize + 1))</strong>-<strong>@Math.Min(page * pageSize, totalCount)</strong> / <strong>@totalCount</strong> bản ghi
        </small>
        <div class="d-flex align-items-center gap-1">
            <span class="small text-muted">mỗi trang</span>
            <select class="form-select form-select-sm ajax-page-size" style="width:78px">
                <option value="10" selected="@(pageSize == 10)">10</option>
                <option value="20" selected="@(pageSize == 20)">20</option>
                <option value="50" selected="@(pageSize == 50)">50</option>
                <option value="100" selected="@(pageSize == 100)">100</option>
            </select>
        </div>
    </div>
    @if (totalPages > 1)
    {
        <nav>
            <ul class="pagination pagination-sm mb-0">
                @{
                    var startP = Math.Max(1, page - 4);
                    var endP = Math.Min(totalPages, page + 4);
                }
                <li class="page-item @(page == 1 ? "disabled" : "")">
                    <a class="page-link ajax-page" href="#" data-page="1" title="Trang đầu"><i class="fas fa-angles-left"></i></a>
                </li>
                <li class="page-item @(page == 1 ? "disabled" : "")">
                    <a class="page-link ajax-page" href="#" data-page="@(page - 1)" title="Trang trước"><i class="fas fa-angle-left"></i></a>
                </li>
                @for (var i = startP; i <= endP; i++)
                {
                    <li class="page-item @(i == page ? "active" : "")">
                        <a class="page-link ajax-page" data-page="@i" href="#">@i</a>
                    </li>
                }
                <li class="page-item @(page >= totalPages ? "disabled" : "")">
                    <a class="page-link ajax-page" href="#" data-page="@(page + 1)" title="Trang sau"><i class="fas fa-angle-right"></i></a>
                </li>
                <li class="page-item @(page >= totalPages ? "disabled" : "")">
                    <a class="page-link ajax-page" href="#" data-page="@totalPages" title="Trang cuối"><i class="fas fa-angles-right"></i></a>
                </li>
            </ul>
        </nav>
    }
</div>
