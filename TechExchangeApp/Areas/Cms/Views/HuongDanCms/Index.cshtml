            border-radius: 8px;
            background: #fbfdff;
        }

        .cms-guide-figure svg {
            display: block;
            min-width: 660px;
            max-width: 100%;
            height: auto;
            margin: 0 auto;
        }

        .cms-guide-figure figcaption {
            margin-top: 10px;
