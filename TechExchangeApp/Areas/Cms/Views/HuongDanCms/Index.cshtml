            --guide-ink: #172033;
            --guide-muted: #637083;
        }

        .cms-guide-toc {
            top: 84px;
            border: 1px solid var(--guide-border);
        }

        .cms-guide-toc .list-group-item {
            display: flex;
            gap: 10px;
            align-items: center;
            color: var(--guide-ink);
            font-weight: 600;
        }

        .cms-guide-toc .list-group-item i {
            width: 18px;
            color: #2563eb;
        }

        .cms-guide-hero {
            display: flex;
            justify-content: space-between;
            gap: 24px;
            align-items: center;
            margin-bottom: 24px;
            padding: 28px;
