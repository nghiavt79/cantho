                                <text x="763" y="92" font-size="12" fill="#637083">Khách nhìn thấy</text>

                                <line x1="186" y1="77" x2="232" y2="77" stroke="#64748b" stroke-width="1.6" marker-end="url(#gArrow)" />
                                <line x1="408" y1="77" x2="454" y2="77" stroke="#64748b" stroke-width="1.6" marker-end="url(#gArrow)" />
                                <line x1="630" y1="77" x2="676" y2="77" stroke="#64748b" stroke-width="1.6" marker-end="url(#gArrow)" />

