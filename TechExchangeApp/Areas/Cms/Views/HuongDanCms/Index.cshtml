            border-radius: 8px;
            background: linear-gradient(135deg, #ffffff, #eef6ff);
        }

        .cms-guide-eyebrow {
            display: inline-flex;
            margin-bottom: 8px;
            color: #2563eb;
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .cms-guide-hero h2 {
            margin: 0 0 10px;
            color: var(--guide-ink);
            font-size: 28px;
            font-weight: 800;
        }

        .cms-guide-hero p {
            max-width: 760px;
            margin: 0;
            color: var(--guide-muted);
            font-size: 15px;
        }

        .cms-guide-hero-icon {
            display: grid;
            width: 82px;
            height: 82px;
            flex: 0 0 auto;
            place-items: center;
            border-radius: 8px;
            background: #2563eb;
            color: #fff;
            font-size: 34px;
        }

        .cms-guide-section {
            margin-bottom: 24px;
            border: 1px solid var(--guide-border);
            border-radius: 8px;
        }

        .cms-guide-section h3 {
            display: flex;
            gap: 10px;
            align-items: center;
            margin: 0 0 18px;
            color: var(--guide-ink);
            font-size: 22px;
            font-weight: 800;
        }

        .cms-guide-section h3 i {
            color: #2563eb;
        }

        /* Khung sơ đồ: SVG nội tuyến, không phụ thuộc thư viện ngoài.
           Màn hình hẹp thì cuộn ngang trong khung thay vì bóp méo hình. */
        .cms-guide-figure {
            margin: 0 0 18px;
            padding: 16px;
