@model List<TechExchangeApp.Areas.Cms.Models.SystemParameterListItemVm>
@{
    var page = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 20);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var fromRecord = totalCount == 0 ? 0 : ((page - 1) * pageSize) + 1;
    var toRecord = Math.Min(page * pageSize, totalCount);
}

<span id="partialTotalCount" class="d-none">@totalCount</span>

<div class="card-body table-responsive p-0">
    <table class="table table-hover table-sm align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th style="width:95px">Thao tác</th>
                <th style="width:70px">ID</th>
                <th>Name</th>
                <th style="width:110px">Type</th>
                <th>Val</th>
                <th>Val2</th>
                <th>Domain</th>
                <th style="width:80px">Site</th>
                <th style="width:100px">Trạng thái</th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="9" class="text-center text-muted py-4">Không có tham số phù hợp.</td>
            </tr>
        }
        else
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>
                        <div class="btn-group btn-group-sm">
                            <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-outline-primary" title="Sửa theo Type">
                                <i class="fas fa-pen"></i>
                            </a>
                        </div>
                    </td>
                    <td class="text-muted">#@item.ID</td>
                    <td>
                        <div class="fw-semibold">@item.Name</div>
                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <div class="small text-muted">@item.Description</div>
                        }
                    </td>
                    <td><span class="badge bg-secondary">@item.TypeLabel</span></td>
                    <td class="text-break" style="max-width:260px">@item.DisplayVal</td>
                    <td class="text-break" style="max-width:180px">@item.DisplayVal2</td>
                    <td>@item.Domain</td>
                    <td>@(item.SiteId?.ToString() ?? "Global")</td>
                    <td>
                        @if (item.Activated)
                        {
                            <span class="badge bg-success">Kích hoạt</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Tắt</span>
                        }
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
<div class="card-footer d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div class="d-flex align-items-center flex-wrap gap-2">
        <small class="text-muted">
            Hiển thị <strong>@fromRecord</strong>-<strong>@toRecord</strong> / <strong>@totalCount</strong> bản ghi
        </small>
        <div class="d-flex align-items-center gap-1">
            <span class="small text-muted">mỗi trang</span>
            <select class="form-select form-select-sm ajax-page-size" style="width:78px">
                <option value="10" selected="@(pageSize == 10)">10</option>
                <option value="20" selected="@(pageSize == 20)">20</option>
                <option value="50" selected="@(pageSize == 50)">50</option>
                <option value="100" selected="@(pageSize == 100)">100</option>
            </select>
        </div>
    </div>
    @if (totalPages > 1)
    {
        var startPage = Math.Max(1, page - 2);
        var endPage = Math.Min(totalPages, page + 2);
        <nav>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(page <= 1 ? "disabled" : "")">
                    <a class="page-link ajax-page" href="#" data-page="1" title="Trang đầu"><i class="fas fa-angles-left"></i></a>
                </li>
                <li class="page-item @(page <= 1 ? "disabled" : "")">
                    <a class="page-link ajax-page" href="#" data-page="@(page - 1)" title="Trang trước"><i class="fas fa-angle-left"></i></a>
                </li>
                @for (var i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == page ? "active" : "")">
                        <a class="page-link ajax-page" data-page="@i" href="#">@i</a>
                    </li>
                }
                <li class="page-item @(page >= totalPages ? "disabled" : "")">
                    <a class="page-link ajax-page" href="#" data-page="@(page + 1)" title="Trang sau"><i class="fas fa-angle-right"></i></a>
                </li>
                <li class="page-item @(page >= totalPages ? "disabled" : "")">
                    <a class="page-link ajax-page" href="#" data-page="@totalPages" title="Trang cuối"><i class="fas fa-angles-right"></i></a>
                </li>
            </ul>
        </nav>
    }
</div>
