@model List<TechExchangeApp.Areas.Cms.Controllers.SanPhamCNTBListItem>
@{
    ViewData["Title"] = "Quản lý Công nghệ";
    var actionName = "CongNghe";
}

@await Html.PartialAsync("_ListLayout", new ViewDataDictionary(ViewData) {
    { "ActionName", actionName },
    { "PageTitle", "Công nghệ" },
    { "AddLabel", "Thêm công nghệ" }
})

@section Scripts {
<script>
$(function(){

    // Select2 for filter dropdowns
    $('#filterNcu').select2({ theme: 'bootstrap-5', placeholder: '-- Tìm nhà cung ứng --', allowClear: true, width: '100%' });
    $('#filterXuatXu').select2({ theme: 'bootstrap-5', placeholder: '-- Tìm xuất xứ --', allowClear: true, width: '100%' });
    $('#filterSiteId').select2({ theme: 'bootstrap-5', placeholder: '-- Chọn sàn --', allowClear: true, width: '100%' });

    // Export Excel: send current filters, productType = 1 (CongNghe)
    $('#btnExportExcel').on('click', function () {
        var params = $('#searchForm').serialize() + '&productType=1';
        window.location = '@Url.Action("ExportExcel", "SanPhamCNTB", new { area = "Cms" })?' + params;
    });

    toastr.options = { closeButton: true, progressBar: true, positionClass: 'toast-top-right', timeOut: 3000 };

    var token = $('input[name="__RequestVerificationToken"]').val() || '';
    var currentLanguageId = @((int)(ViewBag.LanguageId ?? 1));
    var baseUrl = '@Url.Action(actionName, "SanPhamCNTB", new { area = "Cms" })';
    var currentPage = 1, currentSortBy = '', currentSortDir = '';

    // Double-click toggle search card
    $('#searchCardHeader').on('dblclick', function() {
        $(this).find('[data-lte-toggle="card-collapse"]').trigger('click');
    });

    // Load list via AJAX
    function loadList(page) {
        currentPage = page || 1;
        var params = $('#searchForm').serialize()
            + '&page=' + currentPage
            + '&sortBy=' + encodeURIComponent(currentSortBy)
            + '&sortDir=' + encodeURIComponent(currentSortDir);
        $('#listContainer').css('opacity', '0.5');
        $.ajax({
            url: baseUrl, data: params,
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            success: function(html) {
                $('#listContainer').html(html).css('opacity', '1');
                $('#chkAll').prop('checked', false);
                $('#btnBulkDelete').prop('disabled', true);
                $('#btnBulkTranslate').prop('disabled', true);
                var cnt = $('#partialTotalCount').text();
                $('#badgeTotal').text(cnt);
            },
            error: function() {
                toastr.error('Lỗi tải dữ liệu.');
                $('#listContainer').css('opacity', '1');
            }
        });
    }

    // Sort
    $(document).on('click', '.sortable', function() {
        var col = $(this).data('sort');
        if (currentSortBy === col) currentSortDir = (currentSortDir === 'asc') ? 'desc' : 'asc';
        else { currentSortBy = col; currentSortDir = 'asc'; }
        loadList(1);
    });

    // Search
    $('#searchForm').on('submit', function(e) { e.preventDefault(); loadList(1); });
    $('#btnSearch').on('click', function() { loadList(1); });
    $('#btnReset').on('click', function() {
        $('#searchForm')[0].reset();
        $('#filterNcu').val('').trigger('change');
        $('#filterXuatXu').val('').trigger('change');
        $('#filterSiteId').val('').trigger('change');
        currentSortBy = ''; currentSortDir = '';
        loadList(1);
    });

    // Pagination
    $(document).on('click', '.ajax-page', function(e) {
        e.preventDefault();
        if ($(this).closest('.page-item').hasClass('disabled') || $(this).closest('.page-item').hasClass('active')) return;
        loadList($(this).data('page'));
    });

    // Checkbox + Bulk Delete
    $(document).on('change', '#chkAll', function() { $('.chkRow:not(:disabled)').prop('checked', this.checked); toggleBulk(); });
    $(document).on('change', '.chkRow', toggleBulk);
    function toggleBulk() {
        var checked = $('.chkRow:checked');
        var canDelete = checked.filter(function(){ return $(this).data('can-delete') == 1; }).length > 0;
        $('#btnBulkDelete').prop('disabled', !canDelete);
        var canTranslate = currentLanguageId === 1 && checked.length > 0;
        $('#btnBulkTranslate').prop('disabled', !canTranslate);
    }

    // Delete single
    $(document).on('click', '.btn-del', function(e) {
        e.preventDefault();
        var id = $(this).data('id');
        Swal.fire({
            title: 'Xác nhận xóa?', text: 'Bạn chắc chắn muốn xóa sản phẩm #' + id + '?',
            icon: 'warning', showCancelButton: true,
            confirmButtonColor: '#d33', cancelButtonColor: '#6c757d',
            confirmButtonText: '<i class="fas fa-trash"></i> Xóa', cancelButtonText: 'Hủy'
        }).then(function(result) {
            if (result.isConfirmed) {
                $.post('@Url.Action("Delete", "SanPhamCNTB", new { area = "Cms" })',
                    { id: id, __RequestVerificationToken: token },
                    function(r) {
                        if (r.success) { toastr.success(r.message); loadList(currentPage); }
                        else { toastr.error(r.message); }
                    });
            }
        });
    });

    // Quick Config
    $(document).on('click', '.btn-config', function(e) {
        e.preventDefault();
        var id = $(this).data('id');
        $('#configModalBody').html('<div class="text-center py-4"><i class="fas fa-spinner fa-spin fa-2x"></i></div>');
        $('#configModal').modal('show');
        $.get('@Url.Action("QuickConfig", "SanPhamCNTB", new { area = "Cms" })', { id: id }, function(html) {
            $('#configModalBody').html(html);
        });
        $('#btnSaveConfig').off('click').on('click', function() {
            var formData = $('#quickConfigForm').serialize() + '&__RequestVerificationToken=' + encodeURIComponent(token);
            $.post('@Url.Action("QuickConfig", "SanPhamCNTB", new { area = "Cms" })', formData, function(r) {
                if (r.success) { toastr.success(r.message); $('#configModal').modal('hide'); loadList(currentPage); }
                else { toastr.error(r.message); }
            });
        });
    });

    // Bulk delete
    $('#btnBulkTranslate').on('click', function() {
        var ids = $('.chkRow:checked').map(function() { return $(this).val(); }).get();
        if (currentLanguageId !== 1) { toastr.warning('Chỉ có thể dịch từ bản Tiếng Việt.'); return; }
        if (!ids.length) return;
        Swal.fire({
            title: 'Dịch sang tiếng Anh?', text: 'Tạo bản EN cho ' + ids.length + ' sản phẩm? (bỏ qua mục đã có bản EN)',
            icon: 'question', showCancelButton: true,
            confirmButtonText: '<i class="fas fa-language"></i> Dich', cancelButtonText: 'Huy'
        }).then(function(result) {
            if (!result.isConfirmed) return;
            var $btn = $('#btnBulkTranslate').prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Dang dich...');
            $.ajax({
                url: '@Url.Action("BulkTranslateProducts", "TranslationAdmin", new { area = "Cms" })',
                type: 'POST', traditional: true, data: { ids: ids, __RequestVerificationToken: token }
            }).done(function(res) {
                if (res && res.needManual && res.redirectUrl) { window.location = res.redirectUrl; return; }
                if (res && res.ok) toastr.success(res.message + ' (' + res.provider + ')');
                else toastr.error((res && res.message) || 'L\u1ed7i d\u1ecbch.');
                loadList(currentPage);
            }).fail(function() { toastr.error('Loi goi dich.'); })
              .always(function() { $btn.html('<i class="fas fa-language me-1"></i> Dịch sang tiếng Anh'); });
        });
    });
    $('#btnBulkDelete').on('click', function() {
        var ids = $('.chkRow:checked[data-can-delete="1"]').map(function() { return $(this).val(); }).get();
        if (!ids.length) return;
        Swal.fire({
            title: 'Xóa nhiều sản phẩm?', text: 'Bạn chắc chắn xóa ' + ids.length + ' sản phẩm đã chọn?',
            icon: 'warning', showCancelButton: true,
            confirmButtonColor: '#d33', cancelButtonColor: '#6c757d',
            confirmButtonText: '<i class="fas fa-trash"></i> Xóa tất cả', cancelButtonText: 'Hủy'
        }).then(function(result) {
            if (result.isConfirmed) {
                var promises = ids.map(function(id) {
                    return $.post('@Url.Action("Delete", "SanPhamCNTB", new { area = "Cms" })',
                        { id: id, __RequestVerificationToken: token });
                });
                $.when.apply($, promises).then(function() {
                    toastr.success('Đã xóa ' + ids.length + ' sản phẩm.');
                    loadList(currentPage);
                });
            }
        });
    });


    // Translate one product from the row action, matching Cms/Posts fallback behavior.
    $(document).on('click', '.btn-translate', function() {
        var id = $(this).data('id');
        if (currentLanguageId !== 1) { toastr.warning('Ch\u1ec9 c\u00f3 th\u1ec3 d\u1ecbch t\u1eeb b\u1ea3n Ti\u1ebfng Vi\u1ec7t.'); return; }
        var $btn = $(this).prop('disabled', true);
        var old = $btn.html();
        $btn.html('<i class="fas fa-spinner fa-spin"></i>');
        $.ajax({
            url: '@Url.Action("BulkTranslateProducts", "TranslationAdmin", new { area = "Cms" })',
            type: 'POST', traditional: true,
            data: { ids: [id], __RequestVerificationToken: token }
        }).done(function(res) {
            if (res && res.needManual && res.redirectUrl) { window.location = res.redirectUrl; return; }
            if (res && res.ok && res.created > 0) toastr.success('\u0110\u00e3 t\u1ea1o b\u1ea3n EN. (' + res.provider + ')');
            else if (res && res.ok && res.skipped > 0) toastr.info('S\u1ea3n ph\u1ea9m n\u00e0y \u0111\u00e3 c\u00f3 b\u1ea3n EN.');
            else toastr.error((res && res.message) || 'L\u1ed7i d\u1ecbch.');
            loadList(currentPage);
        }).fail(function() {
            toastr.error('L\u1ed7i g\u1ecdi d\u1ecbch.');
            $btn.prop('disabled', false).html(old);
        });
    });

});
</script>
}



