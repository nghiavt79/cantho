@model TechExchangeApp.Areas.Cms.Controllers.SupportThreadVm
@{
    ViewData["Title"] = "Xử lý yêu cầu hỗ trợ/tư vấn";
    string StatusText(int s) => s switch
    {
        1 => "Mới tiếp nhận",
        2 => "Đã phân công",
        3 => "Đang xử lý",
        4 => "Chờ doanh nghiệp bổ sung",
        5 => "Đã phản hồi",
        6 => "Đã hoàn thành",
        7 => "Đã hủy",
        _ => "-"
    };
    string RequestTypeText(int t) => t == 2 ? "Tư vấn giao dịch/chuyển giao" : "Hỗ trợ sử dụng hệ thống";
    string ServiceTypeText(int? t) => t switch
    {
        1 => "Tìm kiếm, lựa chọn nhà cung cấp",
        2 => "Đánh giá hồ sơ đề xuất",
        3 => "Tư vấn đàm phán thương mại",
        4 => "Kiểm tra pháp lý hợp đồng",
        5 => "Hỗ trợ hợp đồng điện tử",
        99 => "Khác",
        _ => "-"
    };
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h3 class="mb-0"><i class="fas fa-headset me-2"></i>REQ-@Model.Id</h3>
            </div>
            <div class="col-sm-6 text-end">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="fas fa-arrow-left"></i> Danh sách</a>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <div class="card mb-3">
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-md-4"><strong>Hồ sơ:</strong> @Model.ProjectName</div>
                    <div class="col-md-2"><strong>Bước:</strong> @(Model.StepNumber?.ToString() ?? "-")</div>
                    <div class="col-md-3"><strong>Người gửi:</strong> @Model.RequesterName</div>
                    <div class="col-md-3"><strong>Phụ trách:</strong> @(Model.AssignedStaffName ?? "Chưa gán")</div>
                    <div class="col-md-4"><strong>Loại yêu cầu:</strong> @RequestTypeText(Model.RequestType)</div>
                    <div class="col-md-4"><strong>Dịch vụ:</strong> @ServiceTypeText(Model.ServiceType)</div>
                    <div class="col-md-4"><strong>Trạng thái:</strong> @StatusText(Model.TicketStatus)</div>
                    <div class="col-12"><strong>Tiêu đề:</strong> @(Model.Subject ?? "-")</div>
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <div class="col-12"><strong>Nội dung ban đầu:</strong> <span style="white-space:pre-wrap">@Model.Description</span></div>
                    }
                </div>
            </div>
        </div>

        @if (Model.TicketStatus != 6 && Model.TicketStatus != 7)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <form asp-action="ChangeStatus" method="post" class="row g-2 align-items-end mb-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="col-md-6">
                            <label class="form-label mb-1"><i class="fas fa-list-check me-1"></i>Trạng thái xử lý</label>
                            <select name="status" class="form-select">
                                <option value="1" selected="@(Model.TicketStatus == 1)">Mới tiếp nhận</option>
                                <option value="2" selected="@(Model.TicketStatus == 2)">Đã phân công</option>
                                <option value="3" selected="@(Model.TicketStatus == 3)">Đang xử lý</option>
                                <option value="4" selected="@(Model.TicketStatus == 4)">Chờ doanh nghiệp bổ sung</option>
                                <option value="5" selected="@(Model.TicketStatus == 5)">Đã phản hồi</option>
                                <option value="6" selected="@(Model.TicketStatus == 6)">Đã hoàn thành</option>
                                <option value="7" selected="@(Model.TicketStatus == 7)">Đã hủy</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-outline-primary w-100"><i class="fas fa-save"></i> Cập nhật trạng thái</button>
                        </div>
                    </form>
                    <div class="row g-2 align-items-end">
                        <div class="col-md-7">
                            <form asp-action="Assign" method="post" class="d-flex gap-2 align-items-end">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <div class="flex-grow-1">
                                    <label class="form-label mb-1"><i class="fas fa-user-tag me-1"></i>Gán cho nhân viên / tư vấn</label>
                                    <select name="staffUserId" class="form-select" required>
                                        <option value="">-- Chọn nhân viên/tư vấn --</option>
                                        @foreach (var s in Model.StaffOptions)
                                        {
                                            <option value="@s.UserId" selected="@(Model.AssignedStaffUserId == s.UserId)">@s.Name</option>
                                        }
                                    </select>
                                </div>
                                <button type="submit" class="btn btn-outline-primary"><i class="fas fa-user-check"></i> Gán</button>
                            </form>
                        </div>
                        <div class="col-md-5 text-md-end">
                            <form asp-action="Close" method="post" onsubmit="return confirm('Đóng yêu cầu này?');" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn btn-outline-secondary"><i class="fas fa-check-circle"></i> Hoàn thành</button>
                            </form>
                            <form asp-action="Close" method="post" onsubmit="return confirm('Hủy yêu cầu này?');" class="d-inline ms-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="status" value="7" />
                                <button type="submit" class="btn btn-outline-danger"><i class="fas fa-ban"></i> Hủy</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="card">
            <div class="card-header"><i class="fas fa-comments me-1"></i> Nội dung trao đổi</div>
            <div class="card-body" style="max-height:480px; overflow-y:auto; background:#f8fafc;">
                @if (Model.Messages.Any())
                {
                    @foreach (var m in Model.Messages)
                    {
                        <div class="mb-3">
                            <div class="small text-secondary mb-1">
                                <strong>@m.SenderName</strong>
                                <span class="ms-2">@m.Created.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <div class="p-2 rounded border bg-white">
                                @if (m.IsSystem)
                                {
                                    <em>@Html.Raw(m.Message)</em>
                                }
                                else
                                {
                                    <span style="white-space:pre-wrap;">@m.Message</span>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">Chưa có tin nhắn.</p>
                }
            </div>
            <div class="card-footer">
                @if (Model.TicketStatus == 6 || Model.TicketStatus == 7)
                {
                    <div class="text-muted">Yêu cầu đã kết thúc.</div>
                }
                else
                {
                    <form asp-action="Reply" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="input-group">
                            <textarea name="message" class="form-control" rows="2" maxlength="2000"
                                      placeholder="Nhập phản hồi gửi người gửi..." required></textarea>
                            <button type="submit" class="btn btn-primary"><i class="fas fa-paper-plane"></i> Gửi</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
