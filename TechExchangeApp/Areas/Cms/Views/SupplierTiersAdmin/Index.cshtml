@model List<TechExchangeApp.Areas.Cms.Controllers.SupplierTierRow>
@using TechExchangeApp.Entities
@{
    ViewData["Title"] = "Phân hạng nhà cung cấp";
    var tiers = (List<SupplierTier>)ViewBag.Tiers;
    var tierId = (int?)ViewBag.TierId;
    var mismatch = (bool)ViewBag.Mismatch;
    SupplierTier? T(int? id) => id.HasValue ? tiers.FirstOrDefault(t => t.Id == id) : null;
}

<div class="card card-outline card-warning shadow-sm mb-3">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-medal me-1"></i> Hạng và tiêu chí xếp hạng</h3>
        <div class="card-tools"><button type="button" class="btn btn-sm btn-warning" id="btnAddTier"><i class="fas fa-plus"></i> Thêm hạng</button></div>
    </div>
    <div class="card-body">
        @Html.AntiForgeryToken()
        <table class="table table-sm table-bordered align-middle small mb-0">
            <thead class="table-light"><tr><th>Hạng</th><th class="text-center">Thứ bậc</th><th class="text-center">SP xuất bản ≥</th><th class="text-center">Lượt liên hệ ≥</th><th class="text-center">Lượt xem ≥</th><th class="text-center">Giao dịch ≥</th><th class="text-center">Doanh thu ≥ (đồng)</th><th class="text-center">Đánh giá SP ≥</th><th class="text-center">Xác minh pháp lý</th><th>Mô tả</th><th class="text-center">Dùng</th><th style="width:50px"></th></tr></thead>
            <tbody>
                @foreach (var t in tiers)
                {
                    <tr data-tier='@Json.Serialize(new { t.Id, t.Name, t.Rank, t.BadgeColor, t.MinProducts, t.MinContacts, t.MinViews, t.MinTransactions, t.MinRevenue, t.MinRating, t.RequireVerified, t.Description, t.IsActive })'>
                        <td><span class="badge" style="background:@t.BadgeColor">@t.Name</span></td>
                        <td class="text-center">@t.Rank</td>
                        <td class="text-center">@t.MinProducts</td>
                        <td class="text-center">@t.MinContacts</td>
                        <td class="text-center">@t.MinViews.ToString("N0")</td>
                        <td class="text-center">@t.MinTransactions</td>
                        <td class="text-center">@t.MinRevenue.ToString("N0")</td>
                        <td class="text-center">@t.MinRating.ToString("0.0")</td>
                        <td class="text-center">@(t.RequireVerified ? "Bắt buộc" : "—")</td>
                        <td>@t.Description</td>
                        <td class="text-center">@(t.IsActive ? "✓" : "")</td>
                        <td class="text-center"><a href="#" class="btn btn-outline-primary btn-sm py-0 btn-edit-tier"><i class="fas fa-pen"></i></a></td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="form-text">"Xác minh pháp lý" = tài khoản quản lý hồ sơ nhà cung cấp đã tải đủ giấy tờ (mức xác minh 3). Lượt liên hệ = hội thoại chat + yêu cầu đặt mua/quan tâm trên sản phẩm của nhà cung cấp. Giao dịch = đơn đặt mua chưa hủy. Doanh thu = tổng giá trị đơn đã hoàn tất hoặc đã thanh toán. Đánh giá SP = điểm trung bình (1–5 sao) người dùng chấm cho sản phẩm của nhà cung cấp.</div>
    </div>
</div>

<div class="card card-outline card-primary shadow-sm mb-3">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-building me-1"></i> Nhà cung cấp <span class="badge bg-secondary">@Model.Count</span></h3>
        <div class="card-tools"><button type="button" class="btn btn-sm btn-primary" id="btnApply"><i class="fas fa-wand-magic-sparkles"></i> Áp dụng hạng gợi ý</button></div>
    </div>
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-md-4"><input name="keyword" value="@ViewBag.Keyword" class="form-control form-control-sm" placeholder="Tên nhà cung cấp..." /></div>
            <div class="col-md-3">
                <select name="tierId" class="form-select form-select-sm">
                    <option value="">-- Mọi hạng --</option>
                    <option value="0" selected="@(tierId == 0)">Chưa xếp hạng</option>
                    @foreach (var t in tiers) { <option value="@t.Id" selected="@(tierId == t.Id)">@t.Name</option> }
                </select>
            </div>
            <div class="col-auto form-check align-self-center ms-2"><input class="form-check-input" type="checkbox" name="mismatch" value="true" id="fMis" @(mismatch ? "checked" : "") /><label class="form-check-label small" for="fMis">Chỉ NCC có hạng khác gợi ý</label></div>
            <div class="col-auto"><button class="btn btn-sm btn-primary"><i class="fas fa-search"></i> Lọc</button></div>
        </form>
        <div class="table-responsive">
            <table class="table table-sm table-hover table-bordered align-middle small mb-0">
                <thead class="table-light"><tr><th>Nhà cung cấp</th><th class="text-center">SP xuất bản</th><th class="text-center">Liên hệ</th><th class="text-center">Lượt xem</th><th class="text-center">Giao dịch</th><th class="text-end">Doanh thu</th><th class="text-center">Đánh giá</th><th class="text-center">Xác minh</th><th>Gợi ý</th><th style="width:200px">Hạng hiện tại</th></tr></thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        var cur = T(r.TierId); var sug = T(r.SuggestedTierId);
                        <tr>
                            <td>
                                <a href="@Url.Action("Edit", "NhaCungUngAdmin", new { area = "Cms", id = r.CungUngId })" class="fw-semibold text-decoration-none">@r.Name</a>
                                @if (!r.IsActivated) { <span class="badge bg-secondary ms-1">Gian hàng tắt</span> }
                            </td>
                            <td class="text-center">@r.Metrics.PublishedProducts</td>
                            <td class="text-center">@r.Metrics.Contacts</td>
                            <td class="text-center">@r.Metrics.Views.ToString("N0")</td>
                            <td class="text-center">@r.Metrics.Transactions</td>
                            <td class="text-end">@r.Metrics.Revenue.ToString("N0")</td>
                            <td class="text-center">@(r.Metrics.RatingCount > 0 ? r.Metrics.Rating.ToString("0.0") + " (" + r.Metrics.RatingCount + ")" : "—")</td>
                            <td class="text-center">@(r.Metrics.Verified ? "✓" : "")</td>
                            <td>@if (sug != null) { <span class="badge" style="background:@sug.BadgeColor">@sug.Name</span> } else { <span class="text-muted">—</span> }</td>
                            <td>
                                <select class="form-select form-select-sm sel-tier" data-id="@r.CungUngId">
                                    <option value="">— Chưa xếp hạng —</option>
                                    @foreach (var t in tiers) { <option value="@t.Id" selected="@(r.TierId == t.Id)">@t.Name</option> }
                                </select>
                                @if (r.AssignedBy != null) { <div class="text-muted" style="font-size:.75rem">@r.AssignedBy · @r.AssignedAt?.ToString("dd/MM/yyyy")</div> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="tierModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form class="modal-content" id="tierForm">
            <div class="modal-header bg-warning"><h5 class="modal-title">Hạng nhà cung cấp</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" name="Id" value="0" />
                <div class="row g-2">
                    <div class="col-6"><label class="form-label small">Tên hạng *</label><input name="Name" class="form-control form-control-sm" required maxlength="100" /></div>
                    <div class="col-3"><label class="form-label small">Thứ bậc</label><input name="Rank" type="number" class="form-control form-control-sm" value="1" /></div>
                    <div class="col-3"><label class="form-label small">Màu</label><input name="BadgeColor" type="color" class="form-control form-control-sm form-control-color" value="#6c757d" /></div>
                    <div class="col-4"><label class="form-label small">SP xuất bản ≥</label><input name="MinProducts" type="number" min="0" value="0" class="form-control form-control-sm" /></div>
                    <div class="col-4"><label class="form-label small">Lượt liên hệ ≥</label><input name="MinContacts" type="number" min="0" value="0" class="form-control form-control-sm" /></div>
                    <div class="col-4"><label class="form-label small">Lượt xem ≥</label><input name="MinViews" type="number" min="0" value="0" class="form-control form-control-sm" /></div>
                    <div class="col-4"><label class="form-label small">Lượt giao dịch ≥</label><input name="MinTransactions" type="number" min="0" value="0" class="form-control form-control-sm" /></div>
                    <div class="col-4"><label class="form-label small">Doanh thu ≥ (đồng)</label><input name="MinRevenue" type="number" min="0" step="1000" value="0" class="form-control form-control-sm" /></div>
                    <div class="col-4"><label class="form-label small">Đánh giá SP ≥ (0–5)</label><input name="MinRating" type="number" min="0" max="5" step="0.1" value="0" class="form-control form-control-sm" /></div>
                    <div class="col-12"><label class="form-label small">Mô tả</label><input name="Description" class="form-control form-control-sm" maxlength="500" /></div>
                    <div class="col-6 form-check ms-2"><input class="form-check-input" type="checkbox" name="RequireVerified" value="true" id="tVer" /><label class="form-check-label small" for="tVer">Bắt buộc xác minh pháp lý</label></div>
                    <div class="col-5 form-check"><input class="form-check-input" type="checkbox" name="IsActive" value="true" id="tAct" checked /><label class="form-check-label small" for="tAct">Đang dùng</label></div>
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button><button type="submit" class="btn btn-warning btn-sm">Lưu</button></div>
        </form>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var token = $('input[name="__RequestVerificationToken"]').first().val() || '';
    var form = document.getElementById('tierForm');
    var modal = function () { return bootstrap.Modal.getOrCreateInstance(document.getElementById('tierModal')); };
    function fill(t) {
        form.Id.value = t ? t.id : 0; form.Name.value = t ? t.name : ''; form.Rank.value = t ? t.rank : 1;
        form.BadgeColor.value = t ? t.badgeColor : '#6c757d'; form.MinProducts.value = t ? t.minProducts : 0;
        form.MinContacts.value = t ? t.minContacts : 0; form.MinViews.value = t ? t.minViews : 0;
        form.MinTransactions.value = t ? t.minTransactions : 0; form.MinRevenue.value = t ? t.minRevenue : 0; form.MinRating.value = t ? t.minRating : 0;
        form.Description.value = t ? (t.description || '') : ''; form.RequireVerified.checked = t ? t.requireVerified : false;
        form.IsActive.checked = t ? t.isActive : true;
    }
    $('#btnAddTier').on('click', function () { fill(null); modal().show(); });
    $(document).on('click', '.btn-edit-tier', function (e) { e.preventDefault(); fill($(this).closest('tr').data('tier')); modal().show(); });
    $(form).on('submit', function (e) {
        e.preventDefault();
        var data = $(form).serializeArray();
        if (!form.RequireVerified.checked) data.push({ name: 'RequireVerified', value: 'false' });
        if (!form.IsActive.checked) data.push({ name: 'IsActive', value: 'false' });
        data.push({ name: '__RequestVerificationToken', value: token });
        $.post('@Url.Action("SaveTier", "SupplierTiersAdmin", new { area = "Cms" })', $.param(data), function (r) { if (r.success) location.reload(); else toastr.error(r.message); });
    });
    $(document).on('change', '.sel-tier', function () {
        $.post('@Url.Action("Assign", "SupplierTiersAdmin", new { area = "Cms" })', { cungUngId: $(this).data('id'), tierId: $(this).val(), __RequestVerificationToken: token },
            function (r) { if (r.success) toastr.success('Đã gán hạng.'); else toastr.error(r.message); });
    });
    $('#btnApply').on('click', function () {
        if (!confirm('Áp dụng hạng gợi ý cho các nhà cung cấp chưa được gán tay?')) return;
        $.post('@Url.Action("ApplySuggestions", "SupplierTiersAdmin", new { area = "Cms" })', { __RequestVerificationToken: token }, function (r) { toastr.success(r.message); setTimeout(function () { location.reload(); }, 900); });
    });
})();
</script>
}
