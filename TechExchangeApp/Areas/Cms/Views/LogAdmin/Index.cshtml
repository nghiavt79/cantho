@model List<TechExchangeApp.Areas.Cms.Models.LogListItemVm>
@{
    ViewData["Title"] = "Nhật ký hệ thống";
    var functions = ViewBag.Functions as IEnumerable<dynamic>;
    var sites = ViewBag.Sites as IEnumerable<TechExchangeApp.Entities.RootSite>;
    var selectedFunction = ViewBag.FunctionId?.ToString() ?? "";
    var selectedEvent = ViewBag.EventId?.ToString() ?? "";
    var selectedSite = ViewBag.SiteId?.ToString() ?? "";
}

<div class="card card-outline card-primary shadow-sm mb-3">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-search me-1"></i> Tìm kiếm nhật ký</h3>
    </div>
    <div class="card-body">
        <form id="searchForm" method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label fw-semibold small mb-1">Từ khóa</label>
                <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control form-control-sm" placeholder="ID, nội dung, tính năng, domain..." />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small mb-1">Tính năng</label>
                <select name="functionId" class="form-select form-select-sm">
                    <option value="">-- Tất cả --</option>
                    @if (functions != null)
                    {
                        foreach (var f in functions)
                        {
                            <option value="@f.FunctionId" selected="@(selectedFunction == f.FunctionId.ToString())">@f.FunctionName (#@f.FunctionId)</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold small mb-1">Loại thao tác</label>
                <select name="eventId" class="form-select form-select-sm">
                    <option value="">-- Tất cả --</option>
                    <option value="1" selected="@(selectedEvent == "1")">Thêm</option>
                    <option value="2" selected="@(selectedEvent == "2")">Sửa</option>
                    <option value="3" selected="@(selectedEvent == "3")">Xóa</option>
                    <option value="4" selected="@(selectedEvent == "4")">Đăng nhập</option>
                    <option value="5" selected="@(selectedEvent == "5")">Đăng xuất</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold small mb-1">User</label>
                <input type="text" name="userName" value="@ViewBag.UserName" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold small mb-1">IP</label>
                <input type="text" name="clientIP" value="@ViewBag.ClientIP" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold small mb-1">Từ ngày</label>
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold small mb-1">Đến ngày</label>
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold small mb-1">Site</label>
                <select name="siteId" class="form-select form-select-sm">
                    <option value="">-- Tất cả --</option>
                    @if (sites != null)
                    {
                        foreach (var s in sites)
                        {
                            <option value="@s.SiteId" selected="@(selectedSite == s.SiteId.ToString())">@s.SiteName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <button type="submit" class="btn btn-primary btn-sm me-2" id="btnSearch">
                    <i class="fas fa-search me-1"></i> Tìm kiếm
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="btnReset">
                    <i class="fas fa-undo me-1"></i> Đặt lại
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card card-outline card-info shadow-sm">
    <div class="card-header">
        <h3 class="card-title mb-0">
            <i class="fas fa-clipboard-list me-1"></i> Danh sách nhật ký
        </h3>
    </div>
    <div id="listContainer">
        @await Html.PartialAsync("_ListPartial", Model)
    </div>
</div>

@section Scripts {
<script>
$(function () {
    toastr.options = { closeButton: true, progressBar: true, positionClass: 'toast-top-right', timeOut: 3000 };
    var baseUrl = '@Url.Action("Index", "LogAdmin", new { area = "Cms" })';

    function loadList(page) {
        var params = $('#searchForm').serialize()
            + '&page=' + (page || 1)
            + '&pageSize=' + encodeURIComponent($('.ajax-page-size').val() || '20');

        $('#listContainer').css('opacity', '0.5');
        $.ajax({
            url: baseUrl,
            data: params,
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            success: function (html) {
                $('#listContainer').html(html).css('opacity', '1');
            },
            error: function () {
                toastr.error('Không tải được dữ liệu.');
                $('#listContainer').css('opacity', '1');
            }
        });
    }

    $('#searchForm').on('submit', function (e) {
        e.preventDefault();
        loadList(1);
    });

    $('#btnReset').on('click', function () {
        $('#searchForm')[0].reset();
        loadList(1);
    });

    $(document).on('change', '.ajax-page-size', function () {
        loadList(1);
    });

    $(document).on('click', '.ajax-page', function (e) {
        e.preventDefault();
        if ($(this).closest('.page-item').hasClass('disabled') || $(this).closest('.page-item').hasClass('active')) return;
        loadList($(this).data('page'));
    });
});
</script>
}
