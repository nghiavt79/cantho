@model List<TechExchangeApp.Entities.UiTranslationHistory>
@{ ViewData["Title"] = "Lịch sử thay đổi"; }

<div class="card card-outline card-secondary shadow-sm">
    <div class="card-header d-flex align-items-center">
        <h3 class="card-title mb-0"><i class="fas fa-clock-rotate-left me-1"></i> Lịch sử: <code>@ViewBag.KeyName</code></h3>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-auto">Quay lại</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:150px">Thời điểm</th>
                        <th style="width:140px">Người sửa</th>
                        <th>Tiếng Việt (cũ)</th>
                        <th>English (cũ)</th>
                        <th style="width:60px" class="text-center">HTML</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center py-4 text-muted">Chưa có thay đổi nào.</td></tr>
                    }
                    @foreach (var h in Model)
                    {
                        <tr>
                            <td><small>@h.ChangedAt.ToString("dd/MM/yyyy HH:mm")</small></td>
                            <td><small class="text-muted">@(h.ChangedBy ?? "—")</small></td>
                            <td><small>@h.Vi</small></td>
                            <td><small>@h.En</small></td>
                            <td class="text-center">@(h.AllowHtml ? "HTML" : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
