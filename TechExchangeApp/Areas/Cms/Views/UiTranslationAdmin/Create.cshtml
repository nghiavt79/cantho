@model TechExchangeApp.Areas.Cms.Controllers.UiTranslationFormVm
@{ ViewData["Title"] = "Thêm chuỗi giao diện"; }

<div class="card card-outline card-success shadow-sm">
    <div class="card-header"><h3 class="card-title"><i class="fas fa-plus me-1"></i> Thêm key</h3></div>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="card-body">
            @await Html.PartialAsync("_Form", Model)
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-success btn-sm"><i class="fas fa-save me-1"></i>Lưu</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Hủy</a>
        </div>
    </form>
</div>
