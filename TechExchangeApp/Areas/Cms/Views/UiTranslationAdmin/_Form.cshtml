@model TechExchangeApp.Areas.Cms.Controllers.UiTranslationFormVm
@{ var isEdit = Model.Id > 0; }

<div asp-validation-summary="All" class="text-danger mb-2"></div>
<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="RowVersion" />

<div class="mb-3">
    <label asp-for="Key" class="form-label fw-semibold">Key <span class="text-danger">*</span></label>
    @if (isEdit)
    {
        <input asp-for="Key" class="form-control" readonly />
        <small class="text-muted">Key không sửa được (đổi key = xóa + tạo mới để tránh vỡ liên kết view).</small>
    }
    else
    {
        <input asp-for="Key" class="form-control" placeholder="vd: common.home" />
    }
    <span asp-validation-for="Key" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="Vi" class="form-label fw-semibold">Tiếng Việt</label>
    <textarea asp-for="Vi" class="form-control" rows="3"></textarea>
</div>

<div class="mb-3">
    <label asp-for="En" class="form-label fw-semibold">English</label>
    <textarea asp-for="En" class="form-control" rows="3"></textarea>
</div>

<div class="mb-3">
    <label asp-for="Note" class="form-label fw-semibold">Ghi chú</label>
    <input asp-for="Note" class="form-control form-control-sm" placeholder="Ngữ cảnh dùng key này (optional)" />
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" asp-for="AllowHtml" />
            <label class="form-check-label" asp-for="AllowHtml">Cho phép HTML</label>
            <div><small class="text-muted">Chỉ bật khi cố ý chèn thẻ (link, &lt;b&gt;...). Cần gọi <code>Html.TrHtml(key)</code> ở view.</small></div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" asp-for="IsActive" />
            <label class="form-check-label" asp-for="IsActive">Đang dùng</label>
        </div>
    </div>
</div>
