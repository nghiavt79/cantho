@model TechExchangeApp.Areas.Cms.Controllers.UiTranslationFormVm
@{ ViewData["Title"] = "Sửa chuỗi giao diện"; }

<div class="card card-outline card-primary shadow-sm">
    <div class="card-header d-flex align-items-center">
        <h3 class="card-title mb-0"><i class="fas fa-pen me-1"></i> Sửa: <code>@Model.Key</code></h3>
        <a asp-action="History" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm ms-auto">
            <i class="fas fa-clock-rotate-left me-1"></i>Lịch sử
        </a>
    </div>
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <div class="card-body">
            @await Html.PartialAsync("_Form", Model)
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-save me-1"></i>Lưu</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Quay lại</a>
        </div>
    </form>
</div>
